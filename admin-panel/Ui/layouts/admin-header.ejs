<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Handle Notification Removal
        const removeButtons = document.querySelectorAll('.dropdown-notifications-archive');

        removeButtons.forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                const notificationItem = this.closest('.dropdown-notifications-item');
                const notificationId = this.dataset.id;

                if (notificationId) {
                    fetch(`/admin/notifications/delete/${notificationId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Check if the notification was unread (has 'marked-as-read' class)
                                const isUnread = notificationItem.classList.contains('marked-as-read');

                                notificationItem.remove();

                                // Update badge count if it was unread
                                if (isUnread) {
                                    const badge = document.querySelector('.badge-notifications');
                                    if (badge) {
                                        let count = parseInt(badge.textContent.trim()) || 0;
                                        count = Math.max(0, count - 1);
                                        badge.textContent = count;

                                        if (count === 0) {
                                            badge.style.display = 'none';
                                        }
                                    }
                                }
                            } else {
                                console.error('Failed to remove notification:', data.error);
                            }
                        })
                        .catch(err => console.error('Error:', err));
                }
            });
        });
    });
</script>