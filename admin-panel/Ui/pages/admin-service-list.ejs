<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4">
        <span class="text-muted fw-light">Store Configuration / </span> Manage Services
    </h4>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Pilgrimage Services</h5>
            <a href="/admin/store/home/service/add" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i> Add New Service
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Slug</th>
                            <th>Icon</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        <% if (services && services.length> 0) { %>
                            <% services.forEach(service=> { %>
                                <tr>
                                    <td>
                                        <% if (service.image) { %>
                                            <% if (service.image.startsWith('http')) { %>
                                                <img src="<%= service.image %>" alt="Service" class="rounded"
                                                    style="width: 50px; height: 30px; object-fit: cover;">
                                                <% } else { %>
                                                    <img src="/uploads/<%= service.image %>" alt="Service"
                                                        class="rounded"
                                                        style="width: 50px; height: 30px; object-fit: cover;">
                                                    <% } %>
                                                        <% } else { %>
                                                            <span class="badge bg-label-secondary">No Image</span>
                                                            <% } %>
                                    </td>
                                    <td><strong>
                                            <%= service.title %>
                                        </strong></td>
                                    <td><code><%= service.slug %></code></td>
                                    <td>
                                        <i class="hgi <%= service.icon %> fs-4 text-primary"></i>
                                    </td>
                                    <td>
                                        <span
                                            class="badge bg-label-<%= service.status === 'Active' ? 'success' : 'warning' %>">
                                            <%= service.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-inline-block text-nowrap">
                                            <a href="/admin/store/home/service/edit/<%= service.id %>"
                                                class="btn btn-sm btn-icon"><i class="bx bx-edit text-primary"></i></a>
                                            <button class="btn btn-sm btn-icon delete-service"
                                                data-id="<%= service.id %>"><i
                                                    class="bx bx-trash text-danger"></i></button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center">No services found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.delete-service').forEach(btn => {
            btn.onclick = function () {
                if (confirm('Are you sure you want to delete this service?')) {
                    const id = this.dataset.id;
                    fetch(`/admin/store/home/service/delete/${id}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) location.reload();
                            else alert('Failed to delete service');
                        });
                }
            };
        });
    });
</script>