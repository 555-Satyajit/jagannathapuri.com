<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Store Configuration /</span> Manage Contact</h4>

    <div class="row">
        <div class="col-12">
            <form id="contactForm" action="/admin/store/contact/save" method="POST">
                <input type="hidden" name="contact_json" id="contact_json">

                <div class="nav-align-top mb-4">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
                                data-bs-target="#navs-details" aria-controls="navs-details" aria-selected="true">
                                <i class="tf-icons bx bx-id-card me-1"></i> Contact Details
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                                data-bs-target="#navs-faqs" aria-controls="navs-faqs" aria-selected="false">
                                <i class="tf-icons bx bx-question-mark me-1"></i> FAQs
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <!-- Contact Details -->
                        <div class="tab-pane fade show active" id="navs-details" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="contactEmail">Email Address</label>
                                    <input type="email" id="contactEmail" class="form-control contact-field"
                                        data-key="email" value="<%= settings.email %>" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="contactPhone">Phone Number</label>
                                    <input type="text" id="contactPhone" class="form-control contact-field"
                                        data-key="phone" value="<%= settings.phone %>" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="contactWebsite">Website URL</label>
                                    <input type="text" id="contactWebsite" class="form-control contact-field"
                                        data-key="website" value="<%= settings.website %>" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label" for="contactAddress">Physical Address</label>
                                    <textarea id="contactAddress" class="form-control contact-field" data-key="address"
                                        rows="3"><%= settings.address %></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- FAQs Settings -->
                        <div class="tab-pane fade" id="navs-faqs" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <h6>Frequently Asked Questions</h6>
                                    <div class="faq-repeater">
                                        <div data-repeater-list="faqs">
                                            <% let faqsList=(settings.faqs && settings.faqs.length> 0) ? settings.faqs :
                                                [{ question: '', answer: '' }];
                                                faqsList.forEach(faq => {
                                                %>
                                                <div data-repeater-item>
                                                    <div class="card border mb-3 shadow-none">
                                                        <div class="card-body">
                                                            <div class="row g-3 mb-3">
                                                                <div class="col-md-11">
                                                                    <div class="mb-3">
                                                                        <label class="form-label">Question</label>
                                                                        <input type="text" class="form-control"
                                                                            placeholder="E.g. What payment methods do you accept?"
                                                                            value="<%= faq.question %>" name="question"
                                                                            required />
                                                                    </div>
                                                                    <div>
                                                                        <label class="form-label">Answer</label>
                                                                        <textarea class="form-control" rows="3"
                                                                            placeholder="Answer text..." name="answer"
                                                                            required><%= faq.answer %></textarea>
                                                                    </div>
                                                                </div>
                                                                <div
                                                                    class="col-md-1 d-flex align-items-center justify-content-center">
                                                                    <button class="btn btn-label-danger"
                                                                        data-repeater-delete type="button">
                                                                        <i class="bx bx-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                        <button class="btn btn-primary mt-2" data-repeater-create type="button">
                                            <i class="bx bx-plus me-1"></i> Add FAQ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary me-2">Save Changes</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize Repeater
        $('.faq-repeater').repeater({
            show: function () {
                $(this).slideDown();
            },
            hide: function (deleteElement) {
                if (confirm('Are you sure you want to delete this FAQ?')) {
                    $(this).slideUp(deleteElement);
                }
            }
        });

        // Form Submission - Prepare JSON
        document.getElementById('contactForm').addEventListener('submit', function (e) {
            const contactData = {};

            // Get basic contact fields
            document.querySelectorAll('.contact-field').forEach(field => {
                contactData[field.getAttribute('data-key')] = field.value;
            });

            // Get FAQs array from repeater
            let faqsArray = $('.faq-repeater').repeaterVal().faqs || [];

            // Filter out empty FAQs
            faqsArray = faqsArray.filter(faq => faq.question && faq.question.trim() !== '' && faq.answer && faq.answer.trim() !== '');
            contactData.faqs = faqsArray;

            // Set the JSON hidden input
            document.getElementById('contact_json').value = JSON.stringify(contactData);
        });
    });
</script>