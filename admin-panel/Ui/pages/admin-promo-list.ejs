<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4">
        <span class="text-muted fw-light">Store Configuration / </span> Manage Promo Banners
    </h4>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Promo Banners (Feature Section)</h5>
            <a href="/admin/store/home/promo/add" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i> Add New Promo
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Icon</th>
                            <th>Title</th>
                            <th>Sub-title</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        <% if (promos && promos.length> 0) { %>
                            <% promos.forEach(promo=> { %>
                                <tr>
                                    <td><i class="<%= promo.icon %> bx-md text-primary"></i></td>
                                    <td><strong>
                                            <%= promo.title %>
                                        </strong></td>
                                    <td>
                                        <%= promo.subtitle %>
                                    </td>
                                    <td>
                                        <div class="d-inline-block text-nowrap">
                                            <a href="/admin/store/home/promo/edit/<%= promo.id %>"
                                                class="btn btn-sm btn-icon"><i class="bx bx-edit text-primary"></i></a>
                                            <button class="btn btn-sm btn-icon delete-promo"
                                                data-id="<%= promo.id %>"><i
                                                    class="bx bx-trash text-danger"></i></button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="text-center">No promo banners found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.delete-promo').forEach(btn => {
            btn.onclick = function () {
                if (confirm('Are you sure you want to delete this promo banner?')) {
                    const id = this.dataset.id;
                    fetch(`/admin/store/home/promo/delete/${id}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) location.reload();
                            else alert('Failed to delete promo');
                        });
                }
            };
        });
    });
</script>