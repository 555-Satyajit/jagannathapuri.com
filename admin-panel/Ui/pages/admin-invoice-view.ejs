<div class="row invoice-preview">
    <!-- Invoice -->
    <div class="col-xl-9 col-md-8 col-12 mb-md-0 mb-4">
        <div class="card invoice-preview-card">
            <div class="card-body">
                <div
                    class="d-flex justify-content-between flex-xl-row flex-md-column flex-sm-row flex-column p-sm-3 p-0">
                    <div class="mb-xl-0 mb-4">
                        <div class="d-flex svg-illustration mb-3 gap-2 align-items-center">
                            <span class="app-brand-logo demo">
                                <svg width="26px" height="26px" viewBox="0 0 26 26" version="1.1"
                                    xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <title>icon</title>
                                    <g id="Pages" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                        <g id="Login---V2" transform="translate(-667.000000, -290.000000)">
                                            <g id="Login" transform="translate(519.000000, 244.000000)">
                                                <g id="Logo" transform="translate(148.000000, 42.000000)">
                                                    <g id="icon" transform="translate(0.000000, 4.000000)">
                                                        <path
                                                            d="M13.8863636,4.72727273 C18.9447899,4.72727273 23.0454545,8.82793741 23.0454545,13.8863636 C23.0454545,18.9447899 18.9447899,23.0454545 13.8863636,23.0454545 C8.82793741,23.0454545 4.72727273,18.9447899 4.72727273,13.8863636 C4.72727273,13.5423509 4.74623858,13.2027679 4.78318172,12.8686032 L8.54810407,12.8689442 C8.48567157,13.19852 8.45300462,13.5386269 8.45300462,13.8863636 C8.45300462,16.887125 10.8856023,19.3197227 13.8863636,19.3197227 C16.887125,19.3197227 19.3197227,16.887125 19.3197227,13.8863636 C19.3197227,10.8856023 16.887125,8.45300462 13.8863636,8.45300462 C13.5386269,8.45300462 13.19852,8.48567157 12.8689442,8.54810407 L12.8686032,4.78318172 C13.2027679,4.74623858 13.5423509,4.72727273 13.8863636,4.72727273 Z"
                                                            id="Combined-Shape" fill="#4880EA"></path>
                                                        <path
                                                            d="M13.5909091,1.77272727 C20.4442608,1.77272727 26,7.19618701 26,13.8863636 C26,20.5765403 20.4442608,26 13.5909091,26 C6.73755742,26 1.18181818,20.5765403 1.18181818,13.8863636 C1.18181818,13.540626 1.19665566,13.1982714 1.22574292,12.8598734 L6.30410592,12.859962 C6.25499466,13.1951893 6.22958398,13.5378796 6.22958398,13.8863636 C6.22958398,17.8551125 9.52536149,21.0724191 13.5909091,21.0724191 C17.6564567,21.0724191 20.9522342,17.8551125 20.9522342,13.8863636 C20.9522342,9.91761479 17.6564567,6.70030817 13.5909091,6.70030817 C13.2336969,6.70030817 12.8824272,6.72514561 12.5388136,6.77314791 L12.5392575,1.81561642 C12.8859498,1.78721495 13.2366963,1.77272727 13.5909091,1.77272727 Z"
                                                            id="Combined-Shape2" fill="#5A8DEE"></path>
                                                        <rect id="Rectangle" fill="#FDAC41" x="0" y="0"
                                                            width="7.68181818" height="7.68181818"></rect>
                                                    </g>
                                                </g>
                                            </g>
                                        </g>
                                    </g>
                                </svg>
                            </span>
                            <span class="app-brand-text demo menu-text fw-bold ms-2">Jay Subhdra</span>
                        </div>
                        <p class="mb-1">123, Puri Temple Road, Odisha, India</p>
                        <p class="mb-1">Phone: +91 98765 43210</p>
                        <p class="mb-0">Email: support@jaysubhdra.com</p>
                    </div>
                    <div>
                        <h4 class="fw-medium text-uppercase text-nowrap">Invoice #<%= order.orderNumber %>
                        </h4>
                        <div class="mb-2">
                            <span class="text-muted">Date Issues:</span>
                            <span class="fw-medium text-heading">
                                <%= new Date(order.date).toLocaleDateString() %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-0" />
            <div class="card-body">
                <div class="row p-sm-3 p-0">
                    <div class="col-xl-6 col-md-12 col-sm-5 col-12 mb-xl-0 mb-md-4 mb-sm-0 mb-4 text-nowrap">
                        <h6 class="pb-2 text-heading">Invoice To:</h6>
                        <p class="mb-1">
                            <%= order.customer.fullName %>
                        </p>
                        <% // Try to find the specific address linked to the order via shippingAddressId let
                            shippingAddr=order.customer.addresses.find(a=> a.id === order.shippingAddressId);
                            // Fallback to any shipping type or default
                            if (!shippingAddr) {
                            shippingAddr = order.customer.addresses.find(a => a.type === 'Shipping' || a.isDefault);
                            }
                            %>
                            <% if (shippingAddr) { %>
                                <p class="mb-1">
                                    <%= shippingAddr.addressLine1 %>
                                        <%= shippingAddr.addressLine2 ? ', ' + shippingAddr.addressLine2 : '' %>
                                </p>
                                <p class="mb-1">
                                    <%= shippingAddr.city %>, <%= shippingAddr.state %>
                                            <%= shippingAddr.zipCode %>
                                </p>
                                <p class="mb-1">
                                    <%= shippingAddr.country %>
                                </p>
                                <% } %>
                                    <p class="mb-1">Mobile: <%= order.customer.phone || 'N/A' %>
                                    </p>
                                    <p class="mb-0">Email: <%= order.customer.email %>
                                    </p>
                    </div>
                    <div class="col-xl-6 col-md-12 col-sm-7 col-12 text-nowrap">
                        <h6 class="pb-2 text-heading">Bill To:</h6>
                        <table>
                            <tbody>
                                <tr>
                                    <td class="pe-3">Total Due:</td>
                                    <td class="fw-medium">₹<%= total.toFixed(2) %>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pe-3">Payment Method:</td>
                                    <td class="text-uppercase">
                                        <%= (order.paymentMethod || 'N/A' ).split('_')[0] %>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="pe-3">Bank name:</td>
                                    <td>State Bank of India</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table border-top m-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Description</th>
                            <th>Cost</th>
                            <th>Qty</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.items.forEach(item=> { %>
                            <tr>
                                <td class="text-nowrap text-heading">
                                    <%= item.product.product_name %>
                                </td>
                                <td class="text-nowrap">
                                    SKU: <%= item.product.sku %>
                                </td>
                                <td>₹<%= item.price.toFixed(2) %>
                                </td>
                                <td>
                                    <%= item.quantity %>
                                </td>
                                <td>₹<%= (item.price * item.quantity).toFixed(2) %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-md-0 mb-4">
                        <p class="mb-1"><span class="fw-medium text-heading">Salesperson:</span> <span class="ms-2">Jay
                                Jani</span></p>
                        <span class="text-muted">Thanks for your business</span>
                    </div>
                    <div class="col-md-6 d-flex justify-content-md-end">
                        <div class="invoice-calculations">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="w-px-100 text-heading">Subtotal:</span>
                                <span class="fw-medium">₹<%= subtotal.toFixed(2) %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="w-px-100 text-heading">Tax:</span>
                                <span class="fw-medium">₹<%= tax.toFixed(2) %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="w-px-100 text-heading">Shipping:</span>
                                <span class="fw-medium">₹<%= order.shippingFee.toFixed(2) %></span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between">
                                <span class="w-px-100 text-heading">Total:</span>
                                <span class="fw-medium">₹<%= total.toFixed(2) %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-0" />

            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <span class="fw-medium text-heading">Note:</span>
                        <span>It was a pleasure working with you and your team. We hope you keep us in mind for future
                            freelance projects. Thank You!</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /Invoice -->

    <!-- Invoice Actions -->
    <div class="col-xl-3 col-md-4 col-12 invoice-actions">
        <div class="card">
            <div class="card-body">
                <button class="btn btn-primary d-grid w-100 mb-3" data-bs-toggle="offcanvas"
                    data-bs-target="#sendInvoiceOffcanvas">
                    <span class="d-flex align-items-center justify-content-center text-nowrap"><i
                            class="bx bx-paper-plane scaleX-n1-rtl me-1"></i>Send Invoice</span>
                </button>
                <button class="btn btn-label-secondary d-grid w-100 mb-3"
                    onclick="window.location.href='/admin/ecommerce/orders/invoice/<%= order.id %>'">
                    Download
                </button>
                <a class="btn btn-label-secondary d-grid w-100 mb-3" target="_blank"
                    href="/admin-assets/html/app-invoice-print.html">
                    Print
                </a>
                <a href="/admin/ecommerce/orders/edit/<%= order.id %>"
                    class="btn btn-label-secondary d-grid w-100 mb-3">
                    Edit Invoice
                </a>
                <button class="btn btn-primary d-grid w-100" data-bs-toggle="offcanvas"
                    data-bs-target="#addPaymentOffcanvas">
                    <span class="d-flex align-items-center justify-content-center text-nowrap"><i
                            class="bx bx-rupee me-1"></i>Add Payment</span>
                </button>
            </div>
        </div>
    </div>
    <!-- /Invoice Actions -->
</div>