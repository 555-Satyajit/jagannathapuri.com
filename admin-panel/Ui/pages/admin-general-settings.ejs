<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Store Configuration /</span> General Settings</h4>

    <div class="row">
        <div class="col-12">
            <form id="settingsForm" action="/admin/settings/general" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="header_json" id="header_json">
                <input type="hidden" name="footer_json" id="footer_json">
                <input type="hidden" name="home_json" id="home_json">
                <input type="hidden" name="seo_json" id="seo_json">

                <div class="nav-align-top mb-4">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab"
                                data-bs-target="#navs-header" aria-controls="navs-header" aria-selected="true">
                                <i class="tf-icons bx bx-layout me-1"></i> Header
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                                data-bs-target="#navs-footer" aria-controls="navs-footer" aria-selected="false">
                                <i class="tf-icons bx bx-dock-bottom me-1"></i> Footer
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                                data-bs-target="#navs-home" aria-controls="navs-home" aria-selected="false">
                                <i class="tf-icons bx bx-home me-1"></i> Home & Timer
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" role="tab" data-bs-toggle="tab"
                                data-bs-target="#navs-seo" aria-controls="navs-seo" aria-selected="false">
                                <i class="tf-icons bx bx-search me-1"></i> SEO Settings
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <!-- Header Settings -->
                        <div class="tab-pane fade show active" id="navs-header" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Site Logo</label>
                                    <div class="d-flex align-items-start align-items-sm-center gap-4">
                                        <img src="<%= settings.header.logo %>" alt="user-avatar" class="d-block rounded"
                                            height="100" width="100" id="uploadedLogo" />
                                        <div class="button-wrapper">
                                            <label for="upload" class="btn btn-primary me-2 mb-4" tabindex="0">
                                                <span class="d-none d-sm-block">Upload new logo</span>
                                                <i class="bx bx-upload d-block d-sm-none"></i>
                                                <input type="file" id="upload" name="logo" class="account-file-input"
                                                    hidden accept="image/png, image/jpeg" />
                                            </label>
                                            <p class="text-muted mb-0">Allowed JPG, GIF or PNG.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="supportPhone">Support Phone</label>
                                    <input type="text" id="supportPhone" class="form-control header-field"
                                        data-key="support_phone" value="<%= settings.header.support_phone %>" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Promo Banner Text</label>
                                    <input type="text" class="form-control header-field" data-key="promo_text"
                                        value="<%= settings.header.promo_text || 'Fashion Category' %>" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Promo Discount Tag</label>
                                    <input type="text" class="form-control header-field" data-key="promo_tag"
                                        value="<%= settings.header.promo_tag || '25% OFF' %>" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Promo Suffix Text</label>
                                    <input type="text" class="form-control header-field" data-key="promo_suffix"
                                        value="<%= settings.header.promo_suffix || 'Today' %>" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Promo Status</label>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input header-checkbox" type="checkbox"
                                            data-key="promo_status" <%=settings.header.promo_status !==false ? 'checked'
                                            : '' %>>
                                        <label class="form-check-label">Show Promo</label>
                                    </div>
                                </div>

                                <div class="col-md-6 mt-4">
                                    <label class="form-label">Navbar Support Phone</label>
                                    <input type="text" class="form-control header-field" data-key="navbar_support_phone"
                                        value="<%= settings.header.navbar_support_phone || '888-777-999' %>" />
                                </div>

                                <div class="col-12 mt-4">
                                    <h6>Navbar Navigation Links</h6>
                                    <div class="navbar-links-repeater">
                                        <div data-repeater-list="navbar_links">
                                            <% let navLinks=(settings.header.navbar_links &&
                                                settings.header.navbar_links.length> 0) ? settings.header.navbar_links :
                                                [{ label: '', url: '', sub_links: [] }];
                                                navLinks.forEach(link=> {
                                                %>
                                                <div data-repeater-item>

                                                    <div class="card border mb-3">
                                                        <div class="card-body">
                                                            <div class="row g-3 mb-3 align-items-end">
                                                                <div class="col-md-5">
                                                                    <label class="form-label">Main Label</label>
                                                                    <input type="text" class="form-control"
                                                                        placeholder="Label" value="<%= link.label %>"
                                                                        name="label" />
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label class="form-label">Main URL</label>
                                                                    <input type="text" class="form-control"
                                                                        placeholder="URL" value="<%= link.url %>"
                                                                        name="url" />
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <button class="btn btn-label-danger"
                                                                        data-repeater-delete type="button">
                                                                        <i class="bx bx-x"></i>
                                                                    </button>
                                                                </div>
                                                            </div>

                                                            <!-- Nested Sub-links -->
                                                            <div
                                                                class="ms-4 p-3 bg-light rounded shadow-none border-start border-primary border-3">
                                                                <h7 class="mb-3 d-block font-weight-bold text-primary">
                                                                    Sub Dropdown Items</h7>
                                                                <div class="sub-links-repeater">
                                                                    <div data-repeater-list="sub_links">
                                                                        <% let subLinks=(link.sub_links &&
                                                                            link.sub_links.length> 0) ? link.sub_links :
                                                                            [{ label: '', url: '' }];
                                                                            subLinks.forEach(sub=> {
                                                                            %>
                                                                            <div data-repeater-item>

                                                                                <div
                                                                                    class="row g-2 mb-2 align-items-end">
                                                                                    <div class="col-md-5">
                                                                                        <input type="text"
                                                                                            class="form-control form-control-sm"
                                                                                            placeholder="Sub Label"
                                                                                            value="<%= sub.label %>"
                                                                                            name="label" />
                                                                                    </div>
                                                                                    <div class="col-md-6">
                                                                                        <input type="text"
                                                                                            class="form-control form-control-sm"
                                                                                            placeholder="Sub URL"
                                                                                            value="<%= sub.url %>"
                                                                                            name="url" />
                                                                                    </div>
                                                                                    <div class="col-md-1">
                                                                                        <button
                                                                                            class="btn btn-icon btn-sm btn-label-danger"
                                                                                            data-repeater-delete
                                                                                            type="button">
                                                                                            <i class="bx bx-x"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <% }) %>
                                                                    </div>

                                                                    <button class="btn btn-sm btn-outline-primary"
                                                                        data-repeater-create type="button">
                                                                        <i class="bx bx-plus me-1"></i> Add Sub Item
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                        <button class="btn btn-primary" data-repeater-create type="button">
                                            <i class="bx bx-plus me-1"></i> Add Main Link
                                        </button>
                                    </div>
                                </div>

                                <div class="col-12 mt-4">
                                    <h6>Top Bar Navigation Links</h6>
                                    <div class="topbar-links-repeater">
                                        <div data-repeater-list="top_bar_links">
                                            <% let topLinks=(settings.header.top_bar_links &&
                                                settings.header.top_bar_links.length> 0) ? settings.header.top_bar_links
                                                : [{ label: '', url: '' }];
                                                topLinks.forEach(link=> {
                                                %>
                                                <div data-repeater-item>

                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-5">
                                                            <input type="text" class="form-control" placeholder="Label"
                                                                value="<%= link.label %>" name="label" />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <input type="text" class="form-control" placeholder="URL"
                                                                value="<%= link.url %>" name="url" />
                                                        </div>
                                                        <div class="col-md-1">
                                                            <button class="btn btn-label-danger" data-repeater-delete
                                                                type="button">
                                                                <i class="bx bx-x"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>

                                        <button class="btn btn-primary" data-repeater-create type="button">
                                            <i class="bx bx-plus me-1"></i> Add Link
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Footer Settings -->
                        <div class="tab-pane fade" id="navs-footer" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Brand Description</label>
                                    <textarea class="form-control footer-field" data-key="brand_description"
                                        rows="3"><%= settings.footer.brand_description %></textarea>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Facebook URL</label>
                                    <input type="text" class="form-control footer-field" data-key="facebook"
                                        value="<%= settings.footer.facebook %>" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Instagram URL</label>
                                    <input type="text" class="form-control footer-field" data-key="instagram"
                                        value="<%= settings.footer.instagram %>" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">LinkedIn URL</label>
                                    <input type="text" class="form-control footer-field" data-key="linkedin"
                                        value="<%= settings.footer.linkedin %>" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Contact Address</label>
                                    <input type="text" class="form-control footer-field" data-key="contact_address"
                                        value="<%= settings.footer.contact_address %>" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Contact Phone</label>
                                    <input type="text" class="form-control footer-field" data-key="contact_phone"
                                        value="<%= settings.footer.contact_phone %>" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Contact Email</label>
                                    <input type="text" class="form-control footer-field" data-key="contact_email"
                                        value="<%= settings.footer.contact_email %>" />
                                </div>
                            </div>
                        </div>

                        <!-- Home Settings -->
                        <div class="tab-pane fade" id="navs-home" role="tabpanel">
                            <div class="card shadow-none border">
                                <div class="card-header border-bottom">
                                    <h5 class="mb-0">Featured Puri Countdown Timer</h5>
                                </div>
                                <div class="card-body pt-4">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Timer Title</label>
                                            <input type="text" class="form-control home-field" data-key="timer_title"
                                                value="<%= settings.home.timer_title || 'Ends in :' %>" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">End Date & Time</label>
                                            <input type="datetime-local" class="form-control home-field"
                                                data-key="timer_end_date"
                                                value="<%= settings.home.timer_end_date || '2026-12-13T00:00' %>" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Status</label>
                                            <div class="form-check form-switch mt-2">
                                                <input class="form-check-input home-checkbox" type="checkbox"
                                                    data-key="timer_status" <%=settings.home.timer_status !==false
                                                    ? 'checked' : '' %>>
                                                <label class="form-check-label">Visible</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SEO Settings -->
                        <div class="tab-pane fade" id="navs-seo" role="tabpanel">
                            <div class="card shadow-none border">
                                <div class="card-header border-bottom">
                                    <h5 class="mb-0">Global SEO Settings</h5>
                                </div>
                                <div class="card-body pt-4">
                                    <div class="row g-3">
                                        <div class="col-md-12 mb-3">
                                            <h6 class="mb-2">Favicon (32x32 or 64x64 PNG/ICO)</h6>
                                            <div class="d-flex align-items-start align-items-sm-center gap-4">
                                                <img src="<%= settings.seo.favicon %>" alt="site-favicon"
                                                    class="d-block rounded" height="64" width="64"
                                                    id="uploadedFavicon" />
                                                <div class="button-wrapper">
                                                    <label for="uploadFavicon" class="btn btn-primary me-2 mb-4"
                                                        tabindex="0">
                                                        <span class="d-none d-sm-block">Upload favicon</span>
                                                        <i class="bx bx-upload d-block d-sm-none"></i>
                                                        <input type="file" id="uploadFavicon" name="favicon"
                                                            class="account-file-input" hidden
                                                            accept="image/png, image/x-icon, image/vnd.microsoft.icon" />
                                                    </label>
                                                    <p class="text-muted mb-0">Allowed PNG, ICO.</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <hr class="my-3">
                                            <h6 class="mb-4">Global Meta Tags</h6>
                                        </div>
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label" for="metaTitle">Default Meta Title</label>
                                            <input type="text" id="metaTitle"
                                                class="form-control seo-field seo-strength-title" data-key="meta_title"
                                                value="<%= settings.seo.meta_title %>" />
                                            <div class="seo-meter mt-1">
                                                <div class="d-flex justify-content-between">
                                                    <small class="text-muted">Strength: <span
                                                            class="strength-label">Check...</span></small>
                                                    <small class="text-muted"><span class="char-count">0</span> / 60
                                                        chars</small>
                                                </div>
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar" style="width: 0%">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label" for="metaDesc">Default Meta Description</label>
                                            <textarea id="metaDesc" class="form-control seo-field seo-strength-desc"
                                                rows="3"
                                                data-key="meta_description"><%= settings.seo.meta_description %></textarea>
                                            <div class="seo-meter mt-1">
                                                <div class="d-flex justify-content-between">
                                                    <small class="text-muted">Strength: <span
                                                            class="strength-label">Check...</span></small>
                                                    <small class="text-muted"><span class="char-count">0</span> / 160
                                                        chars</small>
                                                </div>
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar" style="width: 0%">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label" for="metaKeywords">Global Meta Keywords</label>
                                            <input type="text" id="metaKeywords" class="form-control seo-field"
                                                data-key="meta_keywords" value="<%= settings.seo.meta_keywords %>"
                                                placeholder="keyword1, keyword2, keyword3" />
                                        </div>
                                        <div class="col-12">
                                            <hr class="my-3">
                                            <h6 class="mb-4">Social Preview (Open Graph)</h6>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">OG Title</label>
                                            <input type="text" class="form-control seo-field" data-key="og_title"
                                                value="<%= settings.seo.og_title %>" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">OG Description</label>
                                            <input type="text" class="form-control seo-field" data-key="og_description"
                                                value="<%= settings.seo.og_description %>" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary me-2">Save Changes</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Handle logo preview
        const uploadInput = document.getElementById('upload');
        const uploadedLogo = document.getElementById('uploadedLogo');
        if (uploadInput) {
            uploadInput.onchange = (e) => {
                const [file] = uploadInput.files;
                if (file) {
                    uploadedLogo.src = URL.createObjectURL(file);
                }
            };
        }

        // Handle favicon preview
        const uploadFaviconInput = document.getElementById('uploadFavicon');
        const uploadedFaviconImage = document.getElementById('uploadedFavicon');
        if (uploadFaviconInput) {
            uploadFaviconInput.onchange = (e) => {
                const [file] = uploadFaviconInput.files;
                if (file) {
                    uploadedFaviconImage.src = URL.createObjectURL(file);
                }
            };
        }

        // SEO Strength Meter Logic
        function updateSeoMeter(input, max, ideal_min, ideal_max) {
            const meter = input.nextElementSibling;
            if (!meter || !meter.classList.contains('seo-meter')) return;

            const label = meter.querySelector('.strength-label');
            const countDisplay = meter.querySelector('.char-count');
            const bar = meter.querySelector('.progress-bar');

            const count = input.value.length;
            countDisplay.textContent = count;

            let percent = (count / max) * 100;
            if (percent > 100) percent = 100;
            bar.style.width = percent + '%';

            if (count === 0) {
                label.textContent = 'Empty';
                label.className = 'strength-label text-muted';
                bar.className = 'progress-bar bg-secondary';
            } else if (count < ideal_min) {
                label.textContent = 'Weak';
                label.className = 'strength-label text-danger';
                bar.className = 'progress-bar bg-danger';
            } else if (count <= ideal_max) {
                label.textContent = 'Best';
                label.className = 'strength-label text-success';
                bar.className = 'progress-bar bg-success';
            } else {
                label.textContent = 'Good (Too long)';
                label.className = 'strength-label text-warning';
                bar.className = 'progress-bar bg-warning';
            }
        }

        const titleInput = document.querySelector('.seo-strength-title');
        const descInput = document.querySelector('.seo-strength-desc');

        if (titleInput) {
            titleInput.addEventListener('input', () => updateSeoMeter(titleInput, 100, 30, 60));
            updateSeoMeter(titleInput, 100, 30, 60);
        }
        if (descInput) {
            descInput.addEventListener('input', () => updateSeoMeter(descInput, 300, 120, 160));
            updateSeoMeter(descInput, 300, 120, 160);
        }

        // Initialize Repeaters (Top Bar)
        $('.topbar-links-repeater').repeater({
            show: function () { $(this).slideDown(); },
            hide: function (deleteElement) { $(this).slideUp(deleteElement); }
        });

        // Initialize Nested Repeaters (Navbar)
        $('.navbar-links-repeater').repeater({
            repeaters: [{
                selector: '.sub-links-repeater',
                show: function () { $(this).slideDown(); },
                hide: function (deleteElement) { $(this).slideUp(deleteElement); }
            }],
            show: function () { $(this).slideDown(); },
            hide: function (deleteElement) { $(this).slideUp(deleteElement); }
        });

        // Form Submission - Prepare JSON
        document.getElementById('settingsForm').addEventListener('submit', function (e) {
            // Header JSON
            const header = {
                logo: uploadedLogo.src.startsWith('blob:') ? '<%= settings.header.logo %>' : uploadedLogo.getAttribute('src'),
                support_phone: document.querySelector('.header-field[data-key="support_phone"]').value,
                promo_text: document.querySelector('.header-field[data-key="promo_text"]').value,
                promo_tag: document.querySelector('.header-field[data-key="promo_tag"]').value,
                promo_suffix: document.querySelector('.header-field[data-key="promo_suffix"]').value,
                promo_status: document.querySelector('.header-checkbox[data-key="promo_status"]').checked,
                navbar_support_phone: document.querySelector('.header-field[data-key="navbar_support_phone"]').value,
                navbar_links: ($('.navbar-links-repeater').repeaterVal().navbar_links || [])
                    .map(l => ({
                        ...l,
                        sub_links: (l.sub_links || []).filter(sl => sl.label || sl.url)
                    }))
                    .filter(l => l.label || l.url || (l.sub_links && l.sub_links.length > 0)),
                top_bar_links: ($('.topbar-links-repeater').repeaterVal().top_bar_links || []).filter(l => l.label || l.url)

            };

            // Footer JSON
            const footer = {};
            document.querySelectorAll('.footer-field').forEach(field => {
                footer[field.getAttribute('data-key')] = field.value;
            });

            document.getElementById('header_json').value = JSON.stringify(header);
            document.getElementById('footer_json').value = JSON.stringify(footer);

            // Home JSON
            const home = {};
            document.querySelectorAll('.home-field').forEach(field => {
                home[field.getAttribute('data-key')] = field.value;
            });
            document.querySelectorAll('.home-checkbox').forEach(field => {
                home[field.getAttribute('data-key')] = field.checked;
            });
            document.getElementById('home_json').value = JSON.stringify(home);

            // SEO JSON
            const seo = {
                favicon: uploadedFaviconImage.src.startsWith('blob:') ? '<%= settings.seo.favicon %>' : uploadedFaviconImage.getAttribute('src')
            };
            document.querySelectorAll('.seo-field').forEach(field => {
                seo[field.getAttribute('data-key')] = field.value;
            });
            document.getElementById('seo_json').value = JSON.stringify(seo);
        });
    });
</script>