<script>
    window.revenueChartData = <%- revenueChartData %>;
    window.revenueChartLabels = <%- revenueChartLabels %>;
    window.weeklyOrderSummaryData = <%- weeklyOrderSummaryData %>;
    window.weeklyOrderSummaryLabels = <%- weeklyOrderSummaryLabels %>;
    window.orderStatusSeries = <%- orderStatusSeries %>;
    window.orderStatusLabels = <%- orderStatusLabels %>;
</script>
<div class="row">
    <!-- Welcome Card -->
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title mb-2">Welcome <%= (typeof staff !=='undefined' && staff && staff.role) ?
                        staff.role.name : 'Admin' %>!</h3>
                <span class="d-block mb-4 text-nowrap">Summary of your store's performance</span>
            </div>
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-6">
                        <h1 class="display-6 text-primary mb-2 pt-4 pb-1">₹<%= totalRevenue.toLocaleString('en-IN') %>
                        </h1>
                        <small class="d-block mb-3">Total Revenue</small>

                        <a href="/admin/ecommerce/orders" class="btn btn-sm btn-primary">View sales</a>
                    </div>
                    <div class="col-6">
                        <img src="/admin-assets/img/illustrations/prize-light.png" width="140" height="150"
                            class="rounded-start" alt="View Sales" data-app-light-img="illustrations/prize-light.png"
                            data-app-dark-img="illustrations/prize-dark.png">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--/ Welcome Card -->

    <!-- Order Status Overview -->
    <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Order Status Overview</h5>
                <div class="dropdown">
                    <button class="btn p-0" type="button" id="visitsOptions" data-bs-toggle="dropdown"
                        aria-haspopup="true" aria-expanded="false">
                        <i class="bx bx-dots-vertical-rounded"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="visitsOptions">
                        <a class="dropdown-item" href="javascript:void(0);">Refresh</a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="visitsRadialChart"></div>
            </div>
        </div>
    </div>
    <!--/ Order Status Overview -->

    <!-- Statistics cards & Revenue Growth Chart -->
    <div class="col-lg-4 col-12">
        <div class="row">
            <!-- Statistics Cards -->
            <div class="col-6 col-md-3 col-lg-6 mb-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="avatar mx-auto mb-2">
                            <span class="avatar-initial rounded-circle bg-label-success"><i
                                    class="bx bx-package fs-4"></i></span>
                        </div>
                        <span class="d-block text-nowrap">Products</span>
                        <h2 class="mb-0">
                            <%= totalProducts %>
                        </h2>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-lg-6 mb-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="avatar mx-auto mb-2">
                            <span class="avatar-initial rounded-circle bg-label-warning"><i
                                    class="bx bx-cart fs-4"></i></span>
                        </div>
                        <span class="d-block text-nowrap">Orders</span>
                        <h2 class="mb-0">
                            <%= totalOrders %>
                        </h2>
                    </div>
                </div>
            </div>
            <!--/ Statistics Cards -->
            <!-- Revenue Growth Chart -->
            <div class="col-12 col-md-6 col-lg-12 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center pb-0">
                        <h5 class="card-title mb-0">Total Revenue</h5>
                        <span>₹<%= totalRevenue.toLocaleString('en-IN') %></span>
                    </div>
                    <div class="card-body pb-0">
                        <div id="revenueGrowthChart"></div>
                    </div>
                </div>
            </div>
            <!--/ Revenue Growth Chart -->
        </div>
    </div>
    <!--/ Statistics cards & Revenue Growth Chart -->

    <!-- Weekly Order Summary & Sales Overview -->
    <div class="col-xl-8 col-12 mb-4">
        <div class="card">
            <div class="row row-bordered m-0">
                <!-- Order Summary Chart -->
                <div class="col-md-8 col-12 px-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Weekly Order Summary</h5>
                        <div class="dropdown">
                            <button class="btn p-0" type="button" id="orderSummaryOptions" data-bs-toggle="dropdown"
                                aria-haspopup="true" aria-expanded="false">
                                <i class="bx bx-dots-vertical-rounded"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="orderSummaryOptions">
                                <a class="dropdown-item" href="javascript:void(0);">Refresh</a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div id="orderSummaryChart"></div>
                    </div>
                </div>
                <!-- Sales Overview -->
                <div class="col-md-4 col-12 px-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Sales Overview</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="mt-1">Last Month Comparison</h6>
                        <p class="mb-4">Performance <%= salesPerformance %>% <%= salesPerformance>= 0 ? 'better' :
                                    'lower' %> compared to last month</p>
                        <ul class="list-unstyled m-0 pt-0">
                            <li class="mb-4">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="avatar avatar-sm flex-shrink-0 me-2">
                                        <span class="avatar-initial rounded bg-label-primary"><i
                                                class="bx bx-trending-up"></i></span>
                                    </div>
                                    <div>
                                        <p class="mb-0 lh-1 text-muted text-nowrap">Earnings This Month</p>
                                        <small class="fw-medium text-nowrap">₹<%=
                                                currentMonthRevenue.toLocaleString('en-IN') %></small>
                                    </div>
                                </div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar bg-primary" style="width: 75%" role="progressbar"
                                        aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </li>
                            <li>
                                <div class="d-flex align-items-center mb-2">
                                    <div class="avatar avatar-sm flex-shrink-0 me-2">
                                        <span class="avatar-initial rounded bg-label-success"><i
                                                class="bx bx-dollar"></i></span>
                                    </div>
                                    <div>
                                        <p class="mb-0 lh-1 text-muted text-nowrap">Average Daily Sales</p>
                                        <small class="fw-medium text-nowrap">₹<%=
                                                averageDailySales.toLocaleString('en-IN', { maximumFractionDigits: 0 })
                                                %></small>
                                    </div>
                                </div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar bg-success" style="width: 75%" role="progressbar"
                                        aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--/ Weekly Order Summary & Sales Overview -->

    <!-- Sales Statistics -->
    <div class="col-md-6 col-lg-6 col-xl-4 col-xl-4 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between mb-3">
                <h5 class="card-title mb-0">Sales Statistics</h5>
            </div>
            <div class="card-body">
                <ul class="p-0 m-0">
                    <li class="d-flex mb-4">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <span class="avatar-initial rounded-circle bg-label-success"><i
                                    class='bx bx-rupee'></i></span>
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <p class="mb-0 lh-1">Total Profit</p>
                                <small class="text-muted">Earnings after cost</small>
                            </div>
                            <div class="item-progress fw-semibold">₹<%= totalProfit.toLocaleString('en-IN') %>
                            </div>
                        </div>
                    </li>
                    <li class="d-flex mb-4">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <span class="avatar-initial rounded-circle bg-label-primary"><i
                                    class='bx bx-cube'></i></span>
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <p class="mb-0 lh-1">Total Products</p>
                                <small class="text-muted">Active in store</small>
                            </div>
                            <div class="item-progress fw-semibold">
                                <%= totalProducts %>
                            </div>
                        </div>
                    </li>
                    <li class="d-flex mb-4">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <span class="avatar-initial rounded-circle bg-label-info"><i class='bx bx-cart'></i></span>
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <p class="mb-0 lh-1">Total Orders</p>
                                <small class="text-muted">Lifetime orders</small>
                            </div>
                            <div class="item-progress fw-semibold">
                                <%= totalOrders %>
                            </div>
                        </div>
                    </li>
                    <li class="d-flex ps-1">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <span class="avatar-initial rounded-circle bg-label-success"><i
                                    class='bx bx-rupee'></i></span>
                        </div>
                        <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                                <p class="mb-0 lh-1">Total Revenue</p>
                                <small class="text-muted">Lifetime earnings</small>
                            </div>
                            <div class="item-progress fw-semibold">₹<%= totalRevenue.toLocaleString('en-IN') %>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!--/ Sales Statistics -->

    <!-- Total Registered Users -->
    <div class="col-md-6 col-lg-6 col-xl-4 mb-4 mb-xl-0">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-2">Total Registered Users</h5>
                <h1 class="display-6 fw-normal mb-0"><%= totalCustomers %></h1>
            </div>
            <div class="card-body">
                <span class="d-block mb-3">User Interaction Summary</span>
                <ul class="p-0 m-0">
                    <li class="mb-4 d-flex justify-content-between">
                        <div class="d-flex align-items-center lh-1 me-3">
                            <span class="badge badge-dot bg-success me-2"></span> Newsletter Subscribers
                        </div>
                        <div class="d-flex gap-3">
                            <span><%= totalNewsletter %></span>
                        </div>
                    </li>
                    <li class="mb-4 d-flex justify-content-between">
                        <div class="d-flex align-items-center lh-1 me-3">
                            <span class="badge badge-dot bg-warning me-2"></span> Unique Visitors
                        </div>
                        <div class="d-flex gap-3">
                            <span><%= totalUniqueVisitors %></span>
                        </div>
                    </li>
                    <li class="mb-4 d-flex justify-content-between">
                        <div class="d-flex align-items-center lh-1 me-3">
                            <span class="badge badge-dot bg-primary me-2"></span> Active Orders
                        </div>
                        <div class="d-flex gap-3">
                            <span><%= totalOrders %></span>
                        </div>
                    </li>
                    <li class="d-flex justify-content-between">
                        <div class="d-flex align-items-center lh-1 me-3">
                            <span class="badge badge-dot bg-info me-2"></span> Store Products
                        </div>
                        <div class="d-flex gap-3">
                            <span><%= totalProducts %></span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!--/ Total Registered Users -->

    <!-- Top Selling Products -->
    <div class="col-md-12 col-lg-12 col-xl-8 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between mb-3">
                <h5 class="card-title mb-0">Top Selling Products</h5>
            </div>
            <div class="table-responsive">
                <table class="table border-top">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Total Sold</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        <% topProducts.forEach(product => { %>
                        <tr>
                            <td class="text-nowrap">
                                <div class="d-flex align-items-center">
                                    <img src="<%= product.images && product.images.length > 0 ? product.images[0] : '/admin-assets/img/ecommerce-images/product-1.png' %>" class="me-3 rounded" width="35" height="35" alt="<%= product.product_name %>">
                                    <div class="d-flex flex-column">
                                        <span class="fw-medium text-heading"><%= product.product_name %></span>
                                        <small class="text-muted"><%= product.product_brand %></small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="text-nowrap"><%= product.category ? product.category.name : 'Uncategorized' %></span></td>
                            <td>₹<%= parseFloat(product.price).toLocaleString() %></td>
                            <td><span class="fw-medium"><%= product.totalSold %> sold</span></td>
                            <td><span class="badge bg-label-<%= product.status === 1 ? 'success' : 'warning' %>"><%= product.status === 1 ? 'Active' : 'Inactive' %></span></td>
                        </tr>
                        <% }) %>
                        <% if (topProducts.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-4">No sales data available yet.</td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!--/ Top Selling Products -->
</div>
