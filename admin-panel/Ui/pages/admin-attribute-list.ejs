<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">eCommerce /</span> Attributes
</h4>

<div class="app-ecommerce-category">
    <!-- Category List Table -->
    <div class="card">
        <div class="card-datatable table-responsive">
            <table class="datatables-category-list table border-top">
                <thead>
                    <tr>
                        <th></th>
                        <th>Name</th>
                        <th class="text-nowrap ">Description</th>
                        <th class="text-lg-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% attributes.forEach(attr=> { %>
                        <tr>
                            <td></td>
                            <td><span class="fw-semibold">
                                    <%= attr.name %>
                                </span></td>
                            <td>
                                <%= attr.description %>
                            </td>
                            <td class="text-lg-center">
                                <div class="d-inline-block">
                                    <button class="btn btn-sm btn-icon dropdown-toggle hide-arrow"
                                        data-bs-toggle="dropdown"><i class="bx bx-dots-vertical-rounded"></i></button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a href="javascript:0;" class="dropdown-item edit-btn" data-id="<%= attr.id %>"
                                            data-name="<%= attr.name %>"
                                            data-description="<%= attr.description %>">Edit</a>
                                        <div class="dropdown-divider"></div>
                                        <a href="javascript:0;" class="dropdown-item text-danger delete-record"
                                            data-id="<%= attr.id %>">Delete</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <!-- Offcanvas to add/edit attribute -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEcommerceCategoryList"
        aria-labelledby="offcanvasEcommerceCategoryListLabel">
        <!-- Offcanvas Header -->
        <div class="offcanvas-header py-4">
            <h5 id="offcanvasEcommerceCategoryListLabel" class="offcanvas-title">Add Attribute</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <!-- Offcanvas Body -->
        <div class="offcanvas-body border-top">
            <form class="pt-0" id="eCommerceCategoryListForm" action="/admin/ecommerce/attributes" method="POST">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                <!-- Name -->
                <div class="mb-3">
                    <label class="form-label" for="ecommerce-category-title">Title</label>
                    <input type="text" class="form-control" id="ecommerce-category-title"
                        placeholder="Enter attribute title" name="name" aria-label="attribute title" required>
                </div>
                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" id="ecommerce-category-description" name="description"
                        placeholder="Enter description" rows="3"></textarea>
                </div>
                <!-- Submit and Reset -->
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary me-sm-3 me-1 data-submit">Add</button>
                    <button type="reset" class="btn btn-label-danger" data-bs-dismiss="offcanvas">Discard</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const offCanvasElement = document.getElementById('offcanvasEcommerceCategoryList');
        const offCanvasInstance = new bootstrap.Offcanvas(offCanvasElement);
        const attributeForm = document.getElementById('eCommerceCategoryListForm');
        const offCanvasTitle = document.getElementById('offcanvasEcommerceCategoryListLabel');
        const submitBtn = attributeForm.querySelector('.data-submit');

        // DataTable Initialization
        if ($.fn.DataTable) {
            $('.datatables-category-list').DataTable({
                dom: '<"card-header d-flex flex-wrap pb-2"<"me-5 ms-n2"f><"d-flex justify-content-start justify-content-md-end align-items-baseline"<"dt-action-buttons d-flex align-items-start align-items-md-center justify-content-sm-center mb-3 mb-sm-0"lB>>>t<"row mx-2"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',
                buttons: [
                    {
                        text: '<i class="bx bx-plus me-0 me-sm-1"></i><span class="d-none d-sm-inline-block">Add Attribute</span>',
                        className: 'add-new btn btn-primary ms-2',
                        action: function () {
                            offCanvasTitle.textContent = 'Add Attribute';
                            attributeForm.action = '/admin/ecommerce/attributes';
                            submitBtn.textContent = 'Add';
                            attributeForm.reset();
                            offCanvasInstance.show();
                        }
                    }
                ]
            });
        }

        // Handle Edit Click
        $(document).on('click', '.edit-btn', function () {
            const id = $(this).data('id');
            const name = $(this).data('name');
            const description = $(this).data('description');

            offCanvasTitle.textContent = 'Edit Attribute';
            attributeForm.action = '/admin/ecommerce/attributes/edit/' + id;
            submitBtn.textContent = 'Update';

            document.getElementById('ecommerce-category-title').value = name;
            document.getElementById('ecommerce-category-description').value = description;

            offCanvasInstance.show();
        });

        // Handle Delete Click
        $(document).on('click', '.delete-record', function () {
            const id = $(this).data('id');
            if (confirm('Are you sure you want to delete this attribute?')) {
                fetch('/admin/ecommerce/attributes/delete/' + id, {
                    method: 'DELETE',
                    headers: {
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    }
                }).then(response => {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Error deleting attribute');
                    }
                }).catch(err => {
                    console.error('Error:', err);
                    alert('Error deleting attribute');
                });
            }
        });
    });
</script>