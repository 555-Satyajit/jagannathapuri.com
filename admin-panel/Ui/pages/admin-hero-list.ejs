<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4">
        <span class="text-muted fw-light">Store Configuration / </span> Manage Hero Section
    </h4>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Hero Slides</h5>
            <a href="/admin/store/home/hero/add" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i> Add New Slide
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Header</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        <% if (heroes && heroes.length> 0) { %>
                            <% heroes.forEach(hero=> { %>
                                <tr>
                                    <td>
                                        <% if (hero.image) { %>
                                            <img src="<%= (hero.image.startsWith('image-') ? '/uploads/' : '/assets/images/hero/') + hero.image %>"
                                                alt="Hero" class="rounded"
                                                style="width: 100px; height: 50px; object-fit: cover;">
                                            <% } else { %>
                                                <span class="badge bg-label-secondary">No Image</span>
                                                <% } %>
                                    </td>
                                    <td><strong>
                                            <%= hero.title %>
                                        </strong></td>
                                    <td>
                                        <%= hero.header %>
                                    </td>
                                    <td>
                                        <div class="d-inline-block text-nowrap">
                                            <a href="/admin/store/home/hero/edit/<%= hero.id %>"
                                                class="btn btn-sm btn-icon"><i class="bx bx-edit text-primary"></i></a>
                                            <button class="btn btn-sm btn-icon delete-hero" data-id="<%= hero.id %>"><i
                                                    class="bx bx-trash text-danger"></i></button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="text-center">No hero slides found.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.delete-hero').forEach(btn => {
            btn.onclick = function () {
                if (confirm('Are you sure you want to delete this slide?')) {
                    const id = this.dataset.id;
                    fetch(`/admin/store/home/hero/delete/${id}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) location.reload();
                            else alert('Failed to delete slide');
                        });
                }
            };
        });
    });
</script>