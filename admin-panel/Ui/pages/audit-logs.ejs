<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Settings /</span> Audit Logs</h4>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title">Filter</h5>
        <div class="d-flex justify-content-between align-items-center row py-3 gap-3 gap-md-0">
            <div class="col-md-3">
                <select id="FilterAdmin" class="form-select text-capitalize">
                    <option value="">All Admins</option>
                    <% admins.forEach(admin => { %>
                        <option value="<%= admin.id %>"><%= admin.full_name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <select id="FilterAction" class="form-select text-capitalize">
                    <option value="">All Actions</option>
                    <% actions.forEach(action => { %>
                        <option value="<%= action %>"><%= action %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <select id="FilterEntity" class="form-select text-capitalize">
                    <option value="">All Entities</option>
                    <% entities.forEach(entity => { %>
                        <option value="<%= entity %>"><%= entity %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" id="FilterIP" class="form-control" placeholder="Search IP Address" />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center row py-3 gap-3 gap-md-0">
            <div class="col-md-4">
                <input type="text" id="FilterDateRange" class="form-control" placeholder="Select Date Range" />
            </div>
            <div class="col-md-2">
                <button id="btnResetFilters" class="btn btn-label-secondary w-100">
                    <i class="bx bx-reset me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Audit Logs Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="m-0">Activity History</h5>
    </div>
    <div class="card-datatable table-responsive">
        <table class="datatables-audit-logs table border-top">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Admin</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<!--/ Audit Logs Table -->