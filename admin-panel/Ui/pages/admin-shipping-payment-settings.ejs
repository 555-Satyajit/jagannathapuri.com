<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Store Configuration /</span> Shipping & Payment</h4>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Shipping & Payment Settings</h5>
            <p class="card-text">Manage your store's shipping rates and payment gateways here.</p>

            <form action="/admin/settings/shipping-payment" method="POST">
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6>Shipping Settings</h6>
                        <div class="mb-3">
                            <label class="form-label">Flat Rate Shipping (₹)</label>
                            <input type="number" name="shipping[flat_rate]" class="form-control"
                                value="<%= settings.shipping.flat_rate %>" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Free Shipping Threshold (₹)</label>
                            <input type="number" name="shipping[free_shipping_threshold]" class="form-control"
                                value="<%= settings.shipping.free_shipping_threshold %>" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6>Payment Gateways</h6>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="payment[cod_enabled]" id="cod_enabled"
                                <%=settings.payment.cod_enabled ? 'checked' : '' %>>
                            <label class="form-check-label" for="cod_enabled">Enable Cash on Delivery (COD)</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="payment[online_payment_enabled]"
                                id="online_payment_enabled" <%=settings.payment.online_payment_enabled ? 'checked' : ''
                                %>>
                            <label class="form-check-label" for="online_payment_enabled">Enable Online Payments
                                (Razorpay/Stripe)</label>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save Settings</button>
                    <span class="text-muted ms-2"><i class="bx bx-info-circle"></i> Some features are in
                        development.</span>
                </div>
            </form>
        </div>
    </div>
</div>