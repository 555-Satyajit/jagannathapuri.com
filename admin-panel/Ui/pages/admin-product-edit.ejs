<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">eCommerce /</span><span> Edit Product</span>
</h4>

<div class="app-ecommerce">

    <!-- Add Product -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3">

        <div class="d-flex flex-column justify-content-center">
            <% console.log('Rendering product edit for ID:', product.id); %>
                <!-- Hidden data for JavaScript -->
                <script id="raw-product-data" type="application/json">
                <%- JSON.stringify(product).replace(/</g, '\\u003c') %>
            </script>
                <h4 class="mb-1 mt-3">Edit Product</h4>
                <p class="text-muted">Orders placed across your store</p>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-2">
            <div class="px-0"><button class="btn btn-label-secondary me-2">Discard</button>
                <button class="btn btn-label-primary">Save draft</button>
            </div>
            <button type="button" id="publish-product-btn" class="btn btn-primary">Publish product</button>
        </div>

    </div>

    <form id="eCommerceProductEditForm" enctype="multipart/form-data">
        <div class="row">

            <!-- First column-->
            <div class="col-12 col-lg-8">
                <!-- Product Information -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-tile mb-0">Product information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label" for="ecommerce-product-name">Name</label>
                                <input type="text" class="form-control" id="ecommerce-product-name"
                                    placeholder="Product title" name="product_name" aria-label="Product title">
                            </div>
                            <div class="col">
                                <label class="form-label" for="ecommerce-product-slug">Slug</label>
                                <input type="text" class="form-control" id="ecommerce-product-slug"
                                    placeholder="product-slug" name="slug" aria-label="Product slug">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col"><label class="form-label" for="ecommerce-product-sku">SKU</label>
                                <input type="number" class="form-control" id="ecommerce-product-sku" placeholder="SKU"
                                    name="sku" aria-label="Product SKU">
                            </div>
                            <div class="col"><label class="form-label" for="ecommerce-product-barcode">Barcode</label>
                                <input type="text" class="form-control" id="ecommerce-product-barcode"
                                    placeholder="0123-4567" name="productBarcode" aria-label="Product barcode">
                            </div>
                        </div>
                        <!-- Description -->
                        <div>
                            <label class="form-label">Description <span class="text-muted">(Optional)</span></label>
                            <div class="form-control p-0 pt-1">
                                <div class="comment-toolbar border-0 border-bottom">
                                    <div class="d-flex justify-content-start">
                                        <span class="ql-formats me-0">
                                            <button class="ql-bold"></button>
                                            <button class="ql-italic"></button>
                                            <button class="ql-underline"></button>
                                            <button class="ql-list" value="ordered"></button>
                                            <button class="ql-list" value="bullet"></button>
                                            <button class="ql-link"></button>
                                            <button class="ql-image"></button>
                                        </span>
                                    </div>
                                </div>
                                <div class="comment-editor border-0 pb-4" id="ecommerce-category-description">
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Product Information -->
                <!-- Media -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 card-title">Media</h5>
                        <a href="javascript:void(0);" class="fw-medium">Add media from URL</a>
                    </div>
                    <div class="card-body">
                        <div class="image-upload-wrapper">
                            <div class="image-preview-container d-flex flex-wrap gap-2 mb-3"
                                id="image-preview-container">
                                <!-- Previews will appear here -->
                            </div>
                            <label for="product-images" class="btn btn-outline-primary w-100">
                                <i class="bx bx-upload me-1"></i> Upload New Images
                                <input type="file" id="product-images" name="product_images" multiple class="d-none"
                                    accept="image/*">
                            </label>
                            <small class="text-muted d-block mt-2">Up to 10 images total. Max 5MB per image.</small>
                        </div>
                        <!-- Existing Images -->
                        <div id="existing-images" class="mt-4">
                            <h6>Existing Images</h6>
                            <div class="d-flex flex-wrap gap-2">
                                <% if (product.images && Array.isArray(product.images)) { %>
                                    <% product.images.forEach((img, index)=> { %>
                                        <div class="position-relative">
                                            <img src="<%= (img && img.startsWith('http')) ? img : '/uploads/' + img %>"
                                                class="rounded border"
                                                style="width: 80px; height: 80px; object-fit: cover;">
                                            <button type="button"
                                                class="btn btn-sm btn-icon btn-danger position-absolute top-0 end-0 remove-existing-img"
                                                data-index="<%= index %>">
                                                <i class="bx bx-x"></i>
                                            </button>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <p class="text-muted small">No images found.</p>
                                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Media -->
                <!-- Specifications -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Product Specifications</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-repeater">
                            <div data-repeater-list="group-a">
                                <div data-repeater-item>
                                    <div class="row">

                                        <div class="mb-3 col-4">
                                            <label class="form-label" for="form-repeater-1-1">Attribute Name</label>
                                            <select id="form-repeater-1-1" name="spec_name" class="select2 form-select"
                                                data-placeholder="Choose Attribute">
                                                <option value="">Choose Attribute</option>
                                                <% attributes.forEach(attr=> { %>
                                                    <option value="<%= attr.name %>">
                                                        <%= attr.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>

                                        <div class="mb-3 col-8">
                                            <label class="form-label" for="form-repeater-1-2">Value</label>
                                            <input type="text" id="form-repeater-1-2" name="spec_value"
                                                class="form-control" placeholder="e.g. Pure Silk, 1kg" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-primary" data-repeater-create>
                                    Add another attribute
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Specifications -->
                <!-- SEO & Meta Tags -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">SEO & Meta Tags</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label" for="meta_title">Meta Title</label>
                            <input type="text" class="form-control seo-strength-title" id="meta_title" name="meta_title"
                                placeholder="SEO Title" value="<%= product.meta_title || '' %>">
                            <div class="seo-meter mt-1">
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">Strength: <span
                                            class="strength-label">Check...</span></small>
                                    <small class="text-muted"><span class="char-count">0</span> / 60 chars</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="meta_description">Meta Description</label>
                            <textarea class="form-control seo-strength-desc" id="meta_description"
                                name="meta_description" rows="3"
                                placeholder="SEO Description"><%= product.meta_description || '' %></textarea>
                            <div class="seo-meter mt-1">
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">Strength: <span
                                            class="strength-label">Check...</span></small>
                                    <small class="text-muted"><span class="char-count">0</span> / 160 chars</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="meta_keywords">Meta Keywords</label>
                            <input type="text" class="form-control" id="meta_keywords" name="meta_keywords"
                                placeholder="keyword1, keyword2" value="<%= product.meta_keywords || '' %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="image_alt">Image Alt Text</label>
                            <input type="text" class="form-control" id="image_alt" name="image_alt"
                                placeholder="Alt text for product images" value="<%= product.image_alt || '' %>">
                            <div class="form-text">Used for accessibility and image search SEO.</div>
                        </div>
                    </div>
                </div>
                <!-- /SEO & Meta Tags -->
                <!-- Inventory -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Inventory</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Navigation -->
                            <div class="col-12 col-md-4 mx-auto card-separator">
                                <div class="d-flex justify-content-between flex-column mb-3 mb-md-0 pe-md-3">
                                    <ul class="nav nav-align-left nav-pills flex-column">
                                        <li class="nav-item">
                                            <button class="nav-link active" data-bs-toggle="tab"
                                                data-bs-target="#restock">
                                                <i class="bx bx-cube me-2"></i>
                                                <span class="align-middle">Restock</span>
                                            </button>
                                        </li>
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#shipping">
                                                <i class="bx bx-car me-2"></i>
                                                <span class="align-middle">Shipping</span>
                                            </button>
                                        </li>
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-toggle="tab"
                                                data-bs-target="#global-delivery">
                                                <i class="bx bx-globe me-2"></i>
                                                <span class="align-middle">Global Delivery</span>
                                            </button>
                                        </li>
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#attributes">
                                                <i class="bx bx-link me-2"></i>
                                                <span class="align-middle">Attributes</span>
                                            </button>
                                        </li>
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#advanced">
                                                <i class="bx bx-lock me-2"></i>
                                                <span class="align-middle">Advanced</span>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <!-- /Navigation -->
                            <!-- Options -->
                            <div class="col-12 col-md-8 pt-4 pt-md-0">
                                <div class="tab-content p-0 pe-md-5 ps-md-3">
                                    <!-- Restock Tab -->
                                    <div class="tab-pane fade show active" id="restock" role="tabpanel">
                                        <h5>Options</h5>
                                        <label class="form-label" for="ecommerce-product-stock">Add to Stock</label>
                                        <div class="row mb-3 g-3">
                                            <div class="col-12 col-sm-9">
                                                <input type="number" class="form-control" id="ecommerce-product-stock"
                                                    placeholder="Quantity" name="quantity" aria-label="Quantity">
                                            </div>
                                            <div class="col-12 col-sm-3">
                                                <button class="btn btn-primary"><i
                                                        class='bx bx-check me-2'></i>Confirm</button>
                                            </div>
                                        </div>
                                        <!-- Low Stock Threshold -->
                                        <div class="mb-3">
                                            <label class="form-label" for="ecommerce-product-low-stock">Low Stock
                                                Threshold</label>
                                            <input type="number" class="form-control" id="ecommerce-product-low-stock"
                                                placeholder="Notify when stock is below this" name="lowStockThreshold"
                                                aria-label="Low Stock Threshold"
                                                value="<%= product.lowStockThreshold !== undefined ? product.lowStockThreshold : 10 %>">
                                            <div class="form-text">System will notify when stock drops below this level.
                                            </div>
                                        </div>
                                        <div>
                                            <h6>Product in stock now: <span class="text-muted">54</span></h6>
                                            <h6>Product in transit: <span class="text-muted">390</span></h6>
                                            <h6>Last time restocked: <span class="text-muted">24th June, 2023</span>
                                            </h6>
                                            <h6>Total stock over lifetime: <span class="text-muted">2430</span></h6>
                                        </div>
                                    </div>
                                    <!-- Shipping Tab -->
                                    <div class="tab-pane fade" id="shipping" role="tabpanel">
                                        <h5 class="mb-4">Shipping Type</h5>
                                        <div>
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="radio" name="shippingType"
                                                    id="seller">
                                                <label class="form-check-label pt-1" for="seller">
                                                    <span class="mb-1 h6">Fulfilled by Seller</span><br>
                                                    <small class="text-muted">You'll be responsible for product
                                                        delivery.<br>
                                                        Any damage or delay during shipping may cost you a Damage
                                                        fee.</small>
                                                </label>
                                            </div>
                                            <div class="form-check mb-5">
                                                <input class="form-check-input" type="radio" name="shippingType"
                                                    id="companyName" checked>
                                                <label class="form-check-label pt-1" for="companyName">
                                                    <span class="mb-1 h6">Fulfilled by Company name &nbsp;<span
                                                            class="badge rounded-2 badge-warning bg-label-warning fs-tiny py-1">RECOMMENDED</span></span><br>
                                                    <small class="text-muted">Your product, Our responsibility.<br>
                                                        For a measly fee, we will handle the delivery process for
                                                        you.</small>
                                                </label>
                                            </div>
                                            <p class="mb-0">See our <a href="javascript:void(0);">Delivery terms and
                                                    conditions</a> for details</p>
                                        </div>
                                    </div>
                                    <!-- Global Delivery Tab -->
                                    <div class="tab-pane fade" id="global-delivery" role="tabpanel">
                                        <h5 class="mb-4">Global Delivery</h5>
                                        <!-- Worldwide delivery -->
                                        <div class="form-check mb-3">
                                            <input class="form-check-input" type="radio" name="globalDel"
                                                id="worldwide">
                                            <label class="form-check-label pt-1" for="worldwide">
                                                <span class="mb-1 h6">Worldwide delivery</span><br>
                                                <small class="text-muted">Only available with Shipping method:
                                                    <a href="javascript:void(0);">Fulfilled by Company name</a></small>
                                            </label>
                                        </div>
                                        <!-- Global delivery -->
                                        <div class="form-check mb-3">
                                            <input class="form-check-input" type="radio" name="globalDel" checked>
                                            <label class="form-check-label w-75 pe-5 pt-1" for="country-selected">
                                                <span class="mb-2 h6">Selected Countries</span>
                                                <input type="text" class="form-control" placeholder="Type Country name"
                                                    id="country-selected">
                                            </label>
                                        </div>
                                        <!-- Local delivery -->
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="globalDel" id="local">
                                            <label class="form-check-label pt-1" for="local">
                                                <span class="mb-1 h6">Local delivery</span><br>
                                                <small class="text-muted">Deliver to your country of residence :
                                                    <a href="javascript:void(0);">Change profile address</a></small>
                                            </label>
                                        </div>
                                    </div>
                                    <!-- Attributes Tab -->
                                    <div class="tab-pane fade" id="attributes" role="tabpanel">
                                        <h5 class="mb-4">Attributes</h5>
                                        <div>
                                            <!-- Fragile Product -->
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox" value="fragile"
                                                    id="fragile">
                                                <label class="form-check-label" for="fragile">
                                                    <span class="mb-0 h6">Fragile Product</span>
                                                </label>
                                            </div>
                                            <!-- Biodegradable -->
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox" value="biodegradable"
                                                    id="biodegradable">
                                                <label class="form-check-label" for="biodegradable">
                                                    <span class="mb-0 h6">Biodegradable</span>
                                                </label>
                                            </div>
                                            <!-- Frozen Product -->
                                            <div class="form-check mb-3">
                                                <input class="form-check-input" type="checkbox" value="frozen" checked>
                                                <label class="form-check-label w-75 pe-5" for="frozen">
                                                    <span class="mb-1 pt-1 h6">Frozen Product</span>
                                                    <input type="number" class="form-control"
                                                        placeholder="Max. allowed Temperature" id="frozen">
                                                </label>
                                            </div>
                                            <!-- Exp Date -->
                                            <div class="form-check mb-4">
                                                <input class="form-check-input" type="checkbox" value="expDate"
                                                    id="expDate" checked>
                                                <label class="form-check-label w-75 pe-5" for="date-input">
                                                    <span class="mb-1 pt-1 h6">Expiry Date of Product</span>
                                                    <input type="date" class="product-date form-control"
                                                        id="date-input">
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /Attributes Tab -->
                                    <!-- Advanced Tab -->
                                    <div class="tab-pane fade" id="advanced" role="tabpanel">
                                        <h5 class="mb-4">Advanced</h5>
                                        <div class="row">
                                            <!-- Product Id Type -->
                                            <div class="col">
                                                <label class="form-label" for="product-id">
                                                    <span class="mb-0 h6">Product ID Type</span>
                                                </label>
                                                <select id="product-id" class="select2 form-select"
                                                    data-placeholder="ISBN">
                                                    <option value="">ISBN</option>
                                                    <option value="ISBN">ISBN</option>
                                                    <option value="UPC">UPC</option>
                                                    <option value="EAN">EAN</option>
                                                    <option value="JAN">JAN</option>
                                                </select>
                                            </div>
                                            <!-- Product Id -->
                                            <div class="col">
                                                <label class="form-label" for="product-id-1">
                                                    <span class="mb-0 h6">Product ID</span>
                                                </label>
                                                <input type="number" id="product-id-1" class="form-control"
                                                    placeholder="ISBN Number" />
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /Advanced Tab -->

                                </div>
                            </div>
                            <!-- /Options-->
                        </div>
                    </div>
                </div>
                <!-- /Inventory -->
            </div>
            <!-- /Second column -->

            <!-- Second column -->
            <div class="col-12 col-lg-4">
                <!-- Pricing Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Pricing</h5>
                    </div>
                    <div class="card-body">
                        <!-- Regular Price -->
                        <div class="mb-3">
                            <label class="form-label" for="ecommerce-product-price">Regular Price</label>
                            <input type="number" class="form-control" id="ecommerce-product-price" placeholder="Price"
                                name="regular_price" aria-label="Product price">
                        </div>
                        <!-- Sale Price -->
                        <div class="mb-3">
                            <label class="form-label" for="ecommerce-product-discount-price">Sale Price</label>
                            <input type="number" class="form-control" id="ecommerce-product-discount-price"
                                placeholder="Sale Price" name="sale_price" aria-label="Product sale price">
                        </div>
                        <!-- On Sale switch -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="mb-0 h6">On Sale</span>
                            <div class="w-25 d-flex justify-content-end">
                                <label class="switch switch-primary switch-sm me-4 pe-2">
                                    <input type="checkbox" class="switch-input" name="on_sale" id="on_sale"
                                        <%=product.on_sale ? 'checked' : '' %>>
                                    <span class="switch-toggle-slider">
                                        <span class="switch-on">
                                            <span class="switch-off"></span>
                                        </span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <!-- Charge tax check box -->
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" value="" id="price-charge-tax" checked>
                            <label class="form-label" for="price-charge-tax">
                                Charge tax on this product
                            </label>
                        </div>
                        <!-- Allow COD check box -->
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" value="" id="price-allow-cod" name="is_cod"
                                <%=product.is_cod !==false ? 'checked' : '' %>>
                            <label class="form-label" for="price-allow-cod">
                                Allow Cash on Delivery (COD)
                            </label>
                        </div>
                        <!-- Cost Price (Internal) -->
                        <div class="mb-3 mt-3">
                            <label class="form-label" for="ecommerce-product-cost-price">Cost Price <span
                                    class="text-muted">(Internal)</span></label>
                            <input type="number" class="form-control" id="ecommerce-product-cost-price"
                                placeholder="Cost Price" name="costPrice" aria-label="Product cost price"
                                value="<%= product.costPrice || '' %>">
                            <small class="text-muted">Not visible to customers. Used for profit calculation.</small>
                        </div>
                        <!-- Instock switch -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <span class="mb-0 h6">In stock</span>
                            <div class="w-25 d-flex justify-content-end">
                                <label class="switch switch-primary switch-sm me-4 pe-2">
                                    <input type="checkbox" class="switch-input" checked="">
                                    <span class="switch-toggle-slider">
                                        <span class="switch-on">
                                            <span class="switch-off"></span>
                                        </span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <!-- Featured Product switch -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                            <span class="mb-0 h6">Featured Product</span>
                            <div class="w-25 d-flex justify-content-end">
                                <label class="switch switch-primary switch-sm me-4 pe-2">
                                    <input type="checkbox" class="switch-input" name="is_featured" id="is_featured"
                                        <%=product.is_featured ? 'checked' : '' %>>
                                    <span class="switch-toggle-slider">
                                        <span class="switch-on">
                                            <span class="switch-off"></span>
                                        </span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <!-- Show in Explore switch -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                            <span class="mb-0 h6">Show in Explore Puri Treasures</span>
                            <div class="w-25 d-flex justify-content-end">
                                <label class="switch switch-primary switch-sm me-4 pe-2">
                                    <input type="checkbox" class="switch-input" name="show_in_explore"
                                        id="show_in_explore" <%=product.show_in_explore ? 'checked' : '' %>>
                                    <span class="switch-toggle-slider">
                                        <span class="switch-on">
                                            <span class="switch-off"></span>
                                        </span>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Pricing Card -->
                <!-- Organize Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Organize</h5>
                    </div>
                    <div class="card-body">
                        <!-- Vendor -->
                        <div class="mb-3 col ecommerce-select2-dropdown">
                            <label class="form-label mb-1" for="vendor">
                                Vendor
                            </label>
                            <select id="vendor" class="select2 form-select" data-placeholder="Select Vendor"
                                name="product_brand">
                                <option value="">Select Vendor</option>
                                <option value="Jagannathapuri">Jagannathapuri</option>
                                <option value="Utkal Crafts">Utkal Crafts</option>
                                <option value="Puri Handloom">Puri Handloom</option>
                            </select>
                        </div>
                        <!-- Category -->
                        <div class="mb-3 col ecommerce-select2-dropdown">
                            <label class="form-label mb-1 d-flex justify-content-between align-items-center"
                                for="category-org">
                                <span>Category</span><a href="javascript:void(0);" class="fw-medium">Add new
                                    category</a>
                            </label>
                            <select id="category-org" class="select2 form-select" data-placeholder="Select Category"
                                name="category">
                                <option value="">Select Category</option>
                                <% categories.forEach(cat=> { %>
                                    <option value="<%= cat.id %>" <%=product.category_id===cat.id ? 'selected' : '' %>>
                                        <%= cat.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <!-- Product Type -->
                        <div class="mb-3 col ecommerce-select2-dropdown">
                            <label class="form-label mb-1" for="product-type">
                                Product Type
                            </label>
                            <select id="product-type" class="select2 form-select" data-placeholder="Select Product Type"
                                name="product_type">
                                <option value="Simple" <%=product.product_type==='Simple' ? 'selected' : '' %>>Simple
                                </option>
                                <option value="Variable" <%=product.product_type==='Variable' ? 'selected' : '' %>
                                    >Variable
                                </option>
                                <option value="Digital" <%=product.product_type==='Digital' ? 'selected' : '' %>>Digital
                                </option>
                            </select>
                        </div>
                        <!-- Collection -->
                        <div class="mb-3 col ecommerce-select2-dropdown">
                            <label class="form-label mb-1" for="collection">Collection
                            </label>
                            <select id="collection" class="select2 form-select" data-placeholder="Collection">
                                <option value="">Collection</option>
                                <option value="men-clothing">Men's Clothing</option>
                                <option value="women-clothing">Women's-clothing</option>
                                <option value="kid-clothing">Kid's-clothing</option>
                            </select>
                        </div>
                        <!-- Status -->
                        <div class="mb-3 col ecommerce-select2-dropdown">
                            <label class="form-label mb-1" for="status-org">Status
                            </label>
                            <select id="status-org" class="select2 form-select" data-placeholder="Published"
                                name="status">
                                <option value="">Select Status</option>
                                <option value="Published">Published</option>
                                <option value="Scheduled">Scheduled</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                        <!-- Tags -->
                        <div class="mb-3">
                            <label for="ecommerce-product-tags" class="form-label mb-1">Tags</label>
                            <input id="ecommerce-product-tags" class="form-control" name="ecommerce-product-tags"
                                value="Normal,Standard,Premium" aria-label="Product Tags" />
                        </div>
                    </div>
                </div>
                <!-- /Organize Card -->
            </div>
            <!-- /Second column -->
        </div>
    </form>
</div>

<script>
    // Initialize global variable for images EARLY
    if (!window.uploadedImages) {
        window.uploadedImages = [];
    }

    document.addEventListener('DOMContentLoaded', function () {
        const imageInput = document.getElementById('product-images');
        const previewContainer = document.getElementById('image-preview-container');
        let selectedFiles = [];
        let existingImages = [];

        // Load existing images from raw data
        let editProductData;
        try {
            const rawData = document.getElementById('raw-product-data').textContent;
            editProductData = JSON.parse(rawData);
            if (editProductData.images && Array.isArray(editProductData.images)) {
                existingImages = [...editProductData.images];
                // Also populate global uploadedImages for other parts of the script if needed
                editProductData.images.forEach(img => {
                    if (!window.uploadedImages.includes(img)) {
                        window.uploadedImages.push(img);
                    }
                });
            }
        } catch (e) {
            console.error('Failed to parse existing images or product data:', e);
        }

        imageInput.addEventListener('change', function (e) {
            const files = Array.from(e.target.files);
            files.forEach(file => {
                if (selectedFiles.length + existingImages.length >= 10) return;
                selectedFiles.push(file);

                const reader = new FileReader();
                reader.onload = function (event) {
                    const div = document.createElement('div');
                    div.className = 'position-relative';
                    div.style.width = '100px';
                    div.style.height = '100px';
                    div.innerHTML = `
                        <img src="${event.target.result}" class="rounded border w-100 h-100" style="object-fit: cover;">
                        <button type="button" class="btn btn-xs btn-icon btn-danger position-absolute top-0 end-0 remove-new-preview" data-name="${file.name}">
                            <i class="bx bx-x"></i>
                        </button>
                    `;
                    previewContainer.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        });

        // SEO Strength Meter Logic
        function updateSeoMeter(input, max, ideal_min, ideal_max) {
            const meter = input.nextElementSibling;
            if (!meter || !meter.classList.contains('seo-meter')) return;

            const label = meter.querySelector('.strength-label');
            const countDisplay = meter.querySelector('.char-count');
            const bar = meter.querySelector('.progress-bar');

            const count = input.value.length;
            countDisplay.textContent = count;

            let percent = (count / max) * 100;
            if (percent > 100) percent = 100;
            bar.style.width = percent + '%';

            if (count === 0) {
                label.textContent = 'Empty';
                label.className = 'strength-label text-muted';
                bar.className = 'progress-bar bg-secondary';
            } else if (count < ideal_min) {
                label.textContent = 'Weak';
                label.className = 'strength-label text-danger';
                bar.className = 'progress-bar bg-danger';
            } else if (count <= ideal_max) {
                label.textContent = 'Best';
                label.className = 'strength-label text-success';
                bar.className = 'progress-bar bg-success';
            } else {
                label.textContent = 'Good (Too long)';
                label.className = 'strength-label text-warning';
                bar.className = 'progress-bar bg-warning';
            }
        }

        const titleInputSeo = document.querySelector('.seo-strength-title');
        const descInputSeo = document.querySelector('.seo-strength-desc');

        if (titleInputSeo) {
            titleInputSeo.addEventListener('input', () => updateSeoMeter(titleInputSeo, 100, 30, 60));
            updateSeoMeter(titleInputSeo, 100, 30, 60);
        }
        if (descInputSeo) {
            descInputSeo.addEventListener('input', () => updateSeoMeter(descInputSeo, 300, 120, 160));
            updateSeoMeter(descInputSeo, 300, 120, 160);
        }

        // Removal logic for NEW images
        previewContainer.addEventListener('click', function (e) {
            if (e.target.closest('.remove-new-preview')) {
                const btn = e.target.closest('.remove-new-preview');
                const name = btn.getAttribute('data-name');
                selectedFiles = selectedFiles.filter(f => f.name !== name);
                btn.parentElement.remove();
            }
        });

        // Removal logic for EXISTING images
        $(document).on('click', '.remove-existing-img', function () {
            const parent = $(this).parent();
            const imgSrc = parent.find('img').attr('src');
            // Fix: Decode the filename to handle spaces/special chars (e.g. %20 -> space)
            const filename = decodeURIComponent(imgSrc.split('/').pop());

            console.log('Removing existing image:', filename);
            const initialLength = existingImages.length;
            existingImages = existingImages.filter(img => img !== filename);

            if (existingImages.length === initialLength) {
                console.warn('Image not found in existingImages array. Filename:', filename, 'Array:', existingImages);
                // Fallback: Try checking without decoding or partial match if needed?
                // For now, strict match after decode should work if server sent strict names.
            }

            parent.remove();
        });

        const publishBtn = document.getElementById('publish-product-btn');
        if (publishBtn) {
            publishBtn.addEventListener('click', function (e) {
                e.preventDefault();

                // Show loading state
                const originalBtnText = publishBtn.innerHTML;
                publishBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Updating...';
                publishBtn.disabled = true;

                const form = document.getElementById('eCommerceProductEditForm');
                const formData = new FormData(form);

                // Add specifications
                const specifications = [];
                $('.form-repeater [data-repeater-item]').each(function () {
                    const name = $(this).find('[name*="spec_name"]').val();
                    const value = $(this).find('[name*="spec_value"]').val();
                    if (name && value) {
                        specifications.push({ name, value });
                    }
                });
                formData.set('specifications', JSON.stringify(specifications));

                // Get Quill description
                const description = document.querySelector('.comment-editor .ql-editor') ? document.querySelector('.comment-editor .ql-editor').innerHTML : '';
                formData.set('description', description);

                // Handle images
                formData.delete('product_images'); // Clear any defaults
                // 1. Add existing image names
                existingImages.forEach(img => {
                    formData.append('product_images', img);
                });
                // 2. Add new file objects
                selectedFiles.forEach(file => {
                    formData.append('product_images', file);
                });

                // Price and other fields formatting
                formData.set('regular_price', document.getElementById('ecommerce-product-price').value);
                formData.set('price', document.getElementById('ecommerce-product-price').value);
                formData.set('sale_price', document.getElementById('ecommerce-product-discount-price').value);
                formData.set('on_sale', document.getElementById('on_sale').checked);

                formData.set('category', $('#category-org').val());

                const statusMapReverse = { 'Published': 1, 'Scheduled': 2, 'Inactive': 3 };
                formData.set('status', statusMapReverse[$('#status-org').val()] || 1);

                formData.set('product_brand', $('#vendor').val());
                formData.set('quantity', document.getElementById('ecommerce-product-stock') ? parseInt(document.getElementById('ecommerce-product-stock').value) : 0);
                formData.set('costPrice', document.getElementById('ecommerce-product-cost-price') ? document.getElementById('ecommerce-product-cost-price').value : 0);
                formData.set('is_cod', document.getElementById('price-allow-cod').checked);
                formData.set('is_featured', document.getElementById('is_featured').checked);
                formData.set('show_in_explore', document.getElementById('show_in_explore').checked);

                // SEO Fields
                formData.set('meta_title', document.getElementById('meta_title').value);
                formData.set('meta_description', document.getElementById('meta_description').value);
                formData.set('meta_keywords', document.getElementById('meta_keywords').value);
                formData.set('image_alt', document.getElementById('image_alt').value);

                const productId = window.location.pathname.split('/').pop();

                $.ajax({
                    url: '/admin/ecommerce/products/edit/' + productId,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        publishBtn.innerHTML = originalBtnText;
                        publishBtn.disabled = false;
                        if (res.success) {
                            // Using SweetAlert if available, else standard alert
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Updated!',
                                    text: 'Product updated successfully!',
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    window.location.href = '/admin/ecommerce/products';
                                });
                            } else {
                                alert('Product updated successfully!');
                                window.location.href = '/admin/ecommerce/products';
                            }
                        } else {
                            alert('Error: ' + (res.error || 'Unknown error'));
                        }
                    },
                    error: function (xhr, status, error) {
                        publishBtn.innerHTML = originalBtnText;
                        publishBtn.disabled = false;
                        console.error('Update Error:', error);
                        alert('System Error during update.');
                    }
                });
            });
        }

        // Populate fields
        if (editProductData) {
            if (document.getElementById('ecommerce-product-name'))
                document.getElementById('ecommerce-product-name').value = editProductData.product_name || '';

            if (document.getElementById('ecommerce-product-slug'))
                document.getElementById('ecommerce-product-slug').value = editProductData.slug || '';

            if (document.getElementById('ecommerce-product-sku'))
                document.getElementById('ecommerce-product-sku').value = editProductData.sku || '';

            if (document.getElementById('ecommerce-product-price'))
                document.getElementById('ecommerce-product-price').value = editProductData.regular_price || (editProductData.price || '').replace('$', '').replace('₹', '');

            if (document.getElementById('ecommerce-product-discount-price'))
                document.getElementById('ecommerce-product-discount-price').value = editProductData.sale_price || '';

            if (document.getElementById('on_sale'))
                document.getElementById('on_sale').checked = editProductData.on_sale === true;

            if (document.getElementById('ecommerce-product-stock'))
                document.getElementById('ecommerce-product-stock').value = editProductData.quantity || 0;

            if (document.getElementById('price-allow-cod'))
                document.getElementById('price-allow-cod').checked = editProductData.is_cod !== false;

            if (document.getElementById('is_featured'))
                document.getElementById('is_featured').checked = editProductData.is_featured === true;

            // Set Quill content
            setTimeout(() => {
                const quillEditor = document.querySelector('.comment-editor .ql-editor');
                if (quillEditor) {
                    console.log('Setting Quill content');
                    quillEditor.innerHTML = editProductData.description || '';
                }
            }, 800);

            // Use jQuery to set Select2 values
            if (typeof $ !== 'undefined') {
                console.log('jQuery found, initializing Select2 and Repeater');
                if ($('#category-org').length) {
                    $('#category-org').val(editProductData.category_id).trigger('change');
                }

                if ($('#status-org').length) {
                    const statusText = editProductData.status === 1 ? 'Published' : editProductData.status === 2 ? 'Scheduled' : 'Inactive';
                    $('#status-org').val(statusText).trigger('change');
                }

                if ($('#vendor').length && editProductData.product_brand) {
                    $('#vendor').val(editProductData.product_brand).trigger('change');
                }

                if ($('#product-type').length && editProductData.product_type) {
                    $('#product-type').val(editProductData.product_type).trigger('change');
                }

                // Populate Specifications Repeater
                try {
                    const $repeater = $('.form-repeater');
                    if ($repeater.length) {
                        // Initialize repeater
                        const repeaterInstance = $repeater.repeater({
                            show: function () {
                                $(this).slideDown();
                                // Re-initialize select2 for new items if needed
                                if ($(this).find('.select2').length) {
                                    $(this).find('.select2').select2();
                                }
                            }
                        });

                        if (editProductData.specifications && editProductData.specifications.length > 0) {
                            console.log('Populating specifications:', editProductData.specifications);

                            // Map specifications to repeater list format
                            const list = editProductData.specifications.map(spec => {
                                return {
                                    'spec_name': spec.name,
                                    'spec_value': spec.value
                                };
                            });

                            // Use setList if available, or manual population
                            if (repeaterInstance.setList) {
                                repeaterInstance.setList(editProductData.specifications.map(spec => ({
                                    'spec_name': spec.name,
                                    'spec_value': spec.value
                                })));
                            } else {
                                // Fallback to manual if setList fails
                                editProductData.specifications.forEach((spec, index) => {
                                    if (index > 0) $('[data-repeater-create]').click();
                                    const $item = $('[data-repeater-item]').last();
                                    $item.find('[name*="spec_name"]').val(spec.name).trigger('change');
                                    $item.find('[name*="spec_value"]').val(spec.value);
                                });
                            }
                        }
                    }
                } catch (repeaterErr) {
                    console.error('Error populating repeater:', repeaterErr);
                }
            }
        } else {
            console.error('No editProductData available for population');
        }
    });
</script>