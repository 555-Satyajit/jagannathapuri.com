<!DOCTYPE html>
<html lang="en" class="light-style layout-wide " dir="ltr" data-theme="theme-default" data-assets-path="/admin-assets/"
    data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <base href="<%= process.env.BASE_URL || 'http://localhost:3000' %>/" />

    <title>Invoice #<%= order.orderNumber %> - Jay Subhdra</title>

    <meta name="description" content="Start your development with a Dashboard for Bootstrap 5" />
    <meta name="keywords" content="dashboard, bootstrap 5 dashboard, bootstrap 5 design, bootstrap 5">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/admin-assets/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Rubik:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="/admin-assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="/admin-assets/vendor/fonts/fontawesome.css" />
    <link rel="stylesheet" href="/admin-assets/vendor/fonts/flag-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="/admin-assets/vendor/css/rtl/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="/admin-assets/vendor/css/rtl/theme-default.css"
        class="template-customizer-theme-css" />
    <link rel="stylesheet" href="/admin-assets/css/demo.css" />

    <!-- Page CSS -->
    <link rel="stylesheet" href="/admin-assets/vendor/css/pages/app-invoice-print.css" />

    <style>
        /* Specific overrides for printing/PDF generation */
        @media print {
            .invoice-print {
                padding: 0 !important;
                margin: 0 !important;
            }

            body {
                background-color: white !important;
            }
        }
    </style>
</head>

<body>

    <div class="invoice-print p-5">

        <div class="d-flex justify-content-between flex-row">
            <div class="mb-4">
                <div class="d-flex svg-illustration mb-3 gap-2">
                    <span class="app-brand-logo demo">
                        <svg width="26px" height="26px" viewBox="0 0 26 26" version="1.1"
                            xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                            <title>icon</title>
                            <defs>
                                <linearGradient x1="50%" y1="0%" x2="50%" y2="100%" id="linearGradient-1">
                                    <stop stop-color="#5A8DEE" offset="0%"></stop>
                                    <stop stop-color="#699AF9" offset="100%"></stop>
                                </linearGradient>
                                <linearGradient x1="0%" y1="0%" x2="100%" y2="100%" id="linearGradient-2">
                                    <stop stop-color="#FDAC41" offset="0%"></stop>
                                    <stop stop-color="#E38100" offset="100%"></stop>
                                </linearGradient>
                            </defs>
                            <g id="Pages" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <g id="Login---V2" transform="translate(-667.000000, -290.000000)">
                                    <g id="Login" transform="translate(519.000000, 244.000000)">
                                        <g id="Logo" transform="translate(148.000000, 42.000000)">
                                            <g id="icon" transform="translate(0.000000, 4.000000)">
                                                <path
                                                    d="M13.8863636,4.72727273 C18.9447899,4.72727273 23.0454545,8.82793741 23.0454545,13.8863636 C23.0454545,18.9447899 18.9447899,23.0454545 13.8863636,23.0454545 C8.82793741,23.0454545 4.72727273,18.9447899 4.72727273,13.8863636 C4.72727273,13.5423509 4.74623858,13.2027679 4.78318172,12.8686032 L8.54810407,12.8689442 C8.48567157,13.19852 8.45300462,13.5386269 8.45300462,13.8863636 C8.45300462,16.887125 10.8856023,19.3197227 13.8863636,19.3197227 C16.887125,19.3197227 19.3197227,16.887125 19.3197227,13.8863636 C19.3197227,10.8856023 16.887125,8.45300462 13.8863636,8.45300462 C13.5386269,8.45300462 13.19852,8.48567157 12.8689442,8.54810407 L12.8686032,4.78318172 C13.2027679,4.74623858 13.5423509,4.72727273 13.8863636,4.72727273 Z"
                                                    id="Combined-Shape" fill="#4880EA"></path>
                                                <path
                                                    d="M13.5909091,1.77272727 C20.4442608,1.77272727 26,7.19618701 26,13.8863636 C26,20.5765403 20.4442608,26 13.5909091,26 C6.73755742,26 1.18181818,20.5765403 1.18181818,13.8863636 C1.18181818,13.540626 1.19665566,13.1982714 1.22574292,12.8598734 L6.30410592,12.859962 C6.25499466,13.1951893 6.22958398,13.5378796 6.22958398,13.8863636 C6.22958398,17.8551125 9.52536149,21.0724191 13.5909091,21.0724191 C17.6564567,21.0724191 20.9522342,17.8551125 20.9522342,13.8863636 C20.9522342,9.91761479 17.6564567,6.70030817 13.5909091,6.70030817 C13.2336969,6.70030817 12.8824272,6.72514561 12.5388136,6.77314791 L12.5392575,1.81561642 C12.8859498,1.78721495 13.2366963,1.77272727 13.5909091,1.77272727 Z"
                                                    id="Combined-Shape2" fill="url(#linearGradient-1)"></path>
                                                <rect id="Rectangle" fill="url(#linearGradient-2)" x="0" y="0"
                                                    width="7.68181818" height="7.68181818"></rect>
                                            </g>
                                        </g>
                                    </g>
                                </g>
                            </g>
                        </svg>
                    </span>
                    <span class="app-brand-text h3 mb-0 fw-bold">Jay Subhdra</span>
                </div>
                <p class="mb-1">123 Temple Road, Divine City</p>
                <p class="mb-1">India, 110001</p>
                <p class="mb-0">+91 98765 43210</p>
            </div>
            <div>
                <h4 class="fw-medium">INVOICE #<%= order.orderNumber %>
                </h4>
                <div class="mb-2">
                    <span class="text-muted">Date Issued:</span>
                    <span class="fw-medium">
                        <%= new Date(order.date).toLocaleDateString() %>
                    </span>
                </div>
                <!--
      <div>
        <span class="text-muted">Date Due:</span>
        <span class="fw-medium">May 25, 2021</span>
      </div>
      -->
            </div>
        </div>

        <hr />

        <div class="row d-flex justify-content-between mb-4">
            <div class="col-sm-6 w-50">
                <h6>Invoice To:</h6>
                <p class="mb-1">
                    <%= order.customer.fullName %>
                </p>
                <% if (order.shippingAddress) { %>
                    <p class="mb-1">
                        <%= order.shippingAddress.addressLine1 %>
                    </p>
                    <p class="mb-1">
                        <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %>
                                <%= order.shippingAddress.zipCode %>
                    </p>
                    <p class="mb-1">
                        <%= order.shippingAddress.country %>
                    </p>
                    <% } %>
                        <p class="mb-1">
                            <%= order.customer.phone || 'N/A' %>
                        </p>
                        <p class="mb-0">
                            <%= order.customer.email %>
                        </p>
            </div>
            <div class="col-sm-6 w-50">
                <h6>Bill To:</h6>
                <table>
                    <tbody>
                        <tr>
                            <td class="pe-3">Total Due:</td>
                            <td class="fw-medium">₹<%= order.totalAmount.toLocaleString() %>
                            </td>
                        </tr>
                        <tr>
                            <td class="pe-3">Payment Method:</td>
                            <td>
                                <%= (order.paymentMethod || 'N/A' ).split('_')[0].toUpperCase() %>
                            </td>
                        </tr>
                        <tr>
                            <td class="pe-3">Bank name:</td>
                            <td>State Bank of India</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table border-top m-0">
                <thead>
                    <tr>
                        <th>Item</th>
                        <!-- <th>Description</th> -->
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(function(item) { %>
                        <tr>
                            <td>
                                <%= item.product ? item.product.product_name : 'Unknown Item' %>
                            </td>
                            <!-- <td>HTML Admin Template</td> -->
                            <td>₹<%= item.price.toFixed(2) %>
                            </td>
                            <td>
                                <%= item.quantity %>
                            </td>
                            <td>₹<%= (item.price * item.quantity).toFixed(2) %>
                            </td>
                        </tr>
                        <% }); %>

                            <tr>
                                <td colspan="2" class="align-top px-4 py-3">
                                    <p class="mb-2">
                                        <span class="me-1 fw-medium">Salesperson:</span>
                                        <span>Jay Jani</span>
                                    </p>
                                    <span>Thanks for your business</span>
                                </td>
                                <td class="text-end px-4 py-3">
                                    <p class="mb-2">Subtotal:</p>
                                    <!-- <p class="mb-2">Discount:</p> -->
                                    <p class="mb-2">Tax:</p>
                                    <p class="mb-2">Shipping:</p>
                                    <p class="mb-0">Total:</p>
                                </td>
                                <td class="px-4 py-3">
                                    <p class="fw-medium mb-2">₹<%= order.subtotal.toFixed(2) %>
                                    </p>
                                    <!-- <p class="fw-medium mb-2">$00.00</p> -->
                                    <p class="fw-medium mb-2">₹0.00</p>
                                    <p class="fw-medium mb-2">₹<%= order.shippingFee.toFixed(2) %>
                                    </p>
                                    <p class="fw-medium mb-0">₹<%= order.totalAmount.toFixed(2) %>
                                    </p>
                                </td>
                            </tr>
                </tbody>
            </table>
        </div>

        <div class="row">
            <div class="col-12">
                <span class="fw-medium">Note:</span>
                <span>It was a pleasure working with you. We hope you will keep us in mind for future projects. Thank
                    You!</span>
            </div>
        </div>
    </div>

    <script src="/admin-assets/js/main.js"></script>

    <!-- Auto Print Script (Only for browser view, not PDF generation) -->
    <script>
        // window.print();
    </script>

</body>

</html>