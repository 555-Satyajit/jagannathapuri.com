<!DOCTYPE html>
<html lang="en" class="light-style layout-wide " dir="ltr" data-theme="theme-default" data-assets-path="/admin-assets/"
    data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <base href="<%= baseUrl || process.env.BASE_URL || 'http://localhost:3000' %>/" />

    <title>Invoice #<%= order.orderNumber %> - Jagannathapuri</title>

    <meta name="description" content="Start your development with a Dashboard for Bootstrap 5" />
    <meta name="keywords" content="dashboard, bootstrap 5 dashboard, bootstrap 5 design, bootstrap 5">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/admin-assets/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Rubik:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="/admin-assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="/admin-assets/vendor/fonts/fontawesome.css" />
    <link rel="stylesheet" href="/admin-assets/vendor/fonts/flag-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="/admin-assets/vendor/css/rtl/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="/admin-assets/vendor/css/rtl/theme-default.css"
        class="template-customizer-theme-css" />
    <link rel="stylesheet" href="/admin-assets/css/demo.css" />

    <!-- Page CSS -->
    <link rel="stylesheet" href="/admin-assets/vendor/css/pages/app-invoice-print.css" />

    <style>
        /* Specific overrides for printing/PDF generation */
        @media print {
            .invoice-print {
                padding: 0 !important;
                margin: 0 !important;
            }

            body {
                background-color: white !important;
            }
        }
    </style>
</head>

<body>

    <div class="invoice-print p-5" style="font-family: 'IBM Plex Sans', sans-serif; max-width: 900px; margin: 0 auto; background: #fff;">

        <!-- Header -->
        <div class="d-flex justify-content-between border-bottom pb-4 mb-4">
            <div>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h1 class="display-6 fw-bold mb-0 text-dark" style="letter-spacing: -1px;">Invoice</h1>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <% if (locals.siteConfig && locals.siteConfig.header && locals.siteConfig.header.logo) { %>
                        <img src="<%= locals.siteConfig.header.logo %>" alt="Logo" style="max-height: 24px; width: auto;">
                    <% } else { %>
                        <img src="/admin-assets/img/logo/jp-icon-logo.png" alt="Jagannathapuri" style="max-height: 24px; width: auto;">
                    <% } %>
                    <p class="text-muted mb-0 fs-6"><%= (locals.siteConfig && locals.siteConfig.contact && locals.siteConfig.contact.brand_description) ? locals.siteConfig.contact.brand_description : 'Jagannathapuri E-commerce' %></p>
                </div>
            </div>
            <div class="border-start ps-4">
                <table class="text-end text-dark fs-6" style="border-spacing: 0 8px; border-collapse: separate;">
                    <tr><td class="pe-4 fw-medium text-muted">Invoice #</td><td class="text-dark"><%= order.orderNumber %></td></tr>
                    <tr><td class="pe-4 fw-medium text-muted">Issue Date</td><td class="text-dark"><%= new Date(order.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td></tr>
                    <tr><td class="pe-4 fw-medium text-muted">Due Date</td><td class="text-dark"><%= new Date(order.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td></tr>
                </table>
            </div>
        </div>

        <!-- Bill To & Total Due -->
        <div class="d-flex justify-content-between mb-5 mt-5">
            <div>
                <h6 class="fw-bold text-dark mb-2">Bill To:</h6>
                <p class="mb-1 text-dark"><%= order.customer.fullName %></p>
                <% if (order.shippingAddress) { %>
                    <p class="mb-1 text-dark"><%= order.shippingAddress.addressLine1 %></p>
                    <p class="mb-1 text-dark"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.zipCode %></p>
                <% } %>
            </div>
            <div class="text-end">
                <h6 class="fw-bold text-dark mb-2">Total Due:</h6>
                <h2 class="display-5 fw-bold text-dark mb-0" style="letter-spacing: -1px;">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></h2>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive mb-4 mt-4">
            <table class="table border text-dark">
                <thead class="border-bottom">
                    <tr>
                        <th class="text-uppercase fw-bold text-muted py-3 px-4" style="font-size: 0.75rem; letter-spacing: 1px;">Charges</th>
                        <th class="text-uppercase fw-bold text-muted py-3 text-center" style="font-size: 0.75rem; letter-spacing: 1px;">Quantity</th>
                        <th class="text-uppercase fw-bold text-muted py-3 px-4 text-end" style="font-size: 0.75rem; letter-spacing: 1px;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(function(item) { %>
                        <tr>
                            <td class="py-4 px-4 border-end">
                                <span class="fw-medium text-dark d-block"><%= item.product ? item.product.product_name : 'Unknown Item' %></span>
                                <% if (item.price) { %>
                                    <span class="text-muted" style="font-size: 0.8rem;">Unit Price: ₹<%= item.price.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
                                <% } %>
                            </td>
                            <td class="py-4 text-center border-end text-dark"><%= item.quantity %></td>
                            <td class="py-4 px-4 text-end text-dark">₹<%= (item.price * item.quantity).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Subtotal block -->
        <div class="d-flex justify-content-end mb-5">
            <div class="border p-4" style="width: 320px;">
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-dark fw-medium">Subtotal</span>
                    <span class="text-dark">₹<%= Number(order.subtotal || order.totalAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-dark fw-medium">Shipping</span>
                    <span class="text-dark">₹<%= Number(order.shippingFee || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
                </div>
                <div class="d-flex justify-content-between mb-4 pb-4 border-bottom">
                    <span class="text-dark fw-medium">Includes 18% Tax</span>
                    <span class="text-dark">₹<%= Number(order.tax || ((order.totalAmount || 0) * 18 / 118)).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="fw-bold text-dark">Total</span>
                    <span class="fw-bold text-dark">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="row pt-5 mt-5 border-top">
            <div class="col-sm-5">
                <h6 class="fw-bold text-dark mb-3">Payments:</h6>
                <p class="mb-1 text-muted">Bank Transfer to:</p>
                <p class="mb-1 text-dark">Jagannathapuri</p>
                <p class="mb-1 text-dark">A/C: 123456789012</p>
                <p class="mb-1 text-dark">IFSC: SBIN0001234</p>
            </div>
            <div class="col-sm-4 border-end">
                <h6 class="fw-bold text-dark mb-3">Contact:</h6>
                <p class="mb-1 text-dark"><%= (locals.siteConfig && locals.siteConfig.contact && locals.siteConfig.contact.address) ? locals.siteConfig.contact.address : 'Jagannathapuri Admin' %></p>
                <p class="mb-1 text-dark"><%= (locals.siteConfig && locals.siteConfig.contact && locals.siteConfig.contact.email) ? locals.siteConfig.contact.email : 'support@jagannathapuri.com' %></p>
                <p class="mb-1 text-dark"><%= (locals.siteConfig && locals.siteConfig.contact && locals.siteConfig.contact.phone) ? locals.siteConfig.contact.phone : '+91 98765 43210' %></p>
            </div>
            <div class="col-sm-3 ps-4">
                <h6 class="fw-bold text-dark mb-3 text-center">Scan to Pay:</h6>
                <div class="text-center">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=upi://pay?pa=jagannathapuri@upi&pn=Jagannathapuri&am=<%= order.totalAmount %>" alt="QR Code" class="img-fluid border p-1" style="width: 100px; height: 100px;">
                </div>
            </div>
        </div>

    </div>

    <script src="/admin-assets/js/main.js"></script>

    <!-- Auto Print Script (Only for browser view, not PDF generation) -->
    <script>
        // window.print();
    </script>

</body>

</html>