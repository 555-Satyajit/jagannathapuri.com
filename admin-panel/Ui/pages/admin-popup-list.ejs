<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Store Configuration /</span> Manage Popups
</h4>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-3">Popups List</h5>
        <div class="d-flex justify-content-between align-items-center row pb-2 gap-3 gap-md-0">
            <div class="col-md-4 user_role"></div>
            <div class="col-md-4 user_plan"></div>
            <div class="col-md-4 user_status"></div>
        </div>
        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAddPopup"
            aria-controls="offcanvasAddPopup">
            <i class="bx bx-plus me-1"></i> Add New Popup
        </button>
    </div>
    <div class="card-datatable table-responsive">
        <table class="table border-top" id="popupTable">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Schedule</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% popups.forEach(popup=> { %>
                    <tr>
                        <td>
                            <img src="/uploads/<%= popup.image %>" alt="Popup" class="rounded" width="50">
                        </td>
                        <td>
                            <small>From: <%= moment(popup.startTime).format('YYYY-MM-DD HH:mm') %></small><br>
                            <small>To: <%= moment(popup.endTime).format('YYYY-MM-DD HH:mm') %></small>
                        </td>
                        <td>
                            <span class="badge bg-label-<%= popup.status === 'Active' ? 'success' : 'secondary' %>">
                                <%= popup.status %>
                            </span>
                        </td>
                        <td>
                            <div class="d-inline-block text-nowrap">
                                <button class="btn btn-sm btn-icon edit-popup" data-id="<%= popup.id %>"
                                    data-image="<%= popup.image %>" data-start="<%= popup.startTime %>"
                                    data-end="<%= popup.endTime %>" data-status="<%= popup.status %>">
                                    <i class="bx bx-edit text-primary"></i>
                                </button>
                                <button class="btn btn-sm btn-icon delete-popup" data-id="<%= popup.id %>">
                                    <i class="bx bx-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Offcanvas to add/edit popup -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddPopup" aria-labelledby="offcanvasAddPopupLabel">
    <div class="offcanvas-header py-4">
        <h5 id="offcanvasAddPopupLabel" class="offcanvas-title">Add Popup</h5>
        <button type="button" class="btn-close bg-label-secondary text-reset" data-bs-dismiss="offcanvas"
            aria-label="Close"></button>
    </div>
    <div class="offcanvas-body border-top">
        <form class="pt-0" id="popupForm" enctype="multipart/form-data">
            <input type="hidden" name="id" id="popupId">
            <input type="hidden" name="existingImage" id="existingImage">

            <div class="mb-3">
                <label class="form-label" for="popupImage">Popup Image</label>
                <input class="form-control" type="file" id="popupImage" name="popupImage">
            </div>

            <div class="mb-3">
                <label class="form-label" for="startTime">Start Date & Time</label>
                <input type="text" id="startTime" name="startTime" class="form-control flatpickr-datetime"
                    placeholder="YYYY-MM-DD HH:mm" required>
            </div>

            <div class="mb-3">
                <label class="form-label" for="endTime">End Date & Time</label>
                <input type="text" id="endTime" name="endTime" class="form-control flatpickr-datetime"
                    placeholder="YYYY-MM-DD HH:mm" required>
            </div>

            <div class="mb-4">
                <label class="form-label" for="status">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary me-sm-3 me-1">Save</button>
                <button type="reset" class="btn bg-label-danger" data-bs-dismiss="offcanvas">Discard</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize Flatpickr
        const flatpickrDate = document.querySelectorAll('.flatpickr-datetime');
        if (flatpickrDate) {
            flatpickrDate.forEach(fp => {
                flatpickr(fp, {
                    enableTime: true,
                    dateFormat: "Y-m-d H:i",
                });
            });
        }

        const popupTable = $('#popupTable').DataTable({
            order: [[1, 'desc']]
        });

        const popupForm = document.getElementById('popupForm');
        popupForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            try {
                const response = await fetch('/admin/store/popup/save', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved!',
                        text: 'Popup has been saved successfully.',
                        customClass: {
                            confirmButton: 'btn btn-success'
                        }
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: result.error || 'Failed to save popup',
                        customClass: {
                            confirmButton: 'btn btn-danger'
                        }
                    });
                }
            } catch (error) {
                console.error('Error saving popup:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'An error occurred while saving.',
                    customClass: {
                        confirmButton: 'btn btn-danger'
                    }
                });
            }
        });

        // Delete Popup
        $(document).on('click', '.delete-popup', async function () {
            const id = $(this).data('id');

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!',
                customClass: {
                    confirmButton: 'btn btn-primary me-1',
                    cancelButton: 'btn btn-label-secondary'
                },
                buttonsStyling: false
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/store/popup/delete/${id}`, {
                            method: 'DELETE'
                        });
                        const result = await response.json();
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: 'Popup has been deleted.',
                                customClass: {
                                    confirmButton: 'btn btn-success'
                                }
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: result.error || 'Failed to delete popup',
                                customClass: {
                                    confirmButton: 'btn btn-danger'
                                }
                            });
                        }
                    } catch (error) {
                        console.error('Error deleting popup:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: 'An error occurred while deleting.',
                            customClass: {
                                confirmButton: 'btn btn-danger'
                            }
                        });
                    }
                }
            });
        });

        // Edit Popup
        $(document).on('click', '.edit-popup', function () {
            const id = $(this).data('id');
            const image = $(this).data('image');
            const start = $(this).data('start');
            const end = $(this).data('end');
            const status = $(this).data('status');

            $('#popupId').val(id);
            $('#existingImage').val(image);
            $('#offcanvasAddPopupLabel').text('Edit Popup');
            $('#status').val(status);

            // Update flatpickr values
            document.querySelector('#startTime')._flatpickr.setDate(new Date(start));
            document.querySelector('#endTime')._flatpickr.setDate(new Date(end));

            const offcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasAddPopup'));
            offcanvas.show();
        });

        // Reset form on offcanvas close
        document.getElementById('offcanvasAddPopup').addEventListener('hidden.bs.offcanvas', function () {
            popupForm.reset();
            $('#popupId').val('');
            $('#existingImage').val('');
            $('#offcanvasAddPopupLabel').text('Add Popup');
        });
    });
</script>