<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Shipping Configuration</h5>
                <small class="text-muted float-end">Configure delivery rates and thresholds</small>
            </div>
            <div class="card-body">
                <form id="shipping-settings-form">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="flat-rate">Flat Rate (₹)</label>
                            <input type="number" id="flat-rate" class="form-control"
                                value="<%= settings.shipping.flat_rate %>" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="free-threshold">Free Shipping Threshold (₹)</label>
                            <input type="number" id="free-threshold" class="form-control"
                                value="<%= settings.shipping.free_shipping_threshold %>" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Enabled Shipping Methods</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="flat_rate" id="method-flat"
                                <%=settings.shipping.enabled_methods.includes('flat_rate') ? 'checked' : '' %>>
                            <label class="form-check-label" for="method-flat"> Flat Rate </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="free_shipping" id="method-free"
                                <%=settings.shipping.enabled_methods.includes('free_shipping') ? 'checked' : '' %>>
                            <label class="form-check-label" for="method-free"> Free Shipping </label>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Payment Configuration</h5>
                <small class="text-muted float-end">Manage payment gateways and methods</small>
            </div>
            <div class="card-body">
                <form id="payment-settings-form">
                    <div class="mb-3">
                        <label class="form-label">Available Methods</label>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="pay-cod" <%=settings.payment.cod_enabled
                                ? 'checked' : '' %>>
                            <label class="form-check-label" for="pay-cod">Cash on Delivery (COD)</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="pay-upi" <%=settings.payment.upi_enabled
                                ? 'checked' : '' %>>
                            <label class="form-check-label" for="pay-upi">UPI (GPay, PhonePe, etc.)</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="pay-card"
                                <%=settings.payment.card_enabled ? 'checked' : '' %>>
                            <label class="form-check-label" for="pay-card">Credit/Debit Card (Razorpay/Stripe)</label>
                        </div>
                    </div>
                    <div class="mb-3 upi-details <%= settings.payment.upi_enabled ? '' : 'd-none' %>">
                        <label class="form-label" for="upi-id">Store UPI ID</label>
                        <input type="text" id="upi-id" class="form-control" value="<%= settings.payment.upi_id %>"
                            placeholder="vpa@bank" />
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="button" id="save-settings-btn" class="btn btn-primary">Save All Changes</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const payUpi = document.getElementById('pay-upi');
        const upiDetails = document.querySelector('.upi-details');

        payUpi.addEventListener('change', function () {
            if (this.checked) {
                upiDetails.classList.remove('d-none');
            } else {
                upiDetails.classList.add('d-none');
            }
        });

        document.getElementById('save-settings-btn').addEventListener('click', function () {
            const enabledMethods = [];
            if (document.getElementById('method-flat').checked) enabledMethods.push('flat_rate');
            if (document.getElementById('method-free').checked) enabledMethods.push('free_shipping');

            const newSettings = {
                shipping: {
                    flat_rate: parseInt(document.getElementById('flat-rate').value),
                    free_shipping_threshold: parseInt(document.getElementById('free-threshold').value),
                    enabled_methods: enabledMethods
                },
                payment: {
                    cod_enabled: document.getElementById('pay-cod').checked,
                    upi_enabled: document.getElementById('pay-upi').checked,
                    card_enabled: document.getElementById('pay-card').checked,
                    upi_id: document.getElementById('upi-id').value
                }
            };

            fetch('/admin/settings/shipping-payment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(newSettings)
            })
                .then(response => {
                    if (response.ok) {
                        alert('Settings saved successfully!');
                    } else {
                        alert('Error saving settings');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while saving.');
                });
        });
    });
</script>