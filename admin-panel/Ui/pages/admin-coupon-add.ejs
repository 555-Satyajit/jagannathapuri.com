<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">eCommerce /</span> Add Coupon
</h4>

<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <h5 class="card-header">Add New Coupon</h5>
            <div class="card-body">
                <form action="/admin/ecommerce/coupons/add" method="POST">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <div class="mb-3">
                        <label for="couponCode" class="form-label">Coupon Code</label>
                        <input type="text" class="form-control" id="couponCode" name="code" placeholder="e.g. SUMMER20"
                            required>
                    </div>
                    <div class="mb-3">
                        <label for="couponType" class="form-label">Type</label>
                        <select class="form-select" id="couponType" name="type" required>
                            <option value="Percentage">Percentage</option>
                            <option value="Fixed Amount">Fixed Amount</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="couponAmount" class="form-label">Amount</label>
                        <input type="number" class="form-control" id="couponAmount" name="amount" placeholder="e.g. 20"
                            required>
                    </div>
                    <div class="mb-3">
                        <label for="couponExpiry" class="form-label">Expiry Date</label>
                        <input type="date" class="form-control" id="couponExpiry" name="expiry" required>
                    </div>
                    <div class="mb-3">
                        <label for="couponUsageLimit" class="form-label">Maximum Usage Limit (Optional)</label>
                        <input type="number" class="form-control" id="couponUsageLimit" name="usage_limit"
                            placeholder="e.g. 100">
                    </div>
                    <div class="mb-3">
                        <label for="couponPerUserLimit" class="form-label">Limit Per User (Optional)</label>
                        <input type="number" class="form-control" id="couponPerUserLimit" name="per_user_limit"
                            placeholder="e.g. 1">
                        <small class="text-muted">Leave empty for unlimited uses per person.</small>
                    </div>
                    <div class="mb-3">
                        <label for="couponStatus" class="form-label">Status</label>
                        <select class="form-select" id="couponStatus" name="status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Coupon</button>
                    <a href="/admin/ecommerce/coupons" class="btn btn-label-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>