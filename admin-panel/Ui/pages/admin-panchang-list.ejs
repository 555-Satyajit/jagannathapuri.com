<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0"><span class="text-muted fw-light">Manage /</span> Panchang</h4>
        <a href="/admin/panchang/add" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add Panchang Entry
        </a>
    </div>

    <!-- Panchang List Table -->
    <div class="card">
        <div class="card-datatable table-responsive">
            <table class="datatables-panchang table border-top">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Sections</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% panchangList.forEach(entry=> { %>
                        <tr>
                            <td><strong>
                                    <%= new Date(entry.date).toLocaleDateString('en-GB', { day: '2-digit' ,
                                        month: 'short' , year: 'numeric' }) %>
                                </strong></td>
                            <td>
                                <% let sectionNames=[]; if(entry.data && entry.data.sections) {
                                    sectionNames=entry.data.sections.map(s=> s.title);
                                    }
                                    %>
                                    <span class="badge bg-label-info">
                                        <%= sectionNames.join(', ') || ' No sections' %>
                                    </span>
                            </td>
                            <td>
                                <%= new Date(entry.created_at).toLocaleDateString() %>
                            </td>
                            <td>
                                <div class="d-inline-block">
                                    <a href="/admin/panchang/edit/<%= entry.id %>"
                                        class="btn btn-sm btn-icon item-edit text-primary"><i
                                            class="bx bxs-edit"></i></a>
                                    <button onclick="deletePanchang(<%= entry.id %>)"
                                        class="btn btn-sm btn-icon text-danger"><i class="bx bxs-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function deletePanchang(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/admin/panchang/delete/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    }
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Deleted!', 'Panchang entry has been deleted.', 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Error!', 'Something went wrong.', 'error');
                        }
                    });
            }
        });
    }

    $(document).ready(function () {
        if ($('.datatables-panchang').length) {
            $('.datatables-panchang').DataTable({
                order: [[0, 'desc']],
                displayLength: 10,
                lengthMenu: [10, 25, 50, 75, 100]
            });
        }
    });
</script>