<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4">
        <span class="text-muted fw-light">Store Configuration / </span> Manage Services
    </h4>

    <form id="adminServiceForm" action="/admin/store/home/service/save" method="POST" enctype="multipart/form-data">
        <div class="row">
            <div class="col-12 col-xl-8">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <%= service ? 'Edit' : 'Add' %> Service
                        </h5>
                    </div>
                    <div class="card-body">
                        <% if (service) { %>
                            <input type="hidden" name="id" value="<%= service.id %>">
                            <input type="hidden" name="existing_image" value="<%= service.image %>">
                            <% } %>

                        <div class="mb-3">
                            <label class="form-label" for="title">Title</label>
                            <input type="text" class="form-control" name="title" id="title" placeholder="Service Title"
                                value="<%= service ? service.title : '' %>" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="slug">Slug</label>
                            <input type="text" class="form-control" name="slug" id="slug" placeholder="service-slug"
                                value="<%= service ? service.slug : '' %>" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="subtitle">Subtitle</label>
                            <input type="text" class="form-control" name="subtitle" id="subtitle"
                                placeholder="Service Subtitle" value="<%= service ? service.subtitle : '' %>" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="description">Description (Short)</label>
                            <textarea class="form-control" name="description" id="description" rows="3"
                                placeholder="Brief description of the service"><%= service ? service.description : '' %></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label" for="phone">Contact Phone (Optional)</label>
                            <input type="text" class="form-control" name="phone" id="phone"
                                placeholder="+91 1234567890" value="<%= service ? service.phone : '' %>" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Publishing</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label" for="status">Status</label>
                            <select class="form-select" name="status" id="status">
                                <option value="Active" <%=service && service.status==='Active' ? 'selected'
                                    : '' %>>Active</option>
                                <option value="Inactive" <%=service && service.status==='Inactive'
                                    ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label" for="rating">Rating</label>
                                <input type="number" step="0.1" max="5" min="0" class="form-control"
                                    name="rating" value="<%= service ? service.rating : '5.0' %>" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="reviewsCount">Reviews</label>
                                <input type="number" class="form-control" name="reviewsCount"
                                    value="<%= service ? service.reviewsCount : '0' %>" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="link">Link</label>
                                <input type="text" class="form-control" name="link"
                                    value="<%= service ? service.link : '/service' %>" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="image">Banner Image</label>
                            <input type="file" class="form-control" name="image" id="image" />
                            <% if (service && service.image) { %>
                                <div class="mt-2 text-center border rounded p-2 bg-light">
                                    <img src="/uploads/<%= service.image %>" alt="Current Banner" class="img-fluid rounded shadow-sm" style="max-height: 120px;">
                                    <p class="mb-0 mt-1 small text-muted">Current Image</p>
                                </div>
                            <% } %>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="icon">Icon Class (Heroicons)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i id="icon-preview" class="hgi <%= service ? service.icon : 'hgi-image-01' %>"></i></span>
                                <input type="text" class="form-control" name="icon" id="icon"
                                    placeholder="hgi-image-01" value="<%= service ? service.icon : 'hgi-image-01' %>" />
                            </div>
                            <small class="text-muted">Example: hgi-message-01, hgi-delivery-01</small>
                        </div>

                        <hr>
                        <button type="submit" id="saveServiceBtn" class="btn btn-primary w-100">
                            <i class="bx bx-save me-1"></i> <%= service ? 'Update' : 'Save' %> Service
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const adminServiceForm = document.getElementById('adminServiceForm');
        const titleInput = document.getElementById('title');
        const slugInput = document.getElementById('slug');
        const iconInput = document.getElementById('icon');
        const iconPreview = document.getElementById('icon-preview');
        const saveServiceBtn = document.getElementById('saveServiceBtn');

        // Auto-generate slug from title
        if (titleInput && slugInput) {
            titleInput.addEventListener('input', function () {
                if (!slugInput.getAttribute('data-edited')) {
                    const slug = this.value.toLowerCase()
                        .trim()
                        .replace(/[^\w\s-]/g, '')
                        .replace(/[\s_-]+/g, '-')
                        .replace(/^-+|-+$/g, '');
                    slugInput.value = slug;
                }
            });

            slugInput.addEventListener('input', function () {
                this.setAttribute('data-edited', 'true');
            });
        }

        if (iconInput && iconPreview) {
            iconInput.addEventListener('input', function () {
                iconPreview.className = 'hgi ' + this.value;
            });
        }

        // AJAX Submission
        if (adminServiceForm) {
            adminServiceForm.addEventListener('submit', function (e) {
                e.preventDefault();
                
                // Show loading state
                const originalBtnText = saveServiceBtn.innerHTML;
                saveServiceBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...';
                saveServiceBtn.disabled = true;

                const formData = new FormData(adminServiceForm);
                const actionUrl = adminServiceForm.getAttribute('action');

                $.ajax({
                    url: actionUrl,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    // Explicitly add CSRF header if needed by csurf (Handled globally by $.ajaxSetup in admin-master.ejs)
                    success: function (res) {
                        if (res.success || (typeof res === 'object' && !res.error)) {
                            // If the response is a redirect or success, move to list
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: 'Service saved successfully',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = '/admin/store/home/service/list';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: res.error || 'Failed to save service'
                            });
                            saveServiceBtn.innerHTML = originalBtnText;
                            saveServiceBtn.disabled = false;
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = 'System Error during submission.';
                        if (xhr.status === 403) {
                            errorMessage = 'CSRF Security Validation Failed. Please refresh the page.';
                        } else if (xhr.responseJSON && xhr.responseJSON.error) {
                            errorMessage = xhr.responseJSON.error;
                        }
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'Submission Failed',
                            text: errorMessage
                        });
                        
                        saveServiceBtn.innerHTML = originalBtnText;
                        saveServiceBtn.disabled = false;
                        console.error('Submission Error:', xhr);
                    }
                });
            });
        }
    });
</script>