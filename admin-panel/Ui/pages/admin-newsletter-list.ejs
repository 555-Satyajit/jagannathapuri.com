<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Store Configuration /</span> Newsletter Subscribers
</h4>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-3">Subscribers List</h5>
    </div>
    <div class="card-datatable table-responsive">
        <table class="table border-top" id="newsletterTable">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Subscribed At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% subscribers.forEach(sub=> { %>
                    <tr>
                        <td>
                            <span class="fw-semibold">
                                <%= sub.email %>
                            </span>
                        </td>
                        <td>
                            <span
                                class="badge bg-label-<%= sub.status === 'Subscribed' || sub.status === 'Active' ? 'success' : 'secondary' %>">
                                <%= sub.status %>
                            </span>
                        </td>
                        <td>
                            <%= moment(sub.createdAt).format('YYYY-MM-DD HH:mm') %>
                        </td>
                        <td>
                            <div class="d-inline-block text-nowrap">
                                <button class="btn btn-sm btn-icon delete-subscriber" data-id="<%= sub.id %>">
                                    <i class="bx bx-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const newsletterTable = $('#newsletterTable').DataTable({
            order: [[2, 'desc']]
        });

        // Delete Subscriber
        $(document).on('click', '.delete-subscriber', async function () {
            const id = $(this).data('id');

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!',
                customClass: {
                    confirmButton: 'btn btn-primary me-1',
                    cancelButton: 'btn btn-label-secondary'
                },
                buttonsStyling: false
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/newsletter/delete/${id}`, {
                            method: 'DELETE',
                            headers: {
                                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                            }
                        });
                        const result = await response.json();
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: 'Subscriber has been removed.',
                                customClass: {
                                    confirmButton: 'btn btn-success'
                                }
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: result.error || 'Failed to delete subscriber',
                                customClass: {
                                    confirmButton: 'btn btn-danger'
                                }
                            });
                        }
                    } catch (error) {
                        console.error('Error deleting subscriber:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: 'An error occurred while deleting.',
                            customClass: {
                                confirmButton: 'btn btn-danger'
                            }
                        });
                    }
                }
            });
        });
    });
</script>