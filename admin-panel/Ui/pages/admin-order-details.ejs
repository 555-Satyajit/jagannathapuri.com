<% const paymentStatuses={ 1: { title: "Paid" , class: "bg-label-success" }, 2: { title: "Pending" ,
    class: "bg-label-warning" }, 3: { title: "Failed" , class: "bg-label-danger" }, 4: { title: "Cancelled" ,
    class: "bg-label-secondary" } }; const orderStatuses={ 0: { title: "Cancelled" , class: "bg-label-danger" }, 1: {
    title: "Pending" , class: "bg-label-warning" }, 2: { title: "Processing" , class: "bg-label-info" }, 3: {
    title: "Shipped" , class: "bg-label-primary" }, 4: { title: "Delivered" , class: "bg-label-success" } }; %>

    <h4 class="py-3 breadcrumb-wrapper mb-4">
        <span class="text-muted fw-light">eCommerce /</span> Order Details
    </h4>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3">
        <div class="d-flex flex-column justify-content-center">
            <h5 class="mb-1 mt-3">Order #<%= order.orderNumber %>
                    <span class="badge <%= paymentStatuses[order.paymentStatus].class %> me-2 ms-2">
                        <%= paymentStatuses[order.paymentStatus].title %>
                    </span>
                    <span class="badge <%= orderStatuses[order.status].class %>">
                        <%= orderStatuses[order.status].title %>
                    </span>
            </h5>
            <p class="text-muted">
                <%= order.date.toLocaleString() %>
            </p>
        </div>
        <div class="d-flex align-content-center flex-wrap gap-2">
            <div class="dropdown">
                <button class="btn btn-label-primary dropdown-toggle" type="button" id="statusUpdateDropdown"
                    data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Update Status
                </button>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="statusUpdateDropdown">
                    <h6 class="dropdown-header">Order Status</h6>
                    <% Object.entries(orderStatuses).forEach(([val, info])=> { %>
                        <a class="dropdown-item update-order-status" href="javascript:void(0)" data-type="status"
                            data-value="<%= val %>">
                            <%= info.title %>
                        </a>
                        <% }) %>
                            <div class="dropdown-divider"></div>
                            <h6 class="dropdown-header">Payment Status</h6>
                            <% Object.entries(paymentStatuses).forEach(([val, info])=> { %>
                                <a class="dropdown-item update-order-status" href="javascript:void(0)"
                                    data-type="paymentStatus" data-value="<%= val %>">
                                    <%= info.title %>
                                </a>
                                <% }) %>
                </div>
            </div>
            <button class="btn btn-label-danger delete-order" data-id="<%= order.id %>">Delete Order</button>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title m-0">Order details</h5>
                </div>
                <div class="card-datatable table-responsive">
                    <table class="datatables-order-details table border-top">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (order.items && order.items.length> 0) { %>
                                <% order.items.forEach(item=> { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex justify-content-start align-items-center text-nowrap">
                                                <div class="avatar-wrapper">
                                                    <div class="avatar me-2">
                                                        <% let image='/admin-assets/img/products/1.png' ; if
                                                            (item.product.images && item.product.images.length> 0) {
                                                            const img = item.product.images[0].trim();
                                                            image = (img.startsWith('http') || img.startsWith('/')) ?
                                                            img : '/uploads/' + img;
                                                            }
                                                            %>
                                                            <img src="<%= image %>" alt="product" class="rounded-2">
                                                    </div>
                                                </div>
                                                <div class="d-flex flex-column">
                                                    <h6 class="text-body mb-0">
                                                        <%= item.product.product_name %>
                                                    </h6>
                                                    <small class="text-muted">SKU: <%= item.product.sku %></small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>₹<%= item.price.toFixed(2) %>
                                        </td>
                                        <td>
                                            <%= item.quantity %>
                                        </td>
                                        <td>₹<%= (item.price * item.quantity).toFixed(2) %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center">No items found in this order</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-end align-items-center m-3 mb-2 p-1">
                        <div class="order-calculations">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="w-px-100 text-heading">Subtotal:</span>
                                <h6 class="mb-0">₹<%= order.subtotal.toFixed(2) %>
                                </h6>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="w-px-100 text-heading">Tax:</span>
                                <h6 class="mb-0">₹<%= order.tax.toFixed(2) %>
                                </h6>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="w-px-100 text-heading">Shipping:</span>
                                <h6 class="mb-0">₹<%= order.shippingFee.toFixed(2) %>
                                </h6>
                            </div>
                            <div class="d-flex justify-content-between">
                                <h6 class="w-px-100 mb-0 fw-bold">Total:</h6>
                                <h6 class="mb-0 fw-bold">₹<%= order.totalAmount.toFixed(2) %>
                                </h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title m-0">Shipping activity</h5>
                </div>
                <div class="card-body">
                    <ul class="timeline pb-0 mb-0">
                        <li class="timeline-item timeline-item-transparent border-primary">
                            <span class="timeline-point timeline-point-primary"></span>
                            <div class="timeline-event">
                                <div class="timeline-header">
                                    <h6 class="mb-0">Order was placed (Order ID: #<%= order.orderNumber %>)</h6>
                                    <span class="text-muted">
                                        <%= order.date.toLocaleDateString() %>
                                    </span>
                                </div>
                                <p class="mt-2">Your order has been placed successfully</p>
                            </div>
                        </li>
                        <li class="timeline-item timeline-item-transparent border-transparent">
                            <span class="timeline-point timeline-point-primary"></span>
                            <div class="timeline-event">
                                <div class="timeline-header">
                                    <h6 class="mb-0">Current Status: <%= orderStatuses[order.status].title %>
                                    </h6>
                                </div>
                                <p class="mt-2">Last updated: <%= order.updated_at.toLocaleString() %>
                                </p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="card-title m-0">Customer details</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-start align-items-center mb-4">
                        <div class="avatar me-2">
                            <img src="/admin-assets/img/avatars/<%= order.customer.avatar || '1.png' %>" alt="Avatar"
                                class="rounded-circle">
                        </div>
                        <div class="d-flex flex-column">
                            <a href="/admin/ecommerce/customers/details/<%= order.customer.id %>"
                                class="text-body text-nowrap">
                                <h6 class="mb-0">
                                    <%= order.customer.fullName %>
                                </h6>
                            </a>
                            <small class="text-muted">Customer ID: #<%= order.customer.id %></small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-start align-items-center mb-4">
                        <span
                            class="avatar rounded-circle bg-label-success me-2 d-flex align-items-center justify-content-center"><i
                                class="bx bx-cart-alt bx-sm lh-sm"></i></span>
                        <h6 class="text-body text-nowrap mb-0">
                            <%= order.customer.orderCount %> Orders
                        </h6>
                    </div>
                    <div class="d-flex justify-content-between">
                        <h6>Contact info</h6>
                    </div>
                    <p class="mb-1">Email: <%= order.customer.email %>
                    </p>
                    <p class="mb-0">Mobile: <%= order.customer.phone || 'N/A' %>
                    </p>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between">
                    <h6 class="card-title m-0">Shipping address</h6>
                </div>
                <div class="card-body">
                    <% // Try to find the specific address linked to the order via shippingAddressId let
                        shippingAddr=order.customer.addresses.find(a=> a.id === order.shippingAddressId);
                        // Fallback to any shipping type or default
                        if (!shippingAddr) {
                        shippingAddr = order.customer.addresses.find(a => a.type === 'Shipping' || a.isDefault);
                        }
                        %>
                        <% if (shippingAddr) { %>
                            <p class="mb-0">
                                <%= shippingAddr.addressLine1 %><br>
                                    <%= shippingAddr.addressLine2 ? shippingAddr.addressLine2 + '<br>' : '' %>
                                        <%= shippingAddr.city %>, <%= shippingAddr.state %>
                                                <%= shippingAddr.zipCode %><br>
                                                    <%= shippingAddr.country %>
                            </p>
                            <% } else { %>
                                <p class="mb-0 text-muted">No shipping address found</p>
                                <% } %>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between">
                    <h6 class="card-title m-0">Billing address</h6>
                </div>
                <div class="card-body">
                    <% const billingAddr=order.customer.addresses.find(a=> a.type === 'Billing') ||
                        order.customer.addresses.find(a => a.isDefault) %>
                        <% if (billingAddr) { %>
                            <p class="mb-0">
                                <%= billingAddr.addressLine1 %><br>
                                    <%= billingAddr.addressLine2 ? billingAddr.addressLine2 + '<br>' : '' %>
                                        <%= billingAddr.city %>, <%= billingAddr.state %>
                                                <%= billingAddr.zipCode %><br>
                                                    <%= billingAddr.country %>
                            </p>
                            <% } else { %>
                                <p class="mb-0 text-muted">No billing address found</p>
                                <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const orderId = '<%= order.id %>';

            // Update Status Logic
            document.querySelectorAll('.update-order-status').forEach(btn => {
                btn.addEventListener('click', function () {
                    const type = this.getAttribute('data-type');
                    const value = this.getAttribute('data-value');
                    const data = {};
                    data[type] = value;

                    fetch('/admin/ecommerce/orders/update-status/' + orderId, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Updated!',
                                    text: 'Order status has been updated.',
                                    customClass: { confirmButton: 'btn btn-success' }
                                }).then(() => { location.reload(); });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: data.error || 'Failed to update order status.',
                                    customClass: { confirmButton: 'btn btn-success' }
                                });
                            }
                        })
                        .catch(err => {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'An error occurred while updating status.',
                                customClass: { confirmButton: 'btn btn-success' }
                            });
                        });
                });
            });

            // Delete Order Logic
            document.querySelector('.delete-order').addEventListener('click', function () {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it!',
                    customClass: { confirmButton: 'btn btn-primary me-3', cancelButton: 'btn btn-label-secondary' },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.value) {
                        fetch('/admin/ecommerce/orders/delete/' + orderId, { method: 'DELETE' })
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Deleted!',
                                        text: 'Order has been removed.',
                                        customClass: { confirmButton: 'btn btn-success' }
                                    }).then(() => { window.location.href = '/admin/ecommerce/orders'; });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error!',
                                        text: data.error || 'Failed to delete order.',
                                        customClass: { confirmButton: 'btn btn-success' }
                                    });
                                }
                            });
                    }
                });
            });
        });
    </script>