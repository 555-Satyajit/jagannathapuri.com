<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4">
        <span class="text-muted fw-light">Manage Library / </span> Content
    </h4>

    <script id="categories-data" type="application/json">
        <%- JSON.stringify(categories || []) %>
    </script>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-hover library-content-list-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th></th>
                            <th>Banner</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Tags</th>
                            <th>Author</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Content List Scripts are in app-library-content-list.js -->