<style>
    .wrap-denied {
        width: 100%;
        min-height: calc(100vh - 180px); /* Fill screen minus header/footer */
        display: flex;
        flex-direction: column;
        justify-content: center; /* Center vertically */
        align-items: center;
        text-align: center;
        padding: 0;
    }

    .error-image-denied {
        width: min(500px, 92vw); /* Restored original size */
        height: auto;
        display: block;
        margin-bottom: 5px; /* Added small gap */
    }

    .title-denied {
        margin: 10px 0 0; /* Added top gap */
        color: #ff3e1d;
        font-family: "Pacifico", cursive;
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        line-height: 1.1;
    }

    .subtitle-denied {
        margin: 5px 0 30px; /* Increased bottom gap */
        color: #8592a3;
        font-size: clamp(0.9rem, 1.5vw, 1.1rem);
        font-weight: 700;
        max-width: 500px;
    }

    .home-btn-denied {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 30px;
        border: 2px solid #545454;
        border-radius: 999px;
        text-decoration: none;
        color: #2f2f2f;
        font-weight: 700;
        background: #f7f7f7;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .home-btn-denied:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.14);
    }

