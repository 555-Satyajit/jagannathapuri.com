<div class="container">
    <main class="wrap-denied">
        <img class="error-image-denied" src="/admin-assets/404/403.png" alt="Access Denied illustration" />
        <h1 class="title-denied">why are you here?</h1>
        <p class="subtitle-denied">You Don't Have Permission</p>

        <a class="home-btn-denied" href="/admin">
            <i class="bx bx-home-alt"></i>
            Back to Dashboard
        </a>
    </main>
