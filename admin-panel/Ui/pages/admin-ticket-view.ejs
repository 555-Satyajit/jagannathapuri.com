<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Ticket #<%= ticket.ticket_id %>: <%= ticket.subject %>
                </h5>
                <span
                    class="badge bg-label-<%= ticket.status === 'Open' ? 'danger' : (ticket.status === 'In Progress' ? 'warning' : 'success') %>">
                    <%= ticket.status %>
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <h6 class="mb-2">Description</h6>
                        <p>
                            <%= ticket.description %>
                        </p>
                        <hr>
                        <h6 class="mb-3">Conversation</h6>
                        <div class="chat-wrapper mb-4" style="max-height: 500px; overflow-y: auto;">
                            <% ticket.messages.forEach(message=> { %>
                                <% const isStaff=message.authorStaff_id !==null; %>
                                    <div class="d-flex mb-3 <%= isStaff ? 'justify-content-end' : '' %>">
                                        <div class="message-content p-3 shadow-sm rounded <%= isStaff ? 'bg-primary text-white border-0' : 'bg-label-secondary' %>"
                                            style="max-width: 80%;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold small">
                                                    <%= isStaff ? message.authorStaff.full_name :
                                                        message.authorCustomer.fullName %>
                                                </span>
                                                <small class="<%= isStaff ? 'text-white-50' : 'text-muted' %> ms-2">
                                                    <%= new Date(message.created_at).toLocaleString('en-IN', {
                                                        day: '2-digit' , month: 'short' , hour: '2-digit' ,
                                                        minute: '2-digit' }) %>
                                                </small>
                                            </div>
                                            <p class="mb-1">
                                                <%= message.content %>
                                            </p>

                                            <% if (message.attachments && message.attachments.length> 0) { %>
                                                <div
                                                    class="attachments-list mt-2 pt-2 border-top <%= isStaff ? 'border-white-50' : '' %>">
                                                    <small class="d-block mb-1 fw-bold">Attachments:</small>
                                                    <% message.attachments.forEach(file=> { %>
                                                        <a href="<%= file.file_path %>" target="_blank"
                                                            class="d-block small <%= isStaff ? 'text-white' : '' %> text-decoration-underline mb-1">
                                                            <i
                                                                class="bx <%= file.file_type.includes('image') ? 'bx-image' : 'bx-file' %> me-1"></i>
                                                            <%= file.file_name %>
                                                        </a>
                                                        <% }) %>
                                                </div>
                                                <% } %>
                                        </div>
                                    </div>
                                    <% }) %>
                        </div>
                    </div>
                    <div class="col-md-4 border-start">
                        <h6 class="mb-3">Customer Details</h6>
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar me-3">
                                <span class="avatar-initial rounded-circle bg-label-primary">
                                    <%= ticket.customer.fullName.charAt(0) %>
                                </span>
                            </div>
                            <div>
                                <h6 class="mb-0">
                                    <%= ticket.customer.fullName %>
                                </h6>
                                <small class="text-muted">
                                    <%= ticket.customer.email %>
                                </small>
                            </div>
                        </div>
                        <div class="mb-3">
                            <span class="fw-medium d-block mb-1">Priority:</span>
                            <span
                                class="badge bg-label-<%= ticket.priority === 'High' ? 'danger' : (ticket.priority === 'Medium' ? 'warning' : 'info') %>">
                                <%= ticket.priority %>
                            </span>
                        </div>
                        <div class="mb-3">
                            <span class="fw-medium d-block mb-1">Assignee:</span>
                            <span>
                                <%= ticket.assignee ? ticket.assignee.full_name : 'Unassigned' %>
                            </span>
                        </div>
                        <hr>
                        <div class="d-grid gap-2">
                            <form action="/admin/tickets/action" method="POST">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                                <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                                <input type="hidden" name="action" value="close">
                                <button type="submit" class="btn btn-label-danger w-100 mb-2">Close Ticket</button>
                            </form>
                            <button type="button" class="btn btn-label-secondary w-100" data-bs-toggle="modal"
                                data-bs-target="#assignTicket">Assign Ticket</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Assign Ticket Modal -->
<div class="modal fade" id="assignTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-simple modal-assign-ticket">
        <div class="modal-content p-3 p-md-5">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="text-center mb-4">
                    <h3>Assign Ticket</h3>
                    <p>Select a staff member to assign this ticket.</p>
                </div>
                <form id="assignTicketForm" class="row g-3" action="/admin/tickets/action" method="POST">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                    <input type="hidden" name="action" value="assign">
                    <div class="col-12">
                        <label class="form-label" for="assignStaff">Staff Member</label>
                        <select id="assignStaff" name="staff_id" class="select2 form-select"
                            data-placeholder="Select Staff">
                            <option value="">Select Staff</option>
                            <% staffList.forEach(staff=> { %>
                                <option value="<%= staff.id %>" <%=ticket.assignee_id===staff.id ? 'selected' : '' %>>
                                    <%= staff.full_name %> (<%= staff.role ? staff.role.name : 'No Role' %>)
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-12 text-center mt-4">
                        <button type="submit" class="btn btn-primary me-sm-3 me-1">Assign</button>
                        <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="modal"
                            aria-label="Close">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Reply Card -->
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Post a Reply</h5>
            </div>
            <div class="card-body">
                <form action="/admin/tickets/action" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                    <input type="hidden" name="action" value="reply">
                    <div class="mb-3">
                        <textarea class="form-control" name="reply_content" rows="4"
                            placeholder="Type your reply here..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Attachments</label>
                        <input type="file" class="form-control" name="attachments" multiple />
                    </div>
                    <button type="submit" class="btn btn-primary">Send Reply</button>
                </form>
            </div>
        </div>
    </div>
</div>