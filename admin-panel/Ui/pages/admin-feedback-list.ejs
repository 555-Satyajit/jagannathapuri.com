<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Store Configuration / Manage Contact / </span>
        Messages</h4>

    <!-- Contact Messages List Table -->
    <div class="card">
        <div class="card-datatable table-responsive">
            <table class="datatables-messages table border-top">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Message</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(messages && messages.length> 0) { %>
                        <% messages.forEach(message=> { %>
                            <tr>
                                <td data-order="<%= message.created_at.getTime() %>">
                                    <%= moment(message.created_at).format('DD MMM YYYY HH:mm') %>
                                </td>
                                <td>
                                    <%= message.name %>
                                </td>
                                <td>
                                    <%= message.email %>
                                </td>
                                <td>
                                    <%= message.message %>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow"
                                            data-bs-toggle="dropdown">
                                            <i class="bx bx-dots-vertical-rounded"></i>
                                        </button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item text-danger delete-message"
                                                href="javascript:void(0);" data-id="<%= message.id %>">
                                                <i class="bx bx-trash me-1"></i> Delete
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center">No messages found.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize DataTable
        const dt_messages = $('.datatables-messages');
        if (dt_messages.length) {
            dt_messages.DataTable({
                order: [[0, "desc"]],
                dom: '<"card-header d-flex flex-wrap pb-2"<f><"d-flex justify-content-center justify-content-md-end align-items-baseline"<"dt-action-buttons d-flex justify-content-center flex-md-row mb-3 mb-md-0 ps-1 ms-1 align-items-baseline"lB>>>t<"row mx-2"<"col-sm-12 col-md-6"i><"col-sm-12 col-md-6"p>>',
                buttons: [],
                language: {
                    sLengthMenu: '_MENU_',
                    search: '',
                    searchPlaceholder: 'Search Message'
                }
            });
        }

        // Delete Message Logic
        $('.delete-message').on('click', function () {
            const messageId = $(this).data('id');

            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!',
                customClass: {
                    confirmButton: 'btn btn-primary me-2',
                    cancelButton: 'btn btn-label-secondary'
                },
                buttonsStyling: false
            }).then(function (result) {
                if (result.value) {
                    $.ajax({
                        url: '/admin/store/contact/messages/delete/' + messageId,
                        type: 'DELETE',
                        success: function (result) {
                            if (result.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Message has been deleted.',
                                    customClass: {
                                        confirmButton: 'btn btn-success'
                                    }
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: result.error || 'Failed to delete message'
                                });
                            }
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Internal Server Error'
                            });
                        }
                    });
                }
            });
        });
    });
</script>