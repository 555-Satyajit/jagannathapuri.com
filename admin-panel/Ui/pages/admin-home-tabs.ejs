<h4 class="py-3 breadcrumb-wrapper mb-4">
    <span class="text-muted fw-light">Store Configuration / Manage Home /</span> Home Tabs
</h4>

<div class="app-ecommerce-category">
    <!-- Home Tab List Table -->
    <div class="card">
        <div class="card-header flex-column flex-md-row">
            <div class="head-label text-center">
                <h5 class="card-title mb-0">Home Tabs Configuration</h5>
            </div>
            <div class="dt-action-buttons text-end pt-3 pt-md-0">
                <div class="dt-buttons btn-group flex-wrap">
                    <button class="btn btn-secondary add-new btn-primary" tabindex="0"
                        aria-controls="DataTables_Table_0" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#offcanvasHomeTab">
                        <span><i class="bx bx-plus me-0 me-sm-1"></i><span class="d-none d-sm-inline-block">Add New
                                Tab</span></span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-datatable table-responsive">
            <table class="datatables-home-tab-list table border-top">
                <thead>
                    <tr>
                        <th></th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th class="text-lg-center">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <!-- Offcanvas to add/edit home tab -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasHomeTab" aria-labelledby="offcanvasHomeTabLabel">
        <!-- Offcanvas Header -->
        <div class="offcanvas-header py-4">
            <h5 id="offcanvasHomeTabLabel" class="offcanvas-title">Add Home Tab</h5>
            <button type="button" class="btn-close bg-label-secondary text-reset" data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
        </div>
        <!-- Offcanvas Body -->
        <div class="offcanvas-body border-top">
            <form class="pt-0" id="homeTabForm">
                <input type="hidden" name="id" id="home-tab-id">
                <!-- Title -->
                <div class="mb-3">
                    <label class="form-label" for="home-tab-title">Tab Title</label>
                    <input type="text" class="form-control" id="home-tab-title" placeholder="e.g. Mouth-Watering Sweets"
                        name="title" aria-label="tab title">
                </div>
                <!-- Category -->
                <div class="mb-3 ecommerce-select2-dropdown">
                    <label class="form-label" for="home-tab-category">Associated Category</label>
                    <select id="home-tab-category" name="categoryId" class="select2 form-select"
                        data-placeholder="Select category">
                        <option value="">Select Category</option>
                        <% categories.forEach(function(cat) { %>
                            <option value="<%= cat.id %>">
                                <%= cat.name %>
                            </option>
                            <% }); %>
                    </select>
                </div>
                <!-- Order -->
                <div class="mb-3">
                    <label class="form-label" for="home-tab-order">Display Order</label>
                    <input type="number" id="home-tab-order" class="form-control" placeholder="0" aria-label="order"
                        name="order" value="0">
                </div>
                <!-- Status -->
                <div class="mb-4 ecommerce-select2-dropdown">
                    <label class="form-label">Status</label>
                    <select id="home-tab-status" name="status" class="select2 form-select"
                        data-placeholder="Select status">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <!-- Submit and reset -->
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary me-sm-3 me-1 data-submit">Save</button>
                    <button type="reset" class="btn bg-label-danger" data-bs-dismiss="offcanvas">Discard</button>
                </div>
            </form>
        </div>
    </div>
</div>