<!-- ========== Tailwind CSS ========== -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        corePlugins: {
            preflight: false,
        },
        theme: {
            extend: {
                colors: {
                    primary: '#6200EA',
                    secondary: '#3366ff',
                    'primary-lighter': '#EDE7F6',
                    'primary-light': '#B388FF',
                    'primary-dark': '#3700B3',
                },
                fontFamily: {
                    'urbanist': ['Urbanist', 'sans-serif'],
                    'dm-sans': ['DM Sans', 'sans-serif'],
                }
            }
        }
    }
</script>

<!-- Font Awesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    /* Use site's native variables */
    :root {
        --color-ritual-bg: #f6f2ff;
        --color-ritual-accent: var(--color-primary);
        --color-ritual-accent-light: var(--color-primary-light);
        --color-ritual-accent-lighter: var(--color-primary-lighter);
        --color-ritual-accent-dark: var(--color-primary-dark);
        --color-ritual-ink: var(--color-gray-900);
        --font-urbanist: "Urbanist", sans-serif;
        --font-dm-sans: "DM Sans", sans-serif;
    }

    .font-urbanist {
        font-family: var(--font-urbanist);
    }

    .font-dm-sans {
        font-family: var(--font-dm-sans);
    }

    .ritual-shell {
        background:
            radial-gradient(1200px 480px at 50% -10%, rgba(98, 0, 234, 0.14), transparent 60%),
            linear-gradient(180deg, var(--color-ritual-bg) 0%, #ffffff 48%);
    }

    .ritual-hero {
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .ritual-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .ritual-card:hover {
        transform: translateY(-5px) !important;
        box-shadow: 0 14px 30px -14px rgba(55, 0, 179, 0.35), 0 10px 20px -12px rgba(33, 43, 54, 0.18) !important;
    }

    /* Force centering for icons in circular containers */
    .icon-circle {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .icon-circle i {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        margin: 0 !important;
        line-height: normal !important;
    }

    .bg-ritual-amber-50 {
        background-color: var(--color-ritual-bg);
    }

    .bg-ritual-amber-100 {
        background-color: var(--color-ritual-accent-lighter);
    }

    .bg-ritual-amber-400 {
        background-color: var(--color-ritual-accent);
    }

    .border-ritual-amber-100 {
        border-color: var(--color-ritual-accent-lighter);
    }

    .border-ritual-amber-200 {
        border-color: var(--color-ritual-accent-light);
    }

    .border-ritual-amber-300 {
        border-color: var(--color-ritual-accent);
    }

    .text-ritual-amber-700 {
        color: var(--color-ritual-accent-dark);
    }

    .text-ritual-amber-950 {
        color: var(--color-ritual-ink);
    }

    .ritual-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .ritual-status-live {
        background: rgba(203, 2, 51, 0.1);
        color: #cb0233;
    }

    .ritual-status-upcoming {
        background: rgba(98, 0, 234, 0.1);
        color: var(--color-ritual-accent-dark);
    }

    .ritual-status-complete {
        background: rgba(34, 154, 22, 0.12);
        color: #229a16;
    }

    .ritual-scroll {
        height: 420px;
        overflow-y: auto;
        overflow-x: hidden;
        scroll-behavior: auto;
        border-radius: 18px;
        border: 1px solid var(--color-ritual-accent-lighter);
        background: #fffaf0;
        scrollbar-width: none;
    }

    .ritual-scroll::-webkit-scrollbar {
        display: none;
    }

    .ritual-scroll-track {
        display: flex;
        flex-direction: column;
    }

    .ritual-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255, 196, 64, 0.25);
        flex-shrink: 0;
    }

    .ritual-row:last-child {
        border-bottom: none;
    }

    .ritual-name {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 14px;
        text-transform: uppercase;
        color: #1f1f1f;
    }

    .ritual-time {
        font-weight: 800;
        color: #d90000;
        font-size: 14px;
        white-space: nowrap;
    }

    .ritual-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 193, 7, 0.2);
        color: #d08a00;
        flex-shrink: 0;
        font-size: 13px;
    }
</style>

<!-- Brand Aligned Ritual Timeline -->
<section class="py-0 ritual-shell relative min-h-screen">

    <div class="container py-12">
        <div class="ritual-hero rounded-3xl p-6 md:p-8 text-center mb-12 shadow-sm">
            <div class="text-xs font-semibold tracking-widest text-gray-500 mb-3 font-urbanist">
                Date: <span id="current-day">--</span> <span id="current-month">--</span>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 font-urbanist">
                Daily Rituals Timeline
            </h2>
            <p class="text-sm md:text-base text-gray-600 font-dm-sans max-w-2xl mx-auto">
                A simple, time-ordered view of today's rituals.
            </p>
        </div>

        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
                <!-- Niti Timeline - Left side (2/3 width) -->
                <div class="md:col-span-2">
                    <div id="ritual-scroll" class="ritual-scroll shadow-sm">
                        <div class="ritual-scroll-track" id="ritual-track">
                            <% if (rituals && rituals.length> 0) { %>
                                <!-- First set -->
                                <% rituals.forEach(ritual=> { %>
                                    <div class="ritual-row">
                                        <div class="ritual-name">
                                            <span class="ritual-icon"><i class="<%= ritual.icon %>"></i></span>
                                            <%= ritual.name %>
                                        </div>
                                        <div class="ritual-time">
                                            <%= ritual.time %>
                                        </div>
                                    </div>
                                    <% }); %>

                                        <% if (rituals.length> 4) { %>
                                            <!-- Duplicate set for seamless infinite loop (only if enough items) -->
                                            <% rituals.forEach(ritual=> { %>
                                                <div class="ritual-row">
                                                    <div class="ritual-name">
                                                        <span class="ritual-icon"><i
                                                                class="<%= ritual.icon %>"></i></span>
                                                        <%= ritual.name %>
                                                    </div>
                                                    <div class="ritual-time">
                                                        <%= ritual.time %>
                                                    </div>
                                                </div>
                                                <% }); %>
                                                    <% } %>
                                                        <% } else { %>
                                                            <div class="p-8 text-center text-gray-400">No rituals
                                                                scheduled for today.</div>
                                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Darshan Timings - Right side (1/3 width) -->
                <div class="md:col-span-1">
                    <div class="bg-white rounded-2xl p-6 shadow-lg border border-gray-100 sticky top-4">
                        <h3 class="text-xl font-bold text-gray-900 mb-4 font-urbanist flex items-center gap-2">
                            <span class="text-primary"><i class="fas fa-clock"></i></span> Darshan Timings
                        </h3>
                        <div class="space-y-3">
                            <% if (darshans && darshans.length> 0) { %>
                                <% darshans.forEach(darshan=> { %>
                                    <% let bgClass="bg-gray-50 hover:bg-gray-100" ; let textClass="text-gray-700" ; let
                                        badgeClass="bg-primary/10 text-primary" ; if (darshan.type==='Pahuda' ) {
                                        bgClass="bg-red-50 border border-red-100" ; textClass="text-red-700" ;
                                        badgeClass="bg-white text-red-600 border border-red-100" ; } else if
                                        (darshan.type==='Special' ) { bgClass="bg-green-50 border border-green-100" ;
                                        textClass="text-green-700" ;
                                        badgeClass="bg-white text-green-600 border border-green-100" ; } %>
                                        <div class="<%= bgClass %> p-3 rounded-xl transition-colors">
                                            <div class="font-bold <%= textClass %> text-sm mb-1">
                                                <%= darshan.name %>
                                            </div>
                                            <span class="px-2 py-1 <%= badgeClass %> rounded-full text-xs font-bold">
                                                <%= darshan.timeRange %>
                                            </span>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <div class="text-sm text-gray-500 italic">No specific timings available.
                                                </div>
                                                <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Brand Aligned Temple Facts -->
<section class="py-16 bg-white border-t border-gray-100 mb-10">
    <div class="container">
        <div class="max-w-4xl mx-auto">

            <!-- Temple Facts -->
            <div>
                <h3 class="text-2xl font-bold text-gray-900 mb-6 font-urbanist text-center">Did You Know?</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <% if (facts && facts.length> 0) { %>
                        <% facts.forEach(fact=> { %>
                            <div
                                class="bg-white p-5 rounded-2xl border border-gray-100 border-l-4 border-l-<%= fact.colorClass %> shadow-sm hover:shadow-md transition-all">
                                <h4 class="font-bold text-gray-800 mb-2 font-urbanist flex items-center gap-2 text-sm">
                                    <span class="text-<%= fact.colorClass %>"><i class="<%= fact.icon %>"></i></span>
                                    <%= fact.title %>
                                </h4>
                                <p class="text-xs text-gray-600 leading-relaxed">
                                    <%= fact.description %>
                                </p>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div class="col-span-3 text-center text-gray-400 text-sm italic">Sharing temple
                                        facts soon...</div>
                                    <% } %>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ========== Subscribe Section Start ========== -->
<section
    class="px-4 md:px-0 max-w-[932px] mx-auto text-center lg:pb-6 pb-[70px] lg:rounded-[164px] -mb-[100px] relative z-10 bg-white xl:before:absolute xl:before:bottom-0 xl:before:left-[-23px] xl:before:h-[100px] xl:before:w-[145px] xl:before:bg-[url('/assets/images/footer-left-shape.png')] xl:before:bg-no-repeat xl:before:z-11 xl:after:absolute xl:after:bottom-0 xl:after:right-[-23px] xl:after:h-[100px] xl:after:w-[145px] xl:after:bg-[url('/assets/images/footer-right-shape.png')] xl:after:bg-no-repeat xl:after:z-11">
    <h3 class="mb-4 wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
        Subscribe to our newsletter
    </h3>
    <p class="mb-6 text-dark-secondary-text wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
        Stay updated! Subscribe to our mailing list for news, updates, and
        exclusive offers.
    </p>
    <div class="input-group medium w-full md:max-w-[420px] mx-auto pl-4 py-1.5 pr-2.5 rounded-[100px] wow animate__animated animate__fadeInUp relative"
        data-wow-delay=".2s">
        <div class="input-group-addon inline-flex items-center" data-align="inline-start">
            <i class="fas fa-envelope text-2xl"></i>
        </div>
        <input type="text"
