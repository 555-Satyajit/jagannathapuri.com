    <div class="container mx-auto px-4 py-4">
        <nav class="flex text-sm text-gray-500 font-medium">
            <a href="/" class="hover:text-purple-600 transition-colors flex items-center gap-1">
                <i class="hgi hgi-stroke hgi-home-01"></i> Home
            </a>
            <span class="mx-2 text-gray-400">/</span>
            <a href="/user-account" class="hover:text-purple-600 transition-colors">My Account</a>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-900 font-semibold">Order Details</span>
        </nav>
    </div>
</div>
<!-- ========== Breadcrumb Section End ========== -->

<style>
    /* Custom Styles for Order Details Page */
    :root {
        --od-primary: #6200EA;
        --od-primary-light: #B388FF;
        --od-bg: #f8f9fa;
        --od-card-bg: #ffffff;
        --od-text-dark: #161c24;
        --od-text-gray: #637381;
        --od-border: #f1f3f5;
        --od-success: #22c55e;
        --od-error: #ef4444;
    }

    .od-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
        font-family: 'DM Sans', sans-serif;
        background-color: var(--od-bg);
        min-height: 100vh;
    }

    .od-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-bottom: 40px;
    }

    @media (min-width: 768px) {
        .od-header {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }

    .od-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--od-text-dark);
        margin: 0;
        letter-spacing: -0.5px;
    }

    .od-subtitle {
        color: var(--od-text-gray);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }

    .od-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
        text-decoration: none;
        cursor: pointer;
    }

    .od-btn-outline {
        background: white;
        border: 1px solid #e0e0e0;
        color: var(--od-text-dark);
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .od-btn-outline:hover {
        background: #f8f9fa;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
    }

    .od-btn-primary {
        background: var(--od-primary);
        color: white;
        border: none;
        box-shadow: 0 4px 15px rgba(98, 0, 234, 0.3);
    }

    .od-btn-primary:hover {
        background: #5000cc;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(98, 0, 234, 0.4);
    }

    .od-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 30px;
    }

    @media (min-width: 1024px) {
        .od-grid {
            grid-template-columns: 2fr 1fr;
        }
    }

    .od-card {
        background: var(--od-card-bg);
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--od-border);
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

    .od-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px dashed var(--od-border);
    }

    .od-section-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--od-text-dark);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .od-icon-box {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(98, 0, 234, 0.1);
        color: var(--od-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* Timeline Styles */
    .od-timeline-wrapper {
        position: relative;
        padding: 40px 0 20px 0;
        margin-top: 10px;
    }

    .od-timeline-track-container {
        position: absolute;
        top: 24px;
        /* Align with icon center (icon height 48px / 2) + padding-top */
        left: 50px;
        /* Half of step width (100px) */
        right: 50px;
        height: 4px;
        z-index: 1;
    }

    .od-timeline-track-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #f0f0f0;
        border-radius: 4px;
    }

    .od-timeline-track-fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        background: linear-gradient(90deg, var(--od-primary) 0%, #a855f7 100%);
        border-radius: 4px;
        transition: width 1s ease-out;
    }

    .od-timeline-steps {
        display: flex;
        justify-content: space-between;
        position: relative;
        z-index: 2;
    }

    .od-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        width: 100px;
        text-align: center;
        position: relative;
    }

    .od-step-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: white;
        border: 3px solid #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #bdbdbd;
        font-size: 20px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .od-step.active .od-step-icon {
        border-color: var(--od-primary);
        background: var(--od-primary);
        color: white;
        box-shadow: 0 0 0 5px rgba(98, 0, 234, 0.15);
        transform: scale(1.1);
    }

    .od-step.completed .od-step-icon {
        border-color: var(--od-primary);
        background: var(--od-primary);
        color: white;
    }

    .od-step-label {
        font-size: 13px;
        font-weight: 600;
        color: #bdbdbd;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .od-step.active .od-step-label,
    .od-step.completed .od-step-label {
        color: var(--od-text-dark);
    }

    .od-step-sub {
        font-size: 11px;
        color: var(--od-primary);
        font-weight: 500;
        margin-top: -8px;
    }

    /* Product Item */
    .od-product-item {
        display: flex;
        gap: 20px;
        padding: 20px;
        border: 1px solid var(--od-border);
        border-radius: 16px;
        margin-bottom: 16px;
        transition: all 0.2s ease;
    }

    .od-product-item:hover {
        border-color: var(--od-primary-light);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
    }

    .od-product-img {
        width: 100px;
        height: 100px;
        border-radius: 12px;
        object-fit: cover;
        background: #f5f5f5;
    }

    .od-product-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .od-product-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--od-text-dark);
        margin-bottom: 4px;
        text-decoration: none;
    }

    .od-product-title:hover {
        color: var(--od-primary);
    }

    .od-product-meta {
        font-size: 13px;
        color: var(--od-text-gray);
    }

    .od-product-price {
        font-size: 18px;
        font-weight: 700;
        color: var(--od-text-dark);
    }

    .od-product-actions {
        display: flex;
        gap: 15px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px dashed var(--od-border);
    }

    .od-action-link {
        font-size: 13px;
        font-weight: 600;
        color: var(--od-primary);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .od-action-link:hover {
        text-decoration: underline;
    }

    .od-action-link.secondary {
        color: var(--od-text-gray);
    }

    .od-action-link.secondary:hover {
        color: var(--od-text-dark);
    }

    /* Summary Card */
    .od-summary-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: white;
        border: none;
    }

    .od-summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
    }

    .od-summary-row.total {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 18px;
        color: white;
        font-weight: 700;
    }

    .od-summary-value {
        color: white;
        font-weight: 500;
    }

    .od-summary-total-value {
        font-size: 24px;
        color: #4ade80;
        /* lighter green */
    }

    /* Info Group */
    .od-info-group {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
    }

    .od-info-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #757575;
        font-size: 16px;
    }

    .od-info-content h4 {
        font-size: 15px;
        font-weight: 700;
        color: var(--od-text-dark);
        margin-bottom: 4px;
    }

    .od-info-content p {
        font-size: 13px;
        color: var(--od-text-gray);
        line-height: 1.5;
        margin: 0;
    }

    .od-tag {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .od-tag.paid {
        background: #dcfce7;
        color: #166534;
    }

    .od-tag.pending {
        background: #fef9c3;
        color: #854d0e;
    }

    .od-tag.failed {
        background: #fee2e2;
        color: #991b1b;
    }

    /* Responsive Adjustments */
    @media (max-width: 768px) {
        .od-timeline-steps {
            flex-direction: column;
            gap: 20px;
            align-items: flex-start;
            padding-left: 20px;
        }

        .od-timeline-track-bg,
        .od-timeline-track-fill {
            width: 4px;
            height: 100%;
            top: 0;
            left: 36px;
            /* Adjust based on icon size */
            transform: none;
        }

        /* Hide track for mobile for cleaner look if complex */
        .od-timeline-track-bg,
        .od-timeline-track-fill {
            display: none;
        }

        .od-step {
            flex-direction: row;
            width: 100%;
            text-align: left;
        }

        .od-card {
            padding: 20px;
        }

        .od-product-item {
            flex-direction: column;
        }

        .od-product-img {
            width: 100%;
            height: 150px;
        }
    }
</style>

<!-- ========== Order Details Section Start ========== -->
<section class="od-container">

    <!-- Page Header -->
    <div class="od-header">
        <div>
            <h1 class="od-title">Order #<%= order.orderNumber || order.id %>
            </h1>
            <div class="od-subtitle">
                <i class="hgi hgi-stroke hgi-calendar-03"></i>
                Placed on <span>
                    <%= new Date(order.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                        day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                </span>
            </div>
        </div>
        <div style="display: flex; gap: 10px;">
            <button onclick="downloadInvoice('<%= order.id %>', this)" class="od-btn od-btn-outline">
                <i class="hgi hgi-stroke hgi-download-01"></i>
                Download Invoice
            </button>
            <a href="/contact" class="od-btn od-btn-primary">
                <i class="hgi hgi-stroke hgi-help-circle"></i>
                Need Help?
            </a>
        </div>
    </div>

    <div class="od-grid">

        <!-- Left Column: Timeline & Items -->
        <div style="display: flex; flex-direction: column;">

            <!-- Timeline Card -->
            <div class="od-card">
                <div class="od-card-header">
                    <h2 class="od-section-title">
                        <div class="od-icon-box"><i class="hgi hgi-stroke hgi-delivery-track-01"></i></div>
                        Order Status
                    </h2>

                    <% let statusText='Unknown' ; let statusClass='pending' ; if (isCancelled) { statusText='Cancelled'
                        ; statusClass='failed' ; } else if (steps[currentStepIndex]) {
                        statusText=steps[currentStepIndex].label; if (statusText==='Delivered' ) { statusClass='paid' ;
                        } else { statusClass='pending' ; } } %>
                        <span class="od-tag <%= statusClass %>">
                            <%= statusText %>
                        </span>
                </div>

                <div>
                    <% if (isCancelled) { %>
                        <div
                            style="background: #fff5f5; border: 1px solid #fed7d7; border-radius: 12px; padding: 20px; display: flex; gap: 15px; align-items: flex-start;">
                            <div style="color: #e53e3e; font-size: 24px;"><i
                                    class="hgi hgi-stroke hgi-cancel-circle"></i></div>
                            <div>
                                <h3 style="color: #c53030; margin: 0 0 5px 0; font-size: 18px; font-weight: 700;">Order
                                    Cancelled</h3>
                                <p style="color: #742a2a; margin: 0; font-size: 14px;">
                                    This order was cancelled on <strong>
                                        <%= new Date(order.updatedAt || order.date).toLocaleDateString() %>
                                    </strong>.
                                    Refunds are typically processed within 3-5 business days.
                                </p>
                            </div>
                        </div>
                        <% } else { %>
                            <!-- Timeline -->
                            <div class="od-timeline-wrapper">
                                <!-- Track Container for correct alignment -->
                                <div class="od-timeline-track-container hidden md:block">
                                    <div class="od-timeline-track-bg"></div>
                                    <div class="od-timeline-track-fill"
                                        style="width: <%= Math.max(0, currentStepIndex / (steps.length - 1) * 100) %>%">
                                    </div>
                                </div>

                                <div class="od-timeline-steps">
                                    <% steps.forEach((step, index)=> {
                                        const isCompleted = index <= currentStepIndex; const
                                            isCurrent=index===currentStepIndex; let stateClass='' ; if (isCompleted)
                                            stateClass='completed' ; if (isCurrent) stateClass='active' ; %>
                                            <div class="od-step <%= stateClass %>">
                                                <div class="od-step-icon">
                                                    <i class="hgi hgi-stroke <%= step.icon %>"></i>
                                                </div>
                                                <span class="od-step-label">
                                                    <%= step.label %>
                                                </span>
                                                <% if (isCurrent) { %><span class="od-step-sub">Current</span>
                                                    <% } %>
                                            </div>
                                            <% }); %>
                                </div>
                            </div>
                            <% } %>
                </div>
            </div>

            <!-- Items List -->
            <div class="od-card">
                <div class="od-card-header">
                    <h2 class="od-section-title">
                        <div class="od-icon-box"><i class="hgi hgi-stroke hgi-shopping-bag-02"></i></div>
                        Items Ordered (<%= order.items.length %>)
                    </h2>
                </div>
                <div>
                    <% order.items.forEach(item=> { %>
                        <div class="od-product-item">
                            <!-- Product Image -->
                            <% if(item.product && item.product.images && item.product.images.length> 0) {
                                const imagePath = item.product.images[0];
                                const isExternal = imagePath.startsWith('http') || imagePath.startsWith('//');
                                const src = isExternal ? imagePath : '/uploads/' + imagePath;
                                %>
                                <img src="<%= src %>" alt="<%= item.productName %>" class="od-product-img">
                                <% } else { %>
                                    <div class="od-product-img"
                                        style="display: flex; align-items: center; justify-content: center; font-size: 24px; color: #bdbdbd;">
                                        <i class="hgi hgi-stroke hgi-image-02"></i>
                                    </div>
                                    <% } %>

                                        <!-- Product Info -->
                                        <div class="od-product-info">
                                            <div>
                                                <div
                                                    style="display: flex; justify-content: space-between; align-items: flex-start;">
                                                    <a href="/product-details/<%= item.productId %>"
                                                        class="od-product-title">
                                                        <%= item.productName %>
                                                    </a>
                                                    <div class="od-product-price">₹<%= item.price %>
                                                    </div>
                                                </div>
                                                <div class="od-product-meta">
                                                    Quantity: <strong style="color: var(--od-text-dark)">
                                                        <%= item.quantity %>
                                                    </strong>
                                                </div>
                                            </div>

                                            <div class="od-product-actions">
                                                <a href="/product-details/<%= item.productId %>" class="od-action-link">
                                                    <i class="hgi hgi-stroke hgi-shopping-cart-01"></i> Buy Again
                                                </a>
                                                <span style="color: #e0e0e0;">|</span>
                                                <a href="/product-details/<%= item.productId %>"
                                                    class="od-action-link secondary">
                                                    View Product
                                                </a>
                                            </div>
                                        </div>
                        </div>
                        <% }); %>
                </div>
            </div>

        </div>

        <!-- Right Column: Summary & Info -->
        <div style="display: flex; flex-direction: column;">

            <!-- Summary Card -->
            <div class="od-card od-summary-card">
                <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 25px;">Order Summary</h2>

                <div class="od-summary-row">
                    <span>Subtotal</span>
                    <span class="od-summary-value">₹<%= order.totalAmount %></span>
                </div>
                <div class="od-summary-row">
                    <span>Shipping</span>
                    <span class="od-summary-value" style="color: #4ade80;">Free</span>
                </div>
                <div class="od-summary-row">
                    <span>Tax</span>
                    <span class="od-summary-value">₹0.00</span>
                </div>

                <div class="od-summary-row total">
                    <span>Total Amount</span>
                    <span class="od-summary-total-value">₹<%= order.totalAmount %></span>
                </div>
            </div>

            <!-- Shipping Details -->
            <div class="od-card">
                <div class="od-card-header">
                    <h2 class="od-section-title">
                        <div class="od-icon-box" style="background: rgba(30, 144, 255, 0.1); color: #1e90ff;"><i
                                class="hgi hgi-stroke hgi-location-01"></i></div>
                        Shipping Details
                    </h2>
                </div>
                <div>
                    <% if (order.shippingAddress) { %>
                        <div class="od-info-group">
                            <div class="od-info-icon"><i class="hgi hgi-stroke hgi-home-03"></i></div>
                            <div class="od-info-content">
                                <h4>
                                    <%= customer.fullName %>
                                </h4>
                                <p>
                                    <%= order.shippingAddress.addressLine1 %><br>
                                        <% if(order.shippingAddress.addressLine2) { %>
                                            <%= order.shippingAddress.addressLine2 %><br>
                                                <% } %>
                                                    <%= order.shippingAddress.city %>, <%= order.shippingAddress.state
                                                            %> - <%= order.shippingAddress.zipCode %>
                                </p>
                            </div>
                        </div>
                        <div class="od-info-group">
                            <div class="od-info-icon"><i class="hgi hgi-stroke hgi-call"></i></div>
                            <div class="od-info-content">
                                <h4>Phone</h4>
                                <p>
                                    <%= order.shippingAddress.phone || customer.phone %>
                                </p>
                            </div>
                        </div>
                        <% } else { %>
                            <div style="text-align: center; color: #999; padding: 20px;">
                                Shipping details not available
                            </div>
                            <% } %>
                </div>
            </div>

            <!-- Payment Info -->
            <div class="od-card">
                <div class="od-card-header">
                    <h2 class="od-section-title">
                        <div class="od-icon-box" style="background: rgba(255, 193, 7, 0.1); color: #ffc107;"><i
                                class="hgi hgi-stroke hgi-credit-card"></i></div>
                        Payment Info
                    </h2>
                </div>
                <div>
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <span style="color: var(--od-text-gray); font-size: 14px;">Method</span>
                        <span
                            style="font-weight: 600; color: var(--od-text-dark); display: flex; align-items: center; gap: 8px;">
                            <i class="hgi hgi-stroke hgi-wallet-01" style="color: #bdbdbd;"></i>
                            <%= order.paymentMethod || 'Credit Card' %>
                        </span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--od-text-gray); font-size: 14px;">Status</span>
                        <% let pStatusClass='pending' ; if (order.paymentStatus===1 || order.paymentStatus==='Paid' )
                            pStatusClass='paid' ; else if (order.paymentStatus==='Failed' ) pStatusClass='failed' ; %>
                            <span class="od-tag <%= pStatusClass %>">
                                <%= order.paymentStatus===1 ? 'Paid' : (order.paymentStatus==='Paid' ? 'Paid'
                                    : 'Pending' ) %>
                            </span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<!-- ========== Order Details Section End ========== -->

<script>
    function downloadInvoice(orderId, btn) {
        const originalContent = btn.innerHTML;
        const width = btn.getBoundingClientRect().width;
        btn.style.width = width + 'px'; // Fix width
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin" style="font-size: 20px;"></i>';
        btn.disabled = true;
        btn.style.opacity = '0.7';
        btn.style.cursor = 'not-allowed';

        fetch(`/user-invoice/${orderId}`)
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.blob();
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = `invoice-${orderId}.pdf`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);

                btn.innerHTML = '<i class="hgi hgi-stroke hgi-tick-02" style="font-size: 20px; color: #4ade80;"></i>';
                setTimeout(() => {
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                    btn.style.opacity = '1';
                    btn.style.cursor = 'pointer';
                    btn.style.width = '';
                }, 2000);
            })
            .catch(error => {
                console.error('Error downloading invoice:', error);
                alert('Failed to download invoice. Please try again.');
                btn.innerHTML = originalContent;
                btn.disabled = false;
                btn.style.opacity = '1';
                btn.style.cursor = 'pointer';
                btn.style.width = '';
            });
    }
</script>