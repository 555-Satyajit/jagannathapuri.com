<!-- ========== Register Section Start ========== -->
<section class="py-24 bg-[#FFFFF0]">
    <div class="container mx-auto px-4">
        <div class="max-w-[600px] mx-auto">
            <!-- Register Card -->
            <div class="bg-white rounded-[32px] shadow-2xl shadow-primary/5 p-8 md:p-12 border border-primary/5 transition-all">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold text-gray-900 mb-3">Create Account</h2>
                    <p class="text-gray-500">Join us for a personalized shopping experience</p>
                </div>

                <form id="register-form" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Full Name -->
                        <div class="space-y-2 relative">
                            <label class="text-sm font-bold text-gray-700 ml-1">Full Name</label>
                            <div class="relative group">
                                <span class="absolute left-5 top-1/2 -translate-y-1/2 text-primary group-focus-within:text-primary transition-colors">
                                    <i class="hgi hgi-stroke hgi-user-01 text-xl"></i>
                                </span>
                                <input type="text" name="fullName" id="reg-name" required
                                    class="w-full py-4 rounded-[100px] border border-gray-100 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-[#F0F2FA]/50 text-gray-700 font-medium placeholder-gray-400"
                                    style="padding-left: 60px !important; padding-right: 20px !important;"
                                    placeholder="Enter full name" />
                            </div>
                        </div>
                        <!-- Phone Number -->
                        <div class="space-y-2 relative">
                            <label class="text-sm font-bold text-gray-700 ml-1">Phone Number</label>
                            <div class="relative group">
                                <span class="absolute left-5 top-1/2 -translate-y-1/2 text-primary group-focus-within:text-primary transition-colors">
                                    <i class="hgi hgi-stroke hgi-call-02 text-xl"></i>
                                </span>
                                <input type="tel" name="phone" id="reg-phone"
                                    class="w-full py-4 rounded-[100px] border border-gray-100 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-[#F0F2FA]/50 text-gray-700 font-medium placeholder-gray-400"
                                    style="padding-left: 60px !important; padding-right: 20px !important;"
                                    placeholder="Enter phone" />
                            </div>
                        </div>
                    </div>

                    <!-- Email Address -->
                    <div class="space-y-2 relative">
                        <label class="text-sm font-bold text-gray-700 ml-1">Email Address</label>
                        <div class="relative group">
                            <span class="absolute left-5 top-1/2 -translate-y-1/2 text-primary group-focus-within:text-primary transition-colors">
                                <i class="hgi hgi-stroke hgi-mail-02 text-xl"></i>
                            </span>
                            <input type="email" name="email" id="reg-email" required
                                class="w-full py-4 rounded-[100px] border border-gray-100 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-[#F0F2FA]/50 text-gray-700 font-medium placeholder-gray-400"
                                style="padding-left: 60px !important; padding-right: 20px !important;"
                                placeholder="Enter email address" />
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-2 relative">
                        <label class="text-sm font-bold text-gray-700 ml-1">Password</label>
                        <div class="relative group">
                            <span class="absolute left-5 top-1/2 -translate-y-1/2 text-primary group-focus-within:text-primary transition-colors">
                                <i class="hgi hgi-stroke hgi-lock-password-01 text-xl"></i>
                            </span>
                            <input type="password" name="password" id="reg-password" required
                                class="w-full py-4 rounded-[100px] border border-gray-100 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-[#F0F2FA]/50 text-gray-700 font-medium placeholder-gray-400"
                                style="padding-left: 60px !important; padding-right: 60px !important;"
                                placeholder="Create a password" />
                        </div>
                    </div>

                    <!-- Terms -->
                    <div class="flex items-center px-1">
                        <label class="flex items-center gap-x-2.5 cursor-pointer select-none group/terms">
                            <div class="relative flex items-center">
                                <input type="checkbox" required class="peer h-5 w-5 rounded-md border-2 border-gray-200 text-primary focus:ring-primary/20 transition-all checked:border-primary">
                                <i class="hgi hgi-stroke hgi-tick-01 absolute inset-0 m-auto text-white text-xs opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity"></i>
                            </div>
                            <span class="text-sm text-gray-600 font-semibold group-hover/terms:text-primary transition-colors">I agree to the <a href="#" class="text-primary font-bold hover:underline">Terms & Conditions</a></span>
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit"
                        class="btn btn-primary w-full rounded-[100px] py-4 text-base font-bold shadow-lg shadow-primary/30 hover:shadow-primary/40 transition-all active:scale-[0.98] mt-4">
                        Create Account
                    </button>

                    <p class="text-center text-sm text-gray-500 mt-8">
                        Already have an account?
                        <a href="/login" class="text-primary font-bold hover:underline">Login Now</a>
                    </p>
                </form>

                <div class="relative my-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-100"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-4 bg-white text-gray-400 font-medium">Or join with</span>
                    </div>
                </div>

                <!-- Social Login -->
                <button type="button" id="googleLoginBtn"
                    class="w-full flex items-center justify-center gap-3 px-4 py-4 rounded-[100px] border border-gray-100 bg-white hover:bg-gray-50 transition-all font-semibold text-gray-700 active:scale-[0.98]">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-5 h-5" alt="Google">
                    Google
                </button>
            </div>
        </div>
    </div>
</section>
<!-- ========== Register Section End ========== -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.getElementById('register-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/register', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                },
                body: JSON.stringify(data)
            });
            const result = await response.json();

            if (result.success) {
                if (result.requiresVerification) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Verification Required',
                        text: result.message || 'Please check your email to verify your account.',
                    }).then(() => {
                        window.location.href = '/login';
                    });
                } else {
                    Swal.fire({
                        icon: 'success',
                        title: 'Registration Successful',
                        text: 'Redirecting to your account...',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = '/user-account';
                    });
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Registration Failed',
                    text: result.error || 'Something went wrong'
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: 'Something went wrong!'
            });
        }
    });

    document.getElementById('googleLoginBtn').addEventListener('click', async () => {
        try {
            const { error } = await window.supabase.auth.signInWithOAuth({
                provider: 'google',
                options: { redirectTo: window.location.origin + '/auth/callback' }
            });
            if (error) throw error;
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Social Auth Failed', text: error.message });
        }
    });
</script>