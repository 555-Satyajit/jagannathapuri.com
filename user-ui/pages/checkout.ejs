                      <div class="relative w-1/2">
                        <!-- Forced native style -->
                        <select id="saved-address-select"
                          class="form-control rounded-lg w-full px-3 py-2 border border-blue-500 bg-white"
                          style="display: block !important; opacity: 1 !important; visibility: visible !important; position: relative !important; z-index: 9999 !important; height: auto !important;">
                          <option value="">Select a saved address...</option>
                          <% user.addresses.forEach((addr, index)=> { %>
                            <option value="<%= index %>" data-address1="<%= addr.addressLine1 %>"
                              data-city="<%= addr.city %>" data-state="<%= addr.state %>" data-zip="<%= addr.zipCode %>"
                              data-country="<%= addr.country %>">
                              <%= addr.type && addr.type !=='Shipping' ? addr.type : (addr.addressLine1 + ', ' +
                                addr.city) %>
                            </option>
                            <% }) %>
                              <option value="new">+ Add New Address</option>
                        </select>
                      </div>
                      <!-- Safe JSON injection -->
                      <% } %>
                  </div>
