                      lastName: document.getElementById('last_name'),
                      email: document.getElementById('email_address'),
                      phone: document.getElementById('phone_number'),
                      addressLine1: document.getElementById('address_comment'),
                      city: document.getElementById('city'),
                      state: document.getElementById('state'),
                      zipCode: document.getElementById('zip_code'),
                      country: document.getElementById('country_region')
                    };

                    // Function to populate fields from selected option
                    const populateFromOption = (option) => {
                      if (!option) return;

                      const val = option.value;
                      console.log('Selection changed:', val);

                      if (val === 'new') {
                        if (formFields.addressLine1) formFields.addressLine1.value = '';
                        if (formFields.city) formFields.city.value = '';
                        if (formFields.state) formFields.state.value = '';
                        if (formFields.zipCode) formFields.zipCode.value = '';
                      } else if (option.dataset.address1) {
                        // It's a saved address, use data attributes
                        console.log('Populating from data attributes:', option.dataset);
                        if (formFields.addressLine1) formFields.addressLine1.value = option.dataset.address1 || '';
                        if (formFields.city) formFields.city.value = option.dataset.city || '';
                        if (formFields.state) formFields.state.value = option.dataset.state || '';
                        if (formFields.zipCode) formFields.zipCode.value = option.dataset.zip || '';
                      }
                    };

                    if (addressSelect) {
                      // Cleanup plugins again just in case
                      const cleanPlugins = () => {
                        const niceSelects = document.querySelectorAll('.nice-select');
                        niceSelects.forEach(el => {
                          if (el.previousElementSibling === addressSelect || el.nextElementSibling === addressSelect) {
                            el.style.display = 'none';
                          }
                        });
                        if (typeof $ !== 'undefined' && $(addressSelect).niceSelect) {
                          $(addressSelect).niceSelect('destroy');
                        }
                      };
                      cleanPlugins();
                      setTimeout(cleanPlugins, 500);

                      // Listen for changes
                      addressSelect.addEventListener('change', function () {
                        const selectedOption = this.options[this.selectedIndex];
                        populateFromOption(selectedOption);
                      });

                      // Auto-select first address if available and nothing selected
                      if (addressSelect.options.length > 2) { // 0 is "Select...", last is "New", so > 2 means we have an address
                        // Select the first real address (index 1)
                        addressSelect.selectedIndex = 1;
                        populateFromOption(addressSelect.options[1]);
                      }
                    }

                    // Pre-fill user basic info
                    const userInfo = document.getElementById('user-info-data');
                    if (userInfo) {
                      if (formFields.firstName && !formFields.firstName.value) formFields.firstName.value = userInfo.dataset.firstname || '';
                      if (formFields.lastName && !formFields.lastName.value) formFields.lastName.value = userInfo.dataset.lastname || '';
                      if (formFields.email && !formFields.email.value) formFields.email.value = userInfo.dataset.email || '';
                      if (formFields.phone && !formFields.phone.value) formFields.phone.value = userInfo.dataset.phone || '';
                    }
                  });
                </script>
