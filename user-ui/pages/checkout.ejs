            <script>
              // Coupon Logic
              const couponBtn = document.getElementById('apply-coupon-btn');
              const couponInput = document.getElementById('coupon-code');
              const couponMsg = document.getElementById('coupon-message');

              if (couponBtn) {
                couponBtn.addEventListener('click', async function () {
                  const isRemove = this.innerText === 'Remove';
                  const code = couponInput.value.trim();

                  if (!isRemove && !code) {
                    showMsg('Please enter a coupon code', 'text-red-500');
                    return;
                  }

                  const endpoint = isRemove ? '/api/remove-coupon' : '/api/apply-coupon';

                  try {
                    couponBtn.disabled = true;
                    couponBtn.innerHTML = '<i class="bx bx-loader-alt animate-spin"></i>';

                    const res = await fetch(endpoint, {
                      method: 'POST',
                      headers: { 
                        'Content-Type': 'application/json',
                        'x-csrf-token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                      },
                      body: JSON.stringify({ code })
                    });

                    const data = await res.json();

                    if (data.success) {
                      showMsg(data.message, 'text-green-500');
                      if (isRemove) {
                        location.reload();
                      } else {
                        location.reload();
                      }
                    } else {
                      showMsg(data.message, 'text-red-500');
                      couponBtn.disabled = false;
                      couponBtn.innerText = isRemove ? 'Remove' : 'Apply';
                    }
                  } catch (e) {
                    console.error(e);
                    showMsg('Something went wrong', 'text-red-500');
                    couponBtn.disabled = false;
                    couponBtn.innerText = isRemove ? 'Remove' : 'Apply';
                  }
                });
              }

              function showMsg(msg, colorClass) {
                couponMsg.innerText = msg;
                couponMsg.className = 'text-xs mt-2 block ' + colorClass;
              }

              // Checkout Remove Item Logic
              const removeCheckoutBtns = document.querySelectorAll('.remove-checkout-item');
              removeCheckoutBtns.forEach(btn => {
                btn.addEventListener('click', async function (e) {
                  e.preventDefault();
                  const productId = this.getAttribute('data-product-id');

                  if (confirm('Are you sure you want to remove this item from your cart?')) {
                    try {
                      const originalHtml = this.innerHTML;
                      this.innerHTML = '<i class="bx bx-loader-alt animate-spin text-lg"></i>';
                      this.disabled = true;

                      const response = await fetch('/cart/remove', {
                        method: 'POST',
                        headers: {
                          'Content-Type': 'application/json',
                          'X-Requested-With': 'XMLHttpRequest',
                          'x-csrf-token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                        },
                        body: JSON.stringify({ productId })
                      });

                      const data = await response.json();
                      if (data.success) {
                        // Reload to recalculate all totals securely from the server
                        window.location.reload();
                      } else {
                        Swal.fire({ icon: 'error', text: data.error || 'Failed to remove item. Please try again.' });
                        this.innerHTML = originalHtml;
                        this.disabled = false;
                      }
                    } catch (error) {
                      console.error('Checkout remove error:', error);
                      Swal.fire({ icon: 'error', text: 'Something went wrong. Please try again.' });
                      this.innerHTML = originalHtml;
                      this.disabled = false;
                    }
                  }
                });
              });
            </script>
          </div>
        </div>
