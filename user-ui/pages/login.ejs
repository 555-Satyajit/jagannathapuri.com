<!-- ========== Login Section Start ========== -->
<section class="py-24 bg-[#FFFFF0]">
    <div class="container mx-auto px-4">
        <div class="max-w-[500px] mx-auto">
            <!-- Main Login Card -->
            <div class="bg-white rounded-[32px] shadow-2xl shadow-primary/5 p-8 md:p-12 border border-primary/5 transition-all" id="password-login-section">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold text-gray-900 mb-3">Welcome Back</h2>
                    <p class="text-gray-500">Log in to your Puri Store account</p>
                </div>

                <form id="login-form" class="space-y-6">
                    <!-- Email Input -->
                    <div class="space-y-2 relative">
                        <label class="text-sm font-bold text-gray-700 ml-1">Email Address</label>
                        <div class="relative group">
                            <span class="absolute left-5 top-1/2 -translate-y-1/2 text-primary group-focus-within:text-primary transition-colors">
                                <i class="hgi hgi-stroke hgi-mail-02 text-xl"></i>
                            </span>
                            <input type="email" name="email" id="login-email" required
                                class="w-full py-4 rounded-[100px] border border-gray-100 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-[#F0F2FA]/50 text-gray-700 font-medium placeholder-gray-400"
                                style="padding-left: 60px !important; padding-right: 20px !important;"
                                placeholder="Enter your email" />
                        </div>
                    </div>

                    <!-- Password Input -->
                    <div class="space-y-2 relative">
                        <div class="flex justify-between items-center ml-1">
                            <label class="text-sm font-bold text-gray-700">Password</label>
                            <a href="/forgot-password" class="text-xs font-bold text-primary hover:underline">Forgot password?</a>
                        </div>
                        <div class="relative group">
                            <span class="absolute left-5 top-1/2 -translate-y-1/2 text-primary group-focus-within:text-primary transition-colors">
                                <i class="hgi hgi-stroke hgi-lock-password-01 text-xl"></i>
                            </span>
                            <input type="password" name="password" id="login-password" required
                                class="w-full py-4 rounded-[100px] border border-gray-100 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-[#F0F2FA]/50 text-gray-700 font-medium placeholder-gray-400"
                                style="padding-left: 60px !important; padding-right: 60px !important;"
                                placeholder="Enter your password" />
                            <button type="button" id="toggle-password"
                                class="absolute right-6 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary transition-colors">
                                <i class="hgi hgi-stroke hgi-view text-xl"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Options -->
                    <div class="flex items-center justify-between px-1">
                        <label class="flex items-center gap-x-2.5 cursor-pointer select-none group/remember">
                            <div class="relative flex items-center">
                                <input type="checkbox" class="peer h-5 w-5 rounded-md border-2 border-gray-200 text-primary focus:ring-primary/20 transition-all checked:border-primary">
                                <i class="hgi hgi-stroke hgi-tick-01 absolute inset-0 m-auto text-white text-xs opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity"></i>
                            </div>
                            <span class="text-sm text-gray-600 font-semibold group-hover/remember:text-primary transition-colors">Remember me</span>
                        </label>
                        <button type="button" id="switchToOtp" class="text-primary font-bold hover:text-primary-dark text-sm transition-colors bg-primary/5 px-4 py-2 rounded-full border border-primary/10">Sign in with OTP</button>
                    </div>

                    <!-- Login Button -->
                    <button type="submit"
                        class="btn btn-primary w-full rounded-[100px] py-4 text-base font-bold shadow-lg shadow-primary/30 hover:shadow-primary/40 transition-all active:scale-[0.98] mt-4">
                        Login
                    </button>
                </form>

                <div class="relative my-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-100"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-4 bg-white text-gray-400 font-medium">Or continue with</span>
                    </div>
                </div>

                <!-- Social Login -->
                <button type="button" id="googleLoginBtn"
                    class="w-full flex items-center justify-center gap-3 px-4 py-4 rounded-[100px] border border-gray-100 bg-white hover:bg-gray-50 transition-all font-semibold text-gray-700 active:scale-[0.98]">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" class="w-5 h-5" alt="Google">
                    Google
                </button>

                <p class="text-center text-sm text-gray-500 mt-8">
                    Don't have an account?
                    <a href="/register" class="text-primary font-bold hover:underline">Register Now</a>
                </p>
            </div>

            <!-- OTP Login Card (Hidden) -->
            <div class="bg-white rounded-[32px] shadow-2xl shadow-primary/5 p-8 md:p-12 border border-primary/5 transition-all hidden" id="otp-login-section">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold text-gray-900 mb-3">OTP Login</h2>
                    <p class="text-gray-500">Fast and secure access via email</p>
                </div>

                <form id="otp-form" class="space-y-6">
                    <div id="otp-email-step" class="space-y-6">
                        <div class="space-y-2 relative">
                            <label class="text-sm font-bold text-gray-700 ml-1">Email Address</label>
                            <div class="relative group">
                                <span class="absolute left-5 top-1/2 -translate-y-1/2 text-primary group-focus-within:text-primary transition-colors">
                                    <i class="hgi hgi-stroke hgi-mail-01 text-xl"></i>
                                </span>
                                <input type="email" id="login-otp-email" required
                                    class="w-full pl-14 pr-5 py-4 rounded-[100px] border border-gray-100 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-[#F0F2FA]/50 text-gray-700 font-medium placeholder-gray-400"
                                    placeholder="Enter your email" />
                            </div>
                        </div>
                        <button type="button" id="sendOtpBtn"
                            class="btn btn-primary w-full rounded-[100px] py-4 text-base font-bold shadow-lg shadow-primary/30 hover:shadow-primary/40 transition-all active:scale-[0.98]">
                            Send Verification Code
                        </button>
                    </div>

                    <div id="otp-verify-step" class="hidden space-y-6">
                        <div class="text-center">
                            <p class="text-sm text-gray-500 mb-6 font-medium">We've sent a code to your email. Please enter it below.</p>
                            <div class="relative mb-8">
                                <input type="text" id="login-otp-token" maxlength="8"
                                    class="w-full text-center tracking-[10px] text-3xl font-bold py-4 border-b-2 border-primary focus:border-primary-dark outline-none text-primary transition-colors bg-transparent"
                                    placeholder="000000" />
                            </div>
                        </div>
                        <button type="submit"
                            class="btn btn-primary w-full rounded-[100px] py-4 text-base font-bold shadow-lg shadow-primary/30 hover:shadow-primary/40 transition-all active:scale-[0.98]">
                            Verify & Login
                        </button>
                    </div>

                    <div class="text-center mt-6">
                        <button type="button" id="switchToPassword" class="text-gray-500 hover:text-primary transition-colors text-sm font-bold">Back to Password Login</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
<!-- ========== Login Section End ========== -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const loginForm = document.getElementById('login-form');
    const otpForm = document.getElementById('otp-form');
    const googleLoginBtn = document.getElementById('googleLoginBtn');
    const switchToOtp = document.getElementById('switchToOtp');
    const switchToPassword = document.getElementById('switchToPassword');
    const sendOtpBtn = document.getElementById('sendOtpBtn');

    // Password Login
    loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/login', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                },
                body: JSON.stringify(data)
            });
            const result = await response.json();

            if (result.success) {
                window.location.href = '/user-account';
            } else {
                Swal.fire({ icon: 'error', title: 'Login Failed', text: result.error || 'Invalid credentials' });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({ icon: 'error', title: 'Oops...', text: 'Something went wrong!' });
        }
    });

    // Google Login
    googleLoginBtn.addEventListener('click', async () => {
        try {
            const { error } = await window.supabase.auth.signInWithOAuth({
                provider: 'google',
                options: { redirectTo: window.location.origin + '/auth/callback' }
            });
            if (error) throw error;
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Social Login Failed', text: error.message });
        }
    });

    // Toggle Sections
    switchToOtp.addEventListener('click', () => {
        document.getElementById('password-login-section').classList.add('hidden');
        document.getElementById('otp-login-section').classList.remove('hidden');
    });

    switchToPassword.addEventListener('click', () => {
        document.getElementById('otp-login-section').classList.add('hidden');
        document.getElementById('password-login-section').classList.remove('hidden');
    });

    // OTP Flow
    sendOtpBtn.addEventListener('click', async () => {
        const email = document.getElementById('login-otp-email').value;
        if (!email) return Swal.fire({ icon: 'warning', text: "Please enter your email" });

        try {
            sendOtpBtn.disabled = true;
            sendOtpBtn.innerText = 'Sending...';
            const response = await fetch('/send-otp', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                },
                body: JSON.stringify({ email })
            });
            const result = await response.json();
            if (result.success) {
                document.getElementById('otp-email-step').classList.add('hidden');
                document.getElementById('otp-verify-step').classList.remove('hidden');
            } else {
                Swal.fire({ icon: 'error', text: result.error || "Failed to send OTP" });
            }
        } catch (err) {
            console.error(err);
        } finally {
            sendOtpBtn.disabled = false;
            sendOtpBtn.innerText = 'Send OTP';
        }
    });

    otpForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('login-otp-email').value;
        const token = document.getElementById('login-otp-token').value;

        try {
            const response = await fetch('/verify-otp', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                },
                body: JSON.stringify({ email, token })
            });
            const result = await response.json();
            if (result.success) {
                window.location.href = '/user-account';
            } else {
                Swal.fire({ icon: 'error', text: result.error || "Verification failed" });
            }
        } catch (err) {
            console.error(err);
        }
    });
</script>