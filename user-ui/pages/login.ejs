<section class="py-20 bg-gray-50">
    <div class="container flex justify-center">
        <div class="w-full max-w-[500px] bg-white p-8 md:p-12 rounded-3xl shadow-light-z-24">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold text-light-primary-text mb-2">Welcome Back</h2>
                <p class="text-light-secondary-text">Login to manage your orders and profile</p>
            </div>

            <div id="password-login-section">
                <form id="login-form" class="flex flex-col gap-y-5">
                    <div class="flex flex-col gap-1.5">
                        <label for="login-email" class="text-sm font-bold text-gray-700 px-1">Email Address</label>
                        <div class="relative group">
                            <div
                                class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors pointer-events-none">
                                <i class="hgi hgi-stroke hgi-mail-01 text-xl"></i>
                            </div>
                            <input type="email" name="email" id="login-email" required
                                class="w-full pr-5 py-3.5 rounded-[100px] border border-gray-200 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-white text-gray-700 font-medium placeholder-gray-400"
                                style="padding-left: 3.5rem" placeholder="Enter your email" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="login-password" class="text-sm font-bold text-gray-700 px-1">Password</label>
                        <div class="relative group">
                            <div
                                class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors pointer-events-none">
                                <i class="hgi hgi-stroke hgi-lock-01 text-xl"></i>
                            </div>
                            <input type="password" name="password" id="login-password" required
                                class="w-full pr-5 py-3.5 rounded-[100px] border border-gray-200 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-white text-gray-700 font-medium placeholder-gray-400"
                                style="padding-left: 3.5rem" placeholder="Enter your password" />
                        </div>
                    </div>

                    <div class="flex items-center justify-between px-1">
                        <label class="flex items-center gap-x-2 cursor-pointer select-none">
                            <div class="relative flex items-center">
                                <input type="checkbox"
                                    class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-gray-300 transition-all checked:border-primary checked:bg-primary" />
                                <div
                                    class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-white opacity-0 transition-opacity peer-checked:opacity-100">
                                    <i class="hgi hgi-stroke hgi-tick-01 text-xs"></i>
                                </div>
                            </div>
                            <span class="text-sm text-gray-500">Remember me</span>
                        </label>
                        <a href="#" class="text-sm font-semibold text-primary hover:underline">Forgot password?</a>
                    </div>

                    <button type="submit"
                        class="btn btn-primary w-full rounded-[100px] py-4 text-base font-bold shadow-lg shadow-primary/30 hover:shadow-primary/50 transition-all active:scale-[0.98]">
                        Login
                    </button>

                    <button type="button" id="switchToOtp" class="text-primary font-bold hover:underline text-sm">Sign
                        in with OTP (Email)</button>

                    <p class="text-center text-sm text-gray-500 mt-2">
                        Don't have an account?
                        <a href="/register" class="text-primary font-bold hover:underline">Register Now</a>
                    </p>
                </form>
            </div>

            <div id="otp-login-section" class="hidden">
                <form id="otp-form" class="flex flex-col gap-y-5">
                    <div id="otp-email-step">
                        <div class="mb-6 flex flex-col gap-1.5">
                            <label for="login-otp-email" class="text-sm font-bold text-gray-700 px-1">Email
                                Address</label>
                            <div class="relative group">
                                <div
                                    class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors pointer-events-none">
                                    <i class="hgi hgi-stroke hgi-mail-01 text-xl"></i>
                                </div>
                                <input type="email" id="login-otp-email" required
                                    class="w-full pr-5 py-3.5 rounded-[100px] border border-gray-200 outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all bg-white text-gray-700 font-medium placeholder-gray-400"
                                    style="padding-left: 3.5rem" placeholder="Enter your email" />
                            </div>
                        </div>
                        <button type="button" id="sendOtpBtn"
                            class="btn btn-primary w-full rounded-[100px] py-4 text-base font-bold shadow-lg shadow-primary/30 hover:shadow-primary/50 transition-all active:scale-[0.98]">
                            Send OTP
                        </button>
                    </div>

                    <div id="otp-verify-step" class="hidden">
                        <p class="text-center text-sm text-gray-500 mb-4">Check your email for the code.</p>
                        <div class="relative mb-6">
                            <input type="text" id="login-otp-token" maxlength="8"
                                class="w-full text-center tracking-[10px] text-2xl font-bold py-3 border-b-2 border-gray-200 focus:border-primary outline-none text-gray-800 transition-colors"
                                placeholder="000000" />
                        </div>
                        <button type="submit"
                            class="btn btn-primary w-full rounded-[100px] py-4 text-base font-bold shadow-lg shadow-primary/30 hover:shadow-primary/50 transition-all active:scale-[0.98]">
                            Verify & Login
                        </button>
                    </div>

                    <button type="button" id="switchToPassword"
                        class="text-gray-500 hover:text-primary transition-colors text-sm font-semibold">Back to
                        Password Login</button>
                </form>
            </div>

            <div class="mt-8 pt-8 border-t border-gray-100">
                <p class="text-center text-sm text-gray-500 mb-4 font-semibold">Or login with</p>
                <button type="button" id="googleLoginBtn"
                    class="w-full flex items-center justify-center gap-x-3 py-3.5 px-6 rounded-[100px] border border-gray-200 bg-white hover:bg-gray-50 hover:border-gray-300 transition-all font-semibold text-gray-700 shadow-sm hover:shadow-md active:scale-[0.99]">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path
                            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                            fill="#4285F4" />
                        <path
                            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                            fill="#34A853" />
                        <path
                            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
                            fill="#FBBC05" />
                        <path
                            d="M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z"
                            fill="#EA4335" />
                    </svg>
                    Continue with Google
                </button>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const loginForm = document.getElementById('login-form');
    const otpForm = document.getElementById('otp-form');
    const googleLoginBtn = document.getElementById('googleLoginBtn');
    const switchToOtp = document.getElementById('switchToOtp');
    const switchToPassword = document.getElementById('switchToPassword');
    const sendOtpBtn = document.getElementById('sendOtpBtn');

    // Password Login
    loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/login', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                },
                body: JSON.stringify(data)
            });
            const result = await response.json();

            if (result.success) {
                window.location.href = '/user-account';
            } else {
                Swal.fire({ icon: 'error', title: 'Login Failed', text: result.error || 'Invalid credentials' });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({ icon: 'error', title: 'Oops...', text: 'Something went wrong!' });
        }
    });

    // Google Login
    googleLoginBtn.addEventListener('click', async () => {
        try {
            const { error } = await window.supabase.auth.signInWithOAuth({
                provider: 'google',
                options: { redirectTo: window.location.origin + '/auth/callback' }
            });
            if (error) throw error;
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Social Login Failed', text: error.message });
        }
    });

    // Toggle Sections
    switchToOtp.addEventListener('click', () => {
        document.getElementById('password-login-section').classList.add('hidden');
        document.getElementById('otp-login-section').classList.remove('hidden');
    });

    switchToPassword.addEventListener('click', () => {
        document.getElementById('otp-login-section').classList.add('hidden');
        document.getElementById('password-login-section').classList.remove('hidden');
    });

    // OTP Flow
    sendOtpBtn.addEventListener('click', async () => {
        const email = document.getElementById('login-otp-email').value;
        if (!email) return alert("Please enter your email");

        try {
            sendOtpBtn.disabled = true;
            sendOtpBtn.innerText = 'Sending...';
            const response = await fetch('/send-otp', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                },
                body: JSON.stringify({ email })
            });
            const result = await response.json();
            if (result.success) {
                document.getElementById('otp-email-step').classList.add('hidden');
                document.getElementById('otp-verify-step').classList.remove('hidden');
            } else {
                alert(result.error || "Failed to send OTP");
            }
        } catch (err) {
            console.error(err);
        } finally {
            sendOtpBtn.disabled = false;
            sendOtpBtn.innerText = 'Send OTP';
        }
    });

    otpForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('login-otp-email').value;
        const token = document.getElementById('login-otp-token').value;

        try {
            const response = await fetch('/verify-otp', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                },
                body: JSON.stringify({ email, token })
            });
            const result = await response.json();
            if (result.success) {
                window.location.href = '/user-account';
            } else {
                alert(result.error || "Verification failed");
            }
        } catch (err) {
            console.error(err);
        }
    });
</script>