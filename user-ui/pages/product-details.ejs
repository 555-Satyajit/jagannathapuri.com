<% let rawSpecs=[]; if (product.specifications) { rawSpecs=typeof product.specifications==='string' ?
  JSON.parse(product.specifications) : product.specifications; } // Normalize into an object for easy template access
  let specs={}; if (Array.isArray(rawSpecs)) { rawSpecs.forEach(s=> {
  if (s.name && s.value) specs[s.name] = s.value;
  });
  } else {
  specs = rawSpecs || {};
  }

  const colorSpec = specs.Color || [];
  const sizeSpec = specs.Size || [];
  const colorList = Array.isArray(colorSpec) ? colorSpec : (colorSpec ? [colorSpec] : []);
  const sizeList = Array.isArray(sizeSpec) ? sizeSpec : (sizeSpec ? [sizeSpec] : []);
  %>
  <!-- SEO JSON-LD Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": "<%- product.product_name.replace(/"/g, '\\"') %>",
    "image": [
      <% if (product.images && product.images.length > 0) { %>
        <% product.images.forEach((img, index) => {
             let cleanImg = img.trim();
             let imgSrc = (cleanImg.startsWith('http') || cleanImg.startsWith('/')) ? cleanImg : '/uploads/' + cleanImg;
        %>
          "<%= imgSrc %>"<%= index < product.images.length - 1 ? ',' : '' %>
        <% }) %>
      <% } else { %>
        "/assets/images/logo.png"
      <% } %>
    ],
    "description": "<%- (product.description || '').replace(/(<([^>]+)>)/gi, '').replace(/"/g, '\\"').substring(0, 300) %>",
    "sku": "<%- product.sku %>",
    "brand": {
      "@type": "Brand",
      "name": "<%- product.product_brand ? product.product_brand.replace(/"/g, '\\"') : 'Jagannathapuri' %>"
    },
    "offers": {
      "@type": "Offer",
      "url": "https://jagannathapuri.com/product-details/<%- product.slug %>",
      "priceCurrency": "INR",
      "price": "<%- product.sale_price || product.regular_price || product.price_amount %>",
      "availability": "https://schema.org/<%- product.quantity > 0 || product.status === 1 ? 'InStock' : 'OutOfStock' %>",
      "itemCondition": "https://schema.org/NewCondition"
    }
    <% if (typeof averageRating !== 'undefined' && averageRating > 0 && typeof reviewsCount !== 'undefined' && reviewsCount > 0) { %>,
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "<%- averageRating %>",
      "reviewCount": "<%- reviewsCount %>"
    }
    <% } %>
  }
  </script>
  <!-- ========== Breadcrumb Section Start ========== -->
  <div class="py-12">
    <div class="container">
      <div class="breadcrumb">
        <ul>
          <li>
            <a href='/'>
              <span>
                <i class="hgi hgi-stroke hgi-home-01 text-[20px]"></i>
              </span>
              Home
            </a>
          </li>
          <li>
            <a href='/shop'>
              Shop
            </a>
          </li>
          <li class="text-light-disabled-text">&#8226;</li>
          <li><span>
              <%= product.product_name %>
            </span></li>
        </ul>
      </div>
    </div>
  </div>
  <!-- ========== Breadcrumb Section End ========== -->

  <!-- ========== Product Details Section Start ========== -->
  <section>
    <div class="container">
      <div class="lg:grid lg:grid-cols-12 lg:gap-12">
        <div class="xl:col-span-7 lg:col-span-6">
          <div class="flex gap-x-6 xl:flex-row flex-col gap-y-6 xl:gap-y-0 xl:gap-x-6">
            <div class="xl:w-[114px] lg:w-full order-2 xl:order-1 flex-none overflow-hidden">
              <div class="product-details-small-slider -m-2.5 jagannathapuri-slider"
                data-slick='{"slidesToShow": 6, "slidesToScroll": 1, "arrows": false, "infinite": true, "loop": true, "vertical": true, "verticalSwiping": true, "asNavFor": ".product-details-big-slider", "focusOnSelect": true, "responsive": [{"breakpoint": 1025, "settings": {"slidesToShow": 4, "vertical": false, "verticalSwiping": false}}, {"breakpoint": 769, "settings": {"slidesToShow": 3, "vertical": false, "verticalSwiping": false}}, {"breakpoint": 480, "settings": {"slidesToShow": 2, "vertical": false, "verticalSwiping": false}}]}'>
                <% if (product.images && product.images.length> 0) { %>
                  <% product.images.forEach(img=> {
                    let imgSrc = '/assets/images/logo.png';
                    if (img) {
                    let cleanImg = img.trim();
                    imgSrc = (cleanImg.startsWith('http') || cleanImg.startsWith('/')) ? cleanImg : '/uploads/' +
                    cleanImg;
                    }
                    %>
                    <div class="single-product-small-slider-item p-2.5 rounded-lg overflow-hidden">
                      <img src="<%= imgSrc %>" alt="<%= product.product_name %>"
                        class="w-full h-full object-cover rounded-lg" />
                    </div>
                    <% }) %>
                      <% } else { %>
                        <div class="single-product-small-slider-item p-2.5 rounded-lg overflow-hidden">
                          <img src="/assets/images/logo.png" alt="placeholder"
                            class="w-full h-full object-cover rounded-lg" />
                        </div>
                        <% } %>
              </div>
            </div>
            <div class="w-full xl:flex-1 order-1 xl:order-2 overflow-hidden relative">
              <div class="product-details-big-slider -mx-3 jagannathapuri-slider"
                data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "arrows": true, "asNavFor": ".product-details-small-slider", "appendArrows": ".product-details-big-slider-nav", "responsive": [{"breakpoint": 769, "settings": {"slidesToShow": 1, "arrows": false}}]}'>
                <% if (product.images && product.images.length> 0) { %>
                  <% product.images.forEach(img=> {
                    let imgSrc = '/assets/images/logo.png';
                    if (img) {
                    let cleanImg = img.trim();
                    imgSrc = (cleanImg.startsWith('http') || cleanImg.startsWith('/')) ? cleanImg : '/uploads/' +
                    cleanImg;
                    }
                    %>
                    <div class="single-product-big-slider-item px-3 rounded-2xl overflow-hidden">
                      <img src="<%= imgSrc %>" alt="<%= product.product_name %>"
                        class="w-full h-full object-cover rounded-3xl" />
                    </div>
                    <% }) %>
                      <% } else { %>
                        <div class="single-product-big-slider-item px-3 rounded-2xl overflow-hidden">
                          <img src="/assets/images/logo.png" alt="placeholder"
                            class="w-full h-full object-cover rounded-3xl" />
                        </div>
                        <% } %>
              </div>
              <div
                class="product-details-big-slider-nav absolute top-1/2 -translate-y-1/2 left-0 right-0 flex items-center justify-between px-3">
              </div>
            </div>
          </div>
        </div>
        <div class="xl:col-span-5 lg:col-span-6 mt-6 lg:mt-0">
          <div class="rounded-3xl border border-gray-300 p-6">
            <% if (product.on_sale) { %>
              <span
                class="product-discount-badge inline-block mb-6 uppercase relative bg-error text-warning-lighter font-medium text-sm leading-[22px] px-1 after:absolute after:top-0 after:left-full after:z-10 after:w-1 after:h-full after:bg-[url('/assets/images/discount-shape.png')] after:bg-contain after:bg-no-repeat">Sales</span>
              <% } %>
                <p class="uppercase text-info text-xs leading-[18px] font-bold new-arrival-badge mb-6">
                  New Arrival
                </p>
                <div class="product-title-section flex items-center justify-between mb-6">
                  <h3 class="line-clamp-1">
                    <%= product.product_name %>
                  </h3>
                  <button
                    class='wishlist-btn size-10 inline-flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300'
                    onclick="addToWishlist(<%= product.id %>)" data-product-id="<%= product.id %>">
                    <i
                      class="bx text-xl <%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product.id)) ? 'bxs-heart text-error' : 'bx-heart text-light-secondary-text' %>"></i>
                  </button>
                </div>
                <div class="rating-section flex items-center mb-4">
                  <div class="flex text-yellow-400">
                    <% for(let i=1; i <=5; i++) { %>
                      <i class="bx <%= i <= Math.round(averageRating) ? 'bxs-star' : 'bx-star' %> text-lg"></i>
                      <% } %>
                  </div>
                  <span class="font-normal inline-block ml-2 text-gray-500">(<%= averageRating %> Rating)</span>
                </div>
                <div class="price-section flex items-center gap-x-3 mb-6">
                  <% if (product.on_sale && product.sale_price && product.regular_price) { %>
                    <span
                      class="current-price text-2xl leading-9 font-bold text-light-primary-text relative after:absolute after:h-6 after:w-px after:bg-gray-300 after:right-0 after:top-1/2 after:-translate-y-1/2 pr-3 inline-block">
                      ₹<%= product.sale_price %>
                    </span>
                    <span class="old-price text-2xl leading-9 font-normal text-light-disabled-text line-through">
                      ₹<%= product.regular_price %>
                    </span>
                    <% let discount=Math.round(((product.regular_price - product.sale_price) / product.regular_price) *
                      100); %>
                      <span
                        class="product-discount-badge uppercase relative bg-error text-warning-lighter font-medium text-sm leading-[22px] px-1 after:absolute after:top-0 after:left-full after:z-10 after:w-1 after:h-full after:bg-[url('/assets/images/discount-shape.png')] after:bg-contain after:bg-no-repeat">
                        <%= discount %>% OFF
                      </span>
                      <% } else { %>
                        <span class="current-price text-2xl leading-9 font-bold text-light-primary-text">
                          ₹<%= product.regular_price || product.price_amount %>
                        </span>
                        <% } %>
                </div>
                <div class="product-add-to-cart-section py-6 border-b border-dashed border-gray-300 border-t">
                  <% if (colorList.length> 0) { %>
                    <div class="color-variation-section mb-6">
                      <div class="color-variation-section-title mb-4">
                        <p class="font-semibold text-light-primary-text flex items-center gap-x-2.5">
                          Color:
                          <span class="text-light-primary-text font-normal capitalize color-variation-selected-color">
                            <%= colorList[0] %>
                          </span>
                        </p>
                      </div>
                      <div class="color-variation-items flex items-center gap-x-2">
                        <% colorList.forEach((color, index)=> { %>
                          <div class="color-variation-item">
                            <button data-color-text="<%= color %>" data-color="<%= color %>"
                              class="cursor-pointer flex items-center justify-center rounded-full size-10 border <%= index === 0 ? 'border-primary' : 'border-gray-300' %> hover:bg-[rgba(145,158,171,0.08)]">
                              <span class="size-6 rounded-full border border-gray-200"
                                style="background-color: <%= color.toLowerCase() %>;"></span>
                            </button>
                          </div>
                          <% }) %>
                      </div>
                    </div>
                    <% } %>
                      <% if (sizeList.length> 0) { %>
                        <div class="size-variation-section mb-6">
                          <div class="size-variation-section-title mb-4 flex items-center justify-between">
                            <p class="font-semibold text-light-primary-text flex items-center gap-x-2.5">
                              Size:
                              <span class="text-light-primary-text font-normal capitalize size-variation-selected-size">
                                <%= sizeList[0] %>
                              </span>
                            </p>
                          </div>
                          <div class="size-variation-items flex items-center gap-2 2xl:flex-nowrap flex-wrap">
                            <% sizeList.forEach((size, index)=> { %>
                              <div class="size-variation-item">
                                <button data-size-text="<%= size %>"
                                  class="cursor-pointer flex items-center justify-center text-sm leading-6 px-4 py-1.5 font-semibold border <%= index === 0 ? 'border-primary bg-primary text-white' : 'border-gray-300 text-light-primary-text' %> rounded-[100px] hover:bg-primary hover:text-white transition-all">
                                  <%= size %>
                                </button>
                              </div>
                              <% }) %>
                          </div>
                        </div>
                        <% } %>
                          <div class="product-add-to-cart-btn-section">
                            <p class="font-semibold text-light-primary-text mb-4">
                              Quantity:
                            </p>
                            <div
                              class="flex items-center justify-between gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0">
                              <div
                                class="quantity-section flex-1 max-w-[185px] border border-gray-300 rounded-[80px] px-4 py-[11px] flex items-center justify-between">
                                <button class="quantity-btn inline-flex items-center justify-center hover:text-primary">
                                  <i class="hgi hgi-stroke hgi-minus-sign text-xl leading-5"></i>
                                </button>
                                <input type="text"
                                  class="quantity-input text-center w-full focus:outline-none font-semibold text-base leading-6 text-light-primary-text"
                                  value="1" />
                                <button class="quantity-btn inline-flex items-center justify-center hover:text-primary">
                                  <i class="hgi hgi-stroke hgi-plus-sign text-xl leading-5"></i>
                                </button>
                              </div>
                              <button class="btn btn-warning btn-large rounded-[80px] flex-1 buy-now-btn"
                                data-product-id="<%= product.id %>">
                                Buy Now
                              </button>
                              <button class="btn btn-primary btn-large rounded-[80px] flex-1 add-to-cart-btn"
                                data-product-id="<%= product.id %>">
                                <i class="hgi hgi-stroke hgi-shopping-cart-add-02 leading-6 text-2xl text-white"></i>
                                Add to Cart
                              </button>
                            </div>
                          </div>
                </div>
                <div class="product-share-and-compare-section flex items-center gap-x-4 mt-6">
                  <a href="#" class="product-share-btn text-info inline-flex items-center gap-x-2.5">
                    <i class="hgi hgi-stroke hgi-share-05 text-xl leading-5"></i>
                    <span>Share</span>
                  </a>
                </div>
                <div class="product-extra-info-section flex flex-col gap-y-4 mt-6">
                  <div
                    class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0">
                    <p class="font-semibold text-light-primary-text">
                      Free Shipping:
                    </p>
                    <p>Estimated Delivery Time 5-7 Days</p>
                  </div>
                  <div
                    class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0">
                    <p class="font-semibold text-light-primary-text">SKU:</p>
                    <p>
                      <%= product.sku %>
                    </p>
                  </div>
                  <div
                    class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0">
                    <p class="font-semibold text-light-primary-text">
                      Categories:
                    </p>
                    <p>
                      <%= product.category.name %>
                    </p>
                  </div>
                </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ========== Product Details Section End ========== -->

  <!-- ========== CTA Info Section Start ========== -->
  <section class="py-12">
    <div class="container">
      <div class="grid grid-cols-12 gap-6">
        <div class="md:col-span-6 col-span-12 xl:col-span-3">
          <div class="p-6 border-gray-300 border rounded-2xl text-center wow animate__animated animate__fadeInUp"
            data-wow-delay=".2s">
