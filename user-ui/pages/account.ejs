<script id="customer-data" type="application/json">
 <%- JSON.stringify(customer || {}) %>
</script>

<script>
  // Data Injection
  let customerData = { addresses: [] };
  try {
    const dataElement = document.getElementById('customer-data');
    if (dataElement && dataElement.textContent.trim()) {
      customerData = JSON.parse(dataElement.textContent);

    }
  } catch (e) {
    console.error('Error parsing customer data:', e);
  }

  // Tab Handling
  document.querySelectorAll('[data-tab]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = btn.dataset.tab;
      if (target === 'logout') return; // Let default action occur if it's a link or handle logout here

      // If it's a filter tab (all, processing, etc.)
      if (['all', 'processing', 'delivering', 'completed', 'cancelled'].includes(target)) {
        filterOrders(target);
        // Update active state of buttons
        document.querySelectorAll('.order-history-product-filter button').forEach(b => {
          if (b.dataset.tab === target) {
            b.classList.add('bg-primary/8', 'text-primary');
            b.classList.remove('text-light-primary-text');
          } else {
            b.classList.remove('bg-primary/8', 'text-primary');
            b.classList.add('text-light-primary-text');
          }
        });
      } else {
        // Main filter tabs
        document.querySelectorAll('.menu-tab-pane').forEach(pane => pane.classList.add('hidden'));
        const activePane = document.getElementById(target);
        if (activePane) activePane.classList.remove('hidden');

        // Update Sidebar
        document.querySelectorAll('.my-account-menu button').forEach(b => {
          b.classList.remove('text-white', 'bg-primary'); // Remove active style
          if (b.dataset.tab === target) {
            b.classList.add('text-white', 'bg-primary');
          }
        });

        // Update Breadcrumb
        const breadcrumb = document.getElementById('breadcrumb-current');
        if (breadcrumb) {
          breadcrumb.innerText = btn.innerText.trim();
        }
      }
    });
  });

  // Global Click listener for action buttons (Event Delegation)
  document.addEventListener('click', (e) => {
    // Address Back/Cancel buttons
    if (e.target.closest('[data-action="back-address"]')) {
      showAddressList();
    }
    
    // Add New Address button
    if (e.target.closest('#js-add-address-btn')) {
      openAddAddress();
    }

    // Edit Address button
    const editBtn = e.target.closest('.js-edit-address');
    if (editBtn) {
      openEditAddress(editBtn.dataset.id);
    }

    // Delete Address button
    const delBtn = e.target.closest('.js-delete-address');
    if (delBtn) {
      deleteAddress(delBtn.dataset.id);
    }

    // Wishlist Remove button
    const wishRemBtn = e.target.closest('.js-remove-wishlist');
    if (wishRemBtn) {
      removeFromWishlist(wishRemBtn.dataset.id);
    }

    // Save Add Address
    if (e.target.closest('#js-save-add-address')) {
      submitAddAddress();
    }
    
    // Save Edit Address
    if (e.target.closest('#js-save-edit-address')) {
      submitEditAddress();
    }
    
    // Order Details Back button
    if (e.target.closest('.js-order-details-back')) {
      showOrderList();
    }
  });

  // Profile Form Listener
  const profileForm = document.getElementById('profile-form');
  if (profileForm) {
    profileForm.addEventListener('submit', (e) => {
      e.preventDefault();
      updateProfile();
    });
  }

  // Password Form Listener
  const passwordForm = document.getElementById('password-form');
  if (passwordForm) {
    passwordForm.addEventListener('submit', (e) => {
      e.preventDefault();
      submitChangePassword();
    });
  }

  // Initialize Default Tab
  window.addEventListener('load', () => {
    let defaultTab = 'dashboard';

    // Check URL hash for tab activation (e.g., #orders)
    if (window.location.hash) {
      const hashTab = window.location.hash.replace('#', '');
      const hashBtn = document.querySelector(`.my-account-menu button[data-tab="${hashTab}"]`);
      if (hashBtn) {
        defaultTab = hashTab;
      }
    }

    const activeBtn = document.querySelector(`.my-account-menu button[data-tab="${defaultTab}"]`);
    if (activeBtn) activeBtn.click();
    
    // Initialize Pagination
    initPagination();
  });

  function filterOrders(status) {
    const items = document.querySelectorAll('.order-item');
    items.forEach(item => {
      if (status === 'all' || item.dataset.status === status) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  }



  // Address Handling
  function showAddressList() {
    document.getElementById('address').classList.remove('hidden');
    document.getElementById('add-address').classList.add('hidden');
    document.getElementById('edit-address').classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function openAddAddress() {
    document.getElementById('address').classList.add('hidden');
    document.getElementById('add-address').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function submitAddAddress() {
    const typeInput = document.querySelector('input[name="add_type"]:checked');
    if (!typeInput) return Swal.fire({ icon: 'warning', text: 'Please select address type' });
    
    const data = {
      type: typeInput.value,
      country: document.getElementById('add_country').value,
      addressLine1: document.getElementById('add_street').value,
      city: document.getElementById('add_city').value,
      state: document.getElementById('add_state').value,
      zipCode: document.getElementById('add_zip').value,
      phone: document.getElementById('add_phone').value
    };

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

    fetch('/user-address-add', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'x-csrf-token': csrfToken || ''
      },
      body: JSON.stringify(data)
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({ icon: 'success', text: 'Address added successfully', showConfirmButton: false, timer: 1500 })
            .then(() => location.reload());
        } else {
          Swal.fire({ icon: 'error', text: 'Error adding address: ' + (data.error || 'Unknown error') });
        }
      })
      .catch(err => Swal.fire({ icon: 'error', text: 'Error: ' + err.message }));
  }

  function openEditAddress(id) {
    const address = customerData.addresses.find(a => a.id == id);
    if (!address) return;

    document.getElementById('edit_id').value = address.id;
    document.getElementById('edit_country').value = address.country || 'India';
    document.getElementById('edit_street').value = address.addressLine1 || '';
    document.getElementById('edit_city').value = address.city || '';
    document.getElementById('edit_state').value = address.state || '';
    document.getElementById('edit_zip').value = address.zipCode || '';
    document.getElementById('edit_phone').value = address.phone || '';

    // Radio
    const radios = document.getElementsByName('edit_type');
    for (let r of radios) {
      if (r.value === address.type) r.checked = true;
    }

    document.getElementById('address').classList.add('hidden');
    document.getElementById('edit-address').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function submitEditAddress() {
    const id = document.getElementById('edit_id').value;
    const typeInput = document.querySelector('input[name="edit_type"]:checked');
    if (!typeInput) return Swal.fire({ icon: 'warning', text: 'Please select address type' });

    const data = {
      type: typeInput.value,
      country: document.getElementById('edit_country').value,
      addressLine1: document.getElementById('edit_street').value,
      city: document.getElementById('edit_city').value,
      state: document.getElementById('edit_state').value,
      zipCode: document.getElementById('edit_zip').value,
      phone: document.getElementById('edit_phone').value
    };

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

    fetch(`/user-address-edit/${id}`, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'x-csrf-token': csrfToken || ''
      },
      body: JSON.stringify(data)
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({ icon: 'success', text: 'Address updated successfully', showConfirmButton: false, timer: 1500 })
            .then(() => location.reload());
        } else {
          Swal.fire({ icon: 'error', text: 'Error updating address: ' + (data.error || 'Unknown error') });
        }
      })
      .catch(err => Swal.fire({ icon: 'error', text: 'Error: ' + err.message }));
  }

  function deleteAddress(id) {
    Swal.fire({
      title: 'Are you sure?',
      text: "You won't be able to revert this!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#088178',
      cancelButtonColor: '#d33',
      confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
      if (result.isConfirmed) {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        
        fetch(`/user-address-delete/${id}`, {
          method: 'POST',
          headers: {
            'x-csrf-token': csrfToken || ''
          }
        })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire({ icon: 'success', text: 'Deleted!', showConfirmButton: false, timer: 1500 })
                .then(() => location.reload());
            } else {
              Swal.fire({ icon: 'error', text: 'Error deleting address: ' + (data.error || 'Unknown error') });
            }
          })
          .catch(err => Swal.fire({ icon: 'error', text: 'Error: ' + err.message }));
      }
    });
  }

  function updateProfile() {
    const data = {
      fullName: document.getElementById('profile_fullname').value,
      phone: document.getElementById('profile_phone').value
    };
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

    fetch('/user-update-profile', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'x-csrf-token': csrfToken || ''
      },
      body: JSON.stringify(data)
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({ icon: 'success', text: 'Profile updated successfully', showConfirmButton: false, timer: 1500 })
            .then(() => location.reload());
        } else {
          Swal.fire({ icon: 'error', text: 'Error updating profile: ' + (data.error || 'Unknown error') });
        }
      })
      .catch(err => Swal.fire({ icon: 'error', text: 'Error: ' + err.message }));
  }

  function removeFromWishlist(productId) {
    Swal.fire({
      title: 'Remove from Wishlist?',
      text: "Are you sure you want to remove this item?",
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#088178',
      cancelButtonColor: '#d33',
      confirmButtonText: 'Yes, remove it!'
    }).then((result) => {
      if (result.isConfirmed) {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

        fetch(`/user-wishlist-remove/${productId}`, {
          method: 'POST',
          headers: {
            'x-csrf-token': csrfToken || ''
          }
        })
          .then(res => res.json())
          .then(data => {
            if (data.success) location.reload();
            else Swal.fire({ icon: 'error', text: 'Error: ' + (data.error || 'Unknown error') });
          })
          .catch(err => Swal.fire({ icon: 'error', text: 'Error: ' + err.message }));
      }
    });
  }

  // Pagination Logic
  const ITEMS_per_PAGE = 5;
  let currentPage = 1;

  function initPagination() {
    const items = document.querySelectorAll('.order-item');
    const totalItems = items.length;
    const totalPages = Math.ceil(totalItems / ITEMS_per_PAGE);

    if (totalPages <= 1) {
      document.getElementById('orders-pagination').classList.add('hidden');
      items.forEach(item => item.classList.remove('hidden'));
      return;
    }

    renderPaginationControls(totalPages);
    showPage(1);
  }

  function renderPaginationControls(totalPages) {
    const container = document.getElementById('orders-pagination');
    container.classList.remove('hidden');
    container.innerHTML = '';

    // Prev
    const prevBtn = document.createElement('button');
    prevBtn.innerHTML = '<i class="hgi hgi-stroke hgi-arrow-left-01"></i>';
    prevBtn.className = `w-10 h-10 flex items-center justify-center rounded-full border ${currentPage === 1 ? 'text-gray-300 border-gray-200 cursor-not-allowed' : 'text-primary border-primary hover:bg-primary hover:text-white'} transition-all`;
    prevBtn.onclick = () => { if (currentPage > 1) showPage(currentPage - 1); };
    container.appendChild(prevBtn);

    // Pages
    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('button');
      btn.innerText = i;
      btn.className = `w-10 h-10 flex items-center justify-center rounded-full border ${currentPage === i ? 'bg-primary text-white border-primary' : 'text-gray-500 border-gray-200 hover:border-primary hover:text-primary'} transition-all font-medium`;
      btn.onclick = () => showPage(i);
      container.appendChild(btn);
    }

    // Next
    const nextBtn = document.createElement('button');
    nextBtn.innerHTML = '<i class="hgi hgi-stroke hgi-arrow-right-01"></i>';
    nextBtn.className = `w-10 h-10 flex items-center justify-center rounded-full border ${currentPage === totalPages ? 'text-gray-300 border-gray-200 cursor-not-allowed' : 'text-primary border-primary hover:bg-primary hover:text-white'} transition-all`;
    nextBtn.onclick = () => { if (currentPage < totalPages) showPage(currentPage + 1); };
    container.appendChild(nextBtn);
  }

  function showPage(page) {
    currentPage = page;
    const items = Array.from(document.querySelectorAll('.order-item'));
    // Filter functionality might hide items, we should only paginate visible items
    // But for simplicity in this implementation we paginate all items in the 'All' tab
    // If we want to combine filter + pagination, we need to re-run pagination on filter.

    const visibleItems = items; // Assuming 'All' tab for now mainly.

    const start = (page - 1) * ITEMS_per_PAGE;
    const end = start + ITEMS_per_PAGE;

    items.forEach((item, index) => {
      if (index >= start && index < end) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });

    // Re-render controls to update active state
    const totalPages = Math.ceil(items.length / ITEMS_per_PAGE);
    renderPaginationControls(totalPages);
  }

  // Hook into load and filter
  window.addEventListener('load', () => {
    initPagination();
  });

  // Note: If you use the filter tabs (Processing, Delivered etc), standard pagination might break 
  // because it tries to show 5 items of *all* items. 
  // For a robust solution, we should re-calculate visible items based on filter.

  const originalFilterOrders = filterOrders;
  filterOrders = function (status) {
    const items = document.querySelectorAll('.order-item');
    let visibleCount = 0;
    items.forEach(item => {
      // Reset hidden first to check data-status
      const matches = (status === 'all' || item.dataset.status === status);
      if (matches) {
        item.dataset.filtered = 'true'; // Mark as visible for pagination
        visibleCount++;
      } else {
        item.dataset.filtered = 'false';
        item.classList.add('hidden');
      }
    });

    // Re-initialize pagination based on filtered items
    // This requires a slightly more complex showPage using data-filtered
    // For this task, simplest is to disable pagination on filters or re-implement logic.
    // Let's keep it simple: Pagination primarily for 'All' tab.
    if (status !== 'all') {
      document.getElementById('orders-pagination').classList.add('hidden');
      items.forEach(item => {
        if (item.dataset.filtered === 'false') item.classList.add('hidden');
        else item.classList.remove('hidden');
      });
    } else {
      initPagination(); // Reset for all
    }

    // Update active state of buttons logic is same...
    document.querySelectorAll('.order-history-product-filter button').forEach(b => {
      if (b.dataset.tab === status) {
        b.classList.add('bg-primary/8', 'text-primary');
        b.classList.remove('text-light-primary-text');
      } else {
        b.classList.remove('bg-primary/8', 'text-primary');
        b.classList.add('text-light-primary-text');
      }
    });
  };

  function submitChangePassword() {
    const currentPasswordInput = document.getElementById('current_password');
    const currentPassword = currentPasswordInput ? currentPasswordInput.value : '';
    const newPassword = document.getElementById('new_password_input').value;
    const confirmPassword = document.getElementById('confirm_new_password_input').value;

    if (newPassword !== confirmPassword) {
      return Swal.fire({ icon: 'error', text: 'New passwords do not match' });
    }
    if (!newPassword) {
      return Swal.fire({ icon: 'warning', text: 'Please enter a new password' });
    }

    const data = { currentPassword, newPassword };

    fetch('/user-change-password', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'x-csrf-token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      },
      body: JSON.stringify(data)
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({ icon: 'success', text: 'Password changed successfully', showConfirmButton: false, timer: 1500 })
            .then(() => location.reload());
        } else {
          Swal.fire({ icon: 'error', text: 'Error: ' + (data.error || 'Unknown error') });
        }
      })
      .catch(err => Swal.fire({ icon: 'error', text: 'Error: ' + err.message }));
  }

  function showOrderList() {
    document.querySelectorAll('.menu-tab-pane').forEach(p => p.classList.add('hidden'));
    document.getElementById('orders').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  function downloadInvoice(orderId, btn) {
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="inline-flex items-center gap-x-2"><i class="bx bx-loader-alt bx-spin"></i> Generating...</span>';
    btn.disabled = true;
    btn.classList.add('opacity-75', 'cursor-not-allowed');

    fetch(`/user-invoice/${orderId}`)
      .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.blob();
      })
      .then(blob => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.style.display = 'none';
        a.href = url;
        // filename is determined by Content-Disposition, but we can set a default if needed
        // or just let the browser handle it. To force name we can guess:
        a.download = `invoice-${orderId}.pdf`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);

        // Restore button state
        btn.innerHTML = '<span class="inline-flex items-center gap-x-2"><i class="hgi hgi-stroke hgi-download-01 text-xl"></i> Downloaded</span>';
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
          btn.classList.remove('opacity-75', 'cursor-not-allowed');
        }, 3000);
      })
      .catch(error => {
        console.error('Error downloading invoice:', error);
        Swal.fire({ icon: 'error', text: 'Failed to download invoice. Please try again.' });
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-75', 'cursor-not-allowed');
      });
  }
</script>