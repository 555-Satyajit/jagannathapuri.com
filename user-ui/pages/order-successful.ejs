      <div class="container">
        <div class="grid grid-cols-12 gap-6">
          <div class="md:col-span-6 col-span-12 xl:col-span-3">
            <div class="p-6 border-gray-300 border rounded-2xl text-center wow animate__animated animate__fadeInUp"
              data-wow-delay=".2s">
