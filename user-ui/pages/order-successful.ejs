<!-- ========== PAYMENT Section Start ========== -->
<div>
  <div class="container">
    <div class="grid grid-cols-12 gap-x-6 gap-y-6">
      <!-- Address part -->
      <div class="xl:col-span-8 col-span-12">
        <div class="flex flex-col gap-y-6">
          <!-- Address -->
          <div class="border border-gray-300 rounded-2xl">
            <div class="py-4 px-6 bg-gray-200 rounded-t-2xl">
              <h5>Order Details</h5>
            </div>
            <!-- Home-Address-details -->
            <div class="md:px-6 px-3 py-6">
              <ul class="flex flex-col gap-y-4">
                <li class="flex items-center justify-between">
                  <p class="text-light-primary-text font-normal inline-flex items-center gap-x-4">
                    <span class="inline-flex items-center justify-center"><i
                        class="hgi hgi-stroke hgi-delivery-box-01 text-2xl leading-6"></i></span>Order ID
                  </p>
                  <span class="font-semibold text-light-primary-text">#<%= order.orderNumber %></span>
                </li>
                <li class="flex items-center justify-between">
                  <p class="text-light-primary-text font-normal inline-flex items-center gap-x-4">
                    <span class="inline-flex items-center justify-center"><i
                        class="hgi hgi-stroke hgi-delivery-box-01 text-2xl leading-6"></i></span>Order status
                  </p>
                  <button
                    class="text-[12px] leading-[18px] rounded-md font-normal px-2 py-[7px] text-warning-dark bg-[rgba(255,193,7,0.16)]">
                    <%= order.status===1 ? 'Received' : 'Processing' %>
                  </button>
                </li>
                <li class="flex items-center justify-between">
                  <p class="text-light-primary-text font-normal inline-flex items-center gap-x-4">
                    <span class="inline-flex items-center justify-center"><i
                        class="hgi hgi-stroke hgi-payment-success-01 text-2xl leading-6"></i></span>Amount Payable
                  </p>
                  <p class="font-semibold text-light-primary-text">
                    ₹<%= order.totalAmount.toFixed(2) %><span
                        class="<%= order.paymentStatus === 1 ? 'text-primary' : 'text-warning' %> ml-0.5">(<%=
                          order.paymentStatus===1 ? 'Paid' : 'Pending' %>)</span>
                  </p>
                </li>
                <li class="flex items-center justify-between">
                  <p class="text-light-primary-text font-normal inline-flex items-center gap-x-4">
                    <span class="inline-flex items-center justify-center"><i
                        class="hgi hgi-stroke hgi-calendar-03 text-2xl leading-6"></i></span>Order Date:
                  </p>
                  <span class="font-semibold text-light-primary-text">
                    <%= (order.created_at || order.date).toLocaleString() %>
                  </span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Shipping Address -->
          <div class="border border-gray-300 rounded-2xl">
            <div class="py-4 px-6 bg-gray-200 rounded-t-2xl">
              <h5 class="text-light-primary-text">Shipment Address</h5>
            </div>
            <!-- Shipping Home Address-details -->
            <div class="md:px-6 px-3 py-6">
              <ul class="flex flex-col gap-y-5">
                <li class="flex items-center gap-x-3 text-light-primary-text">
                  <span class="inline-flex items-center justify-center"><i
                      class="hgi hgi-stroke hgi-user-square text-2xl leading-6"></i></span>
                  <%= order.customer.fullName %>
                </li>
                <li class="flex items-center gap-x-3 text-light-primary-text">
                  <span class="inline-flex items-center justify-center"><i
                      class="hgi hgi-stroke hgi-call text-2xl leading-6"></i></span>
                  <%= order.customer.phone %>
                </li>
                <li class="flex items-center gap-x-3 text-light-primary-text">
                  <span class="inline-flex items-center justify-center"><i
                      class="hgi hgi-stroke hgi-mail-01 text-2xl leading-6"></i></span>
                  <%= order.customer.email %>
                </li>
                <li class="flex items-center gap-x-3 text-light-primary-text">
                  <span class="inline-flex items-center justify-center"><i
                      class="hgi hgi-stroke hgi-location-06 text-2xl leading-6"></i></span>
                  <%= order.shippingAddress.addressLine1 %>, <%= order.shippingAddress.city %>, <%=
                        order.shippingAddress.state %>, <%= order.shippingAddress.zipCode %>, <%=
                            order.shippingAddress.country %>
                </li>
                <li class="flex items-center gap-x-3 text-light-primary-text">
                  <span class="inline-flex items-center justify-center"><i
                      class="hgi hgi-stroke hgi-cargo-ship text-2xl leading-6"></i></span>
                  <%= order.shippingFee> 0 ? 'Flat Rate Shipment' : 'Free Delivery' %>
                </li>
              </ul>
            </div>
          </div>
          <!-- Feedback -->
          <div class="border border-gray-300 rounded-2xl">
            <div class="md:px-6 px-4 py-6">
              <h5 class="mb-6">Give us a feedback</h5>
              <form id="feedback-form" action="/api/submit-feedback" method="POST" class="flex flex-col gap-y-6">
                <div>
                  <textarea id="message" name="message"
                    class="peer form-control input-group medium rounded-[20px] ps-4 pe-6 resize-none placeholder-transparent focus:placeholder-transparent focus:outline-none"
                    rows="4" placeholder="Write Something..." required></textarea>
                  <label for="message"
                    class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-focus:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-6 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 peer-[:not(:placeholder-shown)]:bg-white peer-focus:bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1">
                    Write Something...
                  </label>
                </div>
                <div class="relative w-full">
                  <input id="name" name="name" type="text"
                    class="peer form-control input-group medium rounded-[80px] px-3.5 placeholder-transparent focus:placeholder-transparent focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                    placeholder="Name *" value="<%= customer ? customer.fullName : '' %>" required />
                  <label for="name"
                    class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-focus:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-1/2 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 peer-[:not(:placeholder-shown)]:bg-white peer-focus:bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1">
                    Name *
                  </label>
                </div>
                <div class="relative w-full">
                  <input id="email" name="email" type="email"
                    class="peer form-control input-group medium rounded-[80px] px-3.5 placeholder-transparent focus:placeholder-transparent focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                    placeholder="Email *" value="<%= customer ? customer.email : '' %>" required />
                  <label for="email"
                    class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-focus:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-1/2 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 peer-[:not(:placeholder-shown)]:bg-white peer-focus:bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1">
                    Email *
                  </label>
                </div>
                <button type="submit" class="btn btn-primary btn-large rounded-[80px] px-[35px] py-[11px] w-full md:w-auto">
                  Send Now
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Cart items part -->
      <div class="xl:col-span-4 col-span-12">
            <div class="border border-gray-300 rounded-2xl md:px-6 px-3 py-6 flex flex-col gap-y-6">
              <!-- cart-items -->
              <h5>Cart Items</h5>
              <div class="border border-gray-300 rounded-xl overflow-x-auto">
                <table class="w-full cart-items-table">
                  <tbody class="space-y-6">
                    <% order.items.forEach(item=> { %>
                      <tr>
                        <td class="py-4 px-4 product-thumbnail">
                          <div class="w-[60px] h-[60px] rounded-xl bg-[#F4F3F5] overflow-hidden">
                            <% let image='/assets/images/logo.png' ; if (item.product.images &&
                              item.product.images.length>
                              0) {
                              const img = item.product.images[0].trim();
                              image = (img.startsWith('http') || img.startsWith('/')) ? img : '/uploads/' + img;
                              }
                              %>
                              <img src="<%= image %>" alt="<%= item.product.product_name %>"
                                class="w-full h-full object-cover rounded-xl" />
                          </div>
                        </td>
                        <td class="py-4 md:pr-4 pr-2 align-bottom w-full">
                          <div class="flex flex-col gap-y-2">
                            <a class='text-light-primary-text font-semibold truncate hover:text-primary transition-colors duration-300 product-title'
                              href='/product-details/<%= item.product.slug %>'>
                              <%= item.product.product_name %>
                            </a>
                            <div class="flex items-center justify-between">
                              <p
                                class="text-sm leading-[22px] font-normal text-light-secondary-text cart-item-quantity">
                                <%= item.quantity %> x ₹<%= item.price.toFixed(2) %>
                              </p>
                              <div class="flex items-center gap-x-1.5">
                                <span class="text-primary font-semibold product-offer-price">₹<%= (item.price *
                                    item.quantity).toFixed(2) %></span>
                              </div>
                            </div>
                          </div>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                </table>
              </div>
              <!-- order-summary -->
              <div class="bg-gray-100 md:px-6 px-4 py-6 rounded-2xl">
                <div class="flex flex-col gap-y-6">
                  <h5>Order Summary</h5>
                  <!-- total -->
                  <div>
                    <div class="flex flex-col gap-y-4 pb-4 border-b border-gray-300">
                      <p class="flex items-center justify-between">
                        Sub-Total<span class="text-gray-900">₹<%= order.subtotal.toFixed(2) %></span>
                      </p>
                      <p class="flex items-center justify-between">
                        Shipment<span class="text-gray-900">₹<%= order.shippingFee.toFixed(2) %></span>
                      </p>
                      <p class="flex items-center justify-between">
                        Tax<span class="text-gray-900">₹<%= order.tax.toFixed(2) %></span>
                      </p>
                    </div>
                    <h6 class="flex items-center justify-between text-light-primary-text pt-4">
                      Total<span class="text-gray-900">₹<%= order.totalAmount.toFixed(2) %></span>
                    </h6>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ========== PAYMENT Section End ========== -->

    <!-- ========== CTA Info Section Start ========== -->
