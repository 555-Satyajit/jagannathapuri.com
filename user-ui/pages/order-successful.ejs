    <!-- ========== Recently Viewed Products Section Start ========== -->
    <section class="pb-[70px]">
      <div class="container">
        <div class="flex items-center md:justify-between justify-center mb-10 wow animate__animated animate__fadeInUp"
          data-wow-delay="0.2s">
          <div>
            <h3 class="text-light-primary-text">Recently Viewed</h3>
          </div>
          <div class="new-branded-products-multi-vendor-nav md:flex items-center justify-center gap-x-6 hidden"></div>
        </div>
        <div class="new-branded-product-multi-vendor-slider-wrapper">
          <div
            data-slick='{ "slidesToShow": 5, "slidesToScroll": 1, "loop": true, "autoplay": true, "autoplaySpeed": 7000, "arrows": true, "infinite": true, 
          "appendArrows": ".new-branded-products-multi-vendor-nav", "responsive": [{"breakpoint": 1441, "settings": {"slidesToShow": 4}}, {"breakpoint": 1025, "settings": {"slidesToShow": 3}}, {"breakpoint": 769, "settings": {"slidesToShow": 2}}, {"breakpoint": 480, "settings": {"slidesToShow": 1}}]}'
            class="new-branded-product-multi-vendor-slider -mx-3 jagannathapuri-slider">
            <% if (recentlyViewed && recentlyViewed.length> 0) { %>
              <% recentlyViewed.forEach((p, idx)=> { %>
                <div
                  class="border border-gray-300 rounded-2xl product-card-1 p-4 group mx-3 wow animate__animated animate__fadeInUp"
                  data-wow-delay="<%= 0.2 + (idx * 0.1) %>s">
                  <div class="product-image-container relative">
                    <div class="product-image rounded-xl bg-[#F4F3F5] mb-4 overflow-hidden">
                      <a href='/product-details/<%= p.slug %>'>
                        <% let pImg='/assets/images/logo.png' ; if (p.images && p.images.length> 0) {
                          const img = p.images[0].trim();
                          pImg = (img.startsWith('http') || img.startsWith('/')) ? img : '/uploads/' + img;
                          } %>
                          <img src="<%= pImg %>" alt="<%= p.product_name %>"
                            class="group-hover:scale-110 transition-all transform group-hover:-rotate-3 ease-in-out duration-300" />
                      </a>
                    </div>
                    <% if (p.on_sale) { %>
                      <span
                        class="product-discount-badge absolute top-[11px] left-0 bg-error text-white font-normal text-sm leading-[22px] px-1 shadow-sm">SALE</span>
                      <% } %>
                  </div>

                  <div class="product-content">
                    <h5 class="text-base leading-6 font-semibold font-dm-sans mb-4 min-h-[48px]">
                      <a class='hover:text-primary transition-colors duration-300'
                        href='/product-details/<%= p.slug %>'>
                        <%= p.product_name %>
                      </a>
                    </h5>
                    <div class="price-section flex items-center gap-x-3 mb-2">
                      <span class="current-price text-base font-semibold text-light-primary-text">₹<%= (p.sale_price ||
                          p.price_amount).toFixed(2) %></span>
                      <% if (p.on_sale && p.regular_price) { %>
                        <span
                          class="old-price text-sm leading-[22px] font-normal text-light-disabled-text line-through">₹
                          <%= p.regular_price.toFixed(2) %></span>
                        <% } %>
                    </div>
                    <div class="btn-section mt-4">
                      <a class='btn btn-primary rounded-full font-semibold text-sm leading-6 px-6 py-2 w-full flex items-center justify-center gap-x-2'
                        href='/product-details/<%= p.slug %>'>
                        <i class="hgi hgi-stroke hgi-view text-xl"></i>
                        <span>View Product</span>
                      </a>
                    </div>
                  </div>
                </div>
                <% }) %>
                  <% } else { %>
                    <div class="col-span-12 py-10 text-center">
                      <p class="text-light-secondary-text italic">No recently viewed products yet.</p>
                    </div>
                    <% } %>
          </div>
        </div>
      </div>
    </section>
    <!-- ========== Recently Viewed Products Section End ========== -->


    <script>
      document.getElementById('feedback-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const submitBtn = form.querySelector('button[type="submit"]');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        const originalText = submitBtn.innerText;
        submitBtn.innerText = 'Sending...';
        submitBtn.disabled = true;

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (result.success) {
            Swal.fire({ icon: 'success', text: result.message });
            form.reset();
          } else {
            Swal.fire({ icon: 'error', text: result.message || 'Something went wrong' });
          }
        } catch (error) {
          console.error('Feedback error:', error);
          Swal.fire({ icon: 'error', text: 'Failed to send feedback. Please try again later.' });
        } finally {
          submitBtn.innerText = originalText;
          submitBtn.disabled = false;
        }
      });
    </script>
