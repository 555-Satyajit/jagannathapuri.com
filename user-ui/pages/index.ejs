<!-- ========== Hero Section Start ========== -->
<style>
  /* Force equal height for slick slider cards */
  .home-four-picks-slider .slick-track {
    display: flex !important;
  }

  .home-four-picks-slider .slick-slide {
    height: auto !important;
    display: flex !important;
  }

  .home-four-picks-slider .slick-slide>div {
    height: 100%;
    width: 100%;
  }

  .home-four-picks-slider .slick-slide>div>div {
    height: 100%;
  }
</style>
<section class="pt-6">
  <div class="container">
    <div class="relative">
      <div class="home-four-hero-slider rounded-3xl relative bg-transparent jagannathapuri-slider"
        data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "loop": true, "arrows": true, "infinite": true, "dots": true, "appendArrows": ".home-four-hero-slider-nav", "autoplay": true, "autoplaySpeed": 7000, "fade": true, "responsive": [{"breakpoint": 1025, "settings": {"arrows": false}}]}'>

        <% if (typeof homeConfig !=='undefined' && homeConfig.heroes && homeConfig.heroes.length> 0) { %>
          <% homeConfig.heroes.forEach((hero, index)=> { %>
            <div
              class="relative lg:p-0 p-8 pb-15 bg-center bg-no-repeat bg-cover rounded-3xl xl:pl-[177px] lg:pl-[100px] single-hero-slider-item flex! items-center md:h-[600px]! h-[500px]!"
              style="background-image: url('<%= hero.image ? (hero.image.startsWith('http') ? hero.image : (hero.image.startsWith('image-') ? '/uploads/' : '/assets/images/hero/') + hero.image) : 'https://placehold.co/1920x600?text=Hero+Image' %>');"
              data-wow-delay=".2s">
              <div class="absolute inset-0 bg-black/50 rounded-3xl z-0"></div>

              <!-- Content Section -->
              <div class="single-hero-slider-content relative z-10">
                <div class="flex items-center gap-x-2">
                  <h6 class="text-white">
                    <%= hero.header %>
                  </h6>
                </div>
                <h2 class="py-3 text-white">
                  <%= hero.title %>
                </h2>
                <div class="text-white mb-6 max-w-2xl">
                  <%= hero.description %>
                </div>
                <% if (hero.buttonText && hero.buttonLink) { %>
                  <a class="btn btn-primary text-white btn-large rounded-[60px] group py-2 pl-5 pr-3"
                    href="<%= hero.buttonLink %>">
                    <%= hero.buttonText %>
                      <span
                        class="size-8 bg-white inline-flex items-center justify-center rounded-full rotate-[-40deg] transform group-hover:rotate-0 transition-all duration-300">
                        <i class="hgi hgi-stroke hgi-arrow-right-02 text-xl text-primary-darker"></i>
                      </span>
                  </a>
                  <% } %>
              </div>
            </div>
            <% }); %>
              <% } else { %>
                <!-- Default Fallback Hero if no data in DB -->
                <div
                  class="relative lg:p-0 p-8 pb-15 bg-center bg-no-repeat bg-cover rounded-3xl xl:pl-[177px] lg:pl-[100px] single-hero-slider-item flex! items-center md:h-[600px]! h-[500px]!"
                  style="background-image: url('https://placehold.co/1920x600?text=Jay+Subhdra+Holy+Dham');"
                  data-wow-delay=".2s">
                  <div class="absolute inset-0 bg-black/50 rounded-3xl z-0"></div>
                  <div class="single-hero-slider-content relative z-10">
                    <div class="flex items-center gap-x-2">
                      <h6 class="text-white">Blessings from the Holy Dham</h6>
                    </div>
                    <h2 class="py-3 text-white">Experience Divine <br class="hidden lg:block" /> Grace</h2>
                    <p class="text-white mb-6">Authentic offerings and spiritual heritage from the sacred city of Puri.
                    </p>
                    <a class='btn btn-primary text-white btn-large rounded-[60px] group py-2 pl-5 pr-3' href='/shop'>
                      Shop Now
                      <span
                        class="size-8 bg-white inline-flex items-center justify-center rounded-full rotate-[-40deg] transform group-hover:rotate-0 transition-all duration-300">
                        <i class="hgi hgi-stroke hgi-arrow-right-02 text-xl text-primary-darker"></i>
                      </span>
                    </a>
                  </div>
                </div>
                <% } %>
      </div>
      <div
        class="home-four-hero-slider-nav absolute top-1/2 -translate-y-1/2 right-0 w-full flex items-center justify-between px-6">
      </div>
    </div>
  </div>
</section>
<!-- ========== Hero Section End ========== -->


<!-- ========== Category Section Start ========== -->
<div class="py-[70px]">
  <div class="container">
    <div class="grid grid-cols-12 text-center gap-y-10 items-center">
      <% if (typeof homeConfig !=='undefined' && homeConfig.services && homeConfig.services.length> 0) { %>
        <% homeConfig.services.forEach((service, index)=> { %>
          <div class="col-span-6 md:col-span-4 xl:col-span-2">
            <div data-wow-delay="<%= 0.2 + (index * 0.1) %>s"
              class="group flex flex-col items-center text-center p-6 rounded-2xl transition-all duration-300 hover:bg-white hover:shadow-xl hover:-translate-y-2 wow animate__animated animate__fadeInUp">
              <div class="w-[100px] h-[100px] relative flex items-center justify-center rounded-full bg-primary-lighter/5 transition-all duration-300 group-hover:scale-110 group-hover:shadow-md mb-4 overflow-hidden border border-transparent group-hover:border-primary/10">
                <% if (service.image) { 
                  let serviceImgPath = service.image;
                  if (!serviceImgPath.startsWith('http')) {
                    if (serviceImgPath.startsWith('categoryImage-') || serviceImgPath.startsWith('images-') || serviceImgPath.startsWith('product_images-') || !serviceImgPath.includes('/')) {
                      serviceImgPath = '/uploads/' + serviceImgPath;
                    }
                  }
                %>
                  <img src="<%= serviceImgPath %>" alt="<%= service.title %>"
                    class="w-full h-full object-cover">
                  <% } else { %>
                    <i class="hgi hgi-stroke <%= service.icon %> text-4xl text-primary"></i>
                    <% } %>
              </div>
              <a href="<%= service.link %>"
                class="hover:text-primary pt-2 pb-1 font-bold text-light-primary-text transition-colors">
                <%= service.title %>
              </a>
              <p class="text-xs leading-[18px] text-light-secondary-text">
                <%= service.subtitle %>
              </p>
            </div>
          </div>
          <% }); %>
            <% } else { %>
              <div class="col-span-12 text-center py-10">
                <p class="text-light-secondary-text">No services available.</p>
              </div>
              <% } %>

      <% if (typeof homeConfig !=='undefined' && homeConfig.productCategories && homeConfig.productCategories.length> 0) { %>
        <% homeConfig.productCategories.forEach((category, index)=> { %>
          <div class="col-span-6 md:col-span-4 xl:col-span-2">
            <div data-wow-delay="<%= 0.2 + (index * 0.1) %>s"
              class="group flex flex-col items-center text-center p-6 rounded-2xl transition-all duration-300 hover:bg-white hover:shadow-xl hover:-translate-y-2 wow animate__animated animate__fadeInUp">
              <div class="w-[100px] h-[100px] relative flex items-center justify-center rounded-full bg-warning-lighter/5 transition-all duration-300 group-hover:scale-110 group-hover:shadow-md mb-4 overflow-hidden border border-transparent group-hover:border-warning/10">
                <% if (category.image) { 
                  let imagePath = category.image;
                  if (!imagePath.startsWith('http')) {
                    if (imagePath.startsWith('categoryImage-') || imagePath.startsWith('images-') || imagePath.startsWith('product_images-')) {
                      imagePath = '/uploads/' + imagePath;
                    } else {
                      imagePath = '/admin-assets/img/ecommerce-images/' + imagePath;
                    }
                  }
                %>
                  <img src="<%= imagePath %>" alt="<%= category.name %>"
                    class="w-full h-full object-cover">
                  <% } else { %>
                    <i class="hgi hgi-stroke hgi-folder-01 text-4xl text-warning"></i>
                    <% } %>
              </div>
              <a href="/shop?category=<%= category.slug %>"
                class="hover:text-primary pt-2 pb-1 font-bold text-light-primary-text transition-colors">
                <%= category.name %>
              </a>
              <p class="text-xs leading-[18px] text-light-secondary-text">
                <%= category._count.products %> Items
              </p>
            </div>
          </div>
          <% }); %>
            <% } %>

    </div>
  </div>
</div>
<!-- ========== Category Section End ========== -->


<!-- ========== Current Ritual Section Start ========== -->
<section class="py-10 bg-primary-lighter/10">
  <div class="container">
    <div class="bg-white rounded-3xl shadow-lg border border-gray-100 p-8 md:p-12 relative overflow-hidden">

      <div class="grid md:grid-cols-2 gap-14 items-center relative z-10">

        <!-- Video -->
        <div class="block relative w-full order-2 md:order-1">
          <div class="relative rounded-2xl overflow-hidden shadow-lg group w-full aspect-video">
            <video class="w-full h-full object-cover" preload="metadata" muted playsinline controls>
              <source src="./assets/images/hero/jagavideo.mp4" type="video/mp4">
            </video>

            <div
              class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm p-3 rounded-xl shadow-lg border border-white/20 flex items-center gap-3">
              <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
              <!-- <p class="font-semibold text-sm">Live from Puri</p> -->
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="text-center md:text-left order-1 md:order-2 md:pl-6 lg:pl-10">

          <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
            <!-- <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-sm font-bold">
              LIVE FROM PURI
            </span> -->
            <span
              class="inline-flex items-center gap-1.5 py-1 px-3 rounded-full bg-green-100 text-green-700 text-sm font-bold border border-green-200">
              Mandir Darshan Open
            </span>
          </div>

          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Current Niti (Ritual)
          </h2>

          <h3 class="text-2xl font-semibold text-primary mb-2">
            Sakala Dhupa
          </h3>

          <p class="text-gray-600 text-lg text-left md:text-justify line-clamp-2 mb-6">
            The morning food offering to Lord Jagannath. This is one of the most significant daily rituals.
          </p>

          <div class="flex flex-wrap gap-4 justify-center md:justify-start">
            <a href="/daily-rituals"
              class="btn btn-primary rounded-full px-8 py-3 font-semibold hover:shadow-lg transition-all transform hover:-translate-y-1">
              View Today's Rituals
            </a>
            <button class="btn btn-outline-primary rounded-full px-8 py-3 font-semibold group">
              <span class="mr-2">Next: Bhoga Mandap</span>
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
<!-- ========== Current Ritual Section End ========== -->

<!-- ========== Hot Picks Section Start ========== -->
<section class="pb-[70px]">
  <div class="container">
    <div class="md:flex md:justify-between md:items-center mb-10">
      <div class="text-center md:text-left wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
        <h3>Featured Puri Specialties</h3>
      </div>
      <div class="flex items-center gap-x-5">
        <% if (homeConfig.timer && homeConfig.timer.timer_status) { %>
          <div
            class="limited-time-countdown flex items-center justify-center gap-x-1 bg-error-lighter py-[9px] px-6 rounded-[50px] mx-auto mt-5 md:mt-0 wow animate__animated animate__fadeInUp jagannathapuri-countdown"
            data-wow-delay=".2s" data-countdown-date="<%= homeConfig.timer.timer_end_date %>">
            <h5 class="text-error">
              <%= homeConfig.timer.timer_title || 'Ends in :' %>
            </h5>
            <h5 class="days text-error">00</h5>
            <h5 class="text-error">&colon;</h5>
            <h5 class="hours text-error">00</h5>
            <h5 class="text-error">&colon;</h5>
            <h5 class="minutes text-error">00</h5>
            <h5 class="text-error">&colon;</h5>
            <h5 class="seconds text-error">00</h5>
          </div>
          <% } %>
            <div data-wow-delay=".2s"
              class="home-four-picks-slider-nav md:flex items-center justify-between gap-x-6 hidden wow animate__animated animate__fadeInUp">
            </div>
      </div>
    </div>
    <div class="home-four-picks-slider -mx-3 jagannathapuri-slider"
      data-slick='{"slidesToShow": 5, "slidesToScroll": 1, "loop": true, "arrows": true, "infinite": true, "appendArrows": ".home-four-picks-slider-nav", "autoplay": true, "autoplaySpeed": 7000, "responsive": [{"breakpoint": 1441, "settings": {"slidesToShow": 5}}, {"breakpoint": 1025, "settings": {"slidesToShow": 3}}, {"breakpoint": 769, "settings": {"slidesToShow": 2}}, {"breakpoint": 480, "settings": {"slidesToShow": 1}}]}'>
      <% if (homeConfig.featuredProducts && homeConfig.featuredProducts.length> 0) { %>
        <% homeConfig.featuredProducts.forEach((product, index)=> { %>
          <!-- ========== Single Product Card Start ========== -->
          <div data-wow-delay=".<%= 3 + index %>s" class="mx-3 wow animate__animated animate__fadeInUp h-full">
            <div class="border border-gray-300 rounded-2xl product-card-1 p-6 group flex flex-col h-full">
              <div class="product-image-container relative">
                <div class="product-image rounded-xl mb-4 overflow-hidden">
                  <a href='/product-details/<%= product.slug %>'>
                    <img
                      src="<%= (product.images && product.images.length > 0) ? (product.images[0].startsWith('http') ? product.images[0] : (product.images[0].startsWith('product_images-') ? '/uploads/' : '/admin-assets/img/ecommerce-images/') + product.images[0]) : 'https://placehold.co/600x600?text=' + product.product_name %>"
                      alt="<%= product.product_name %>" loading="lazy"
                      class="group-hover:scale-110 transition-all transform group-hover:-rotate-3 ease-in-out duration-300 bg-[#F4F3F5] w-full aspect-square object-cover" />
                  </a>
                </div>

                <div
                  class="product-btn-actions absolute bottom-0 right-0 left-0 flex justify-center z-9 transition-all duration-300 ease-in-out opacity-0 group-hover:opacity-100 group-hover:bottom-3">
                  <ul class="flex items-center gap-x-px">
                    <li>
                      <a aria-label='Add to Wishlist'
                        class='wishlist-btn product-btn-action-item relative size-11 bg-white inline-flex items-center justify-center rounded-sm before:absolute before:left-[calc(50%-8px)] before:bottom-full before:z-9 before:border-8 before:border-transparent before:border-t-black before:opacity-0 before:invisible before:-mb-3.5 hover:before:opacity-100 hover:before:visible before:transition-all before:duration-300 after:absolute after:bottom-full after:left-1/2 after:-translate-x-1/2 after:rounded-sm after:bg-gray-800 after:whitespace-nowrap after:text-white after:text-xs after:leading-[18px] after:py-[3px] after:px-2 after:content-[attr(aria-label)] after:opacity-0 after:invisible after:transition-all after:duration-300 hover:after:opacity-100 hover:after:visible hover:after:-translate-y-2.5 hover:before:-translate-y-2.5'
                        href='javascript:void(0)' onclick="addToWishlist(<%= product.id %>)"
                        data-product-id="<%= product.id %>">
                        <i
                          class="bx text-2xl leading-6 <%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product.id)) ? 'bxs-heart text-error' : 'bx-heart text-light-secondary-text' %>"></i>
                      </a>
                    </li>
                  </ul>
                </div>
              </div>

              <div class="product-content flex flex-col justify-between h-full">
                <div class="h-[22px] mb-2">
                  <% if (product.on_sale) { %>
                    <span
                      class="product-discount-badge inline-block relative bg-error text-warning-lighter font-medium text-sm leading-[22px] px-1 after:absolute after:top-0 after:left-full after:z-10 after:w-1 after:h-full after:bg-[url('../images/discount-shape.png')] after:bg-no-repeat after:bg-contain uppercase">SALES</span>
                    <% } %>
                </div>

                <p class="text-sm leading-[22px] truncate mb-2">
                  <%= product.category ? product.category.name : 'Uncategorized' %>
                </p>
                <h6 class="text-[18px] leading-7 font-bold mb-3 line-clamp-2 h-[56px]">
                  <a href='/product-details/<%= product.slug %>'>
                    <%= product.product_name %>
                  </a>
                </h6>
                <div class="rating-section flex items-center mb-3 h-[22px]">
                  <div class="flex text-yellow-400">
                    <% for(let i=1; i <=5; i++) { %>
                      <i class="bx bxs-star text-sm"></i>
                      <% } %>
                  </div>
                  <span class="text-sm leading-[22px] font-normal inline-block ml-1">(5.0)</span>
                </div>
                <div class="price-section flex items-center gap-x-3 mb-4 h-[24px]">
                  <% if (product.on_sale && product.sale_price && product.regular_price) { %>
                    <span class="current-price text-[16px] leading-6 font-semibold text-light-primary-text">₹<%=
                        product.sale_price %></span>
                    <span class="old-price text-sm leading-[22px] text-light-disabled-text line-through">₹<%=
                        product.regular_price %></span>
                    <% let discount=Math.round(((product.regular_price - product.sale_price) / product.regular_price) *
                      100); %>
                      <span class="discount-percentage text-sm leading-[22px] font-semibold text-error">
                        <%= discount %>% OFF
                      </span>
                      <% } else { %>
                        <span class="current-price text-[16px] leading-6 font-semibold text-light-primary-text">₹<%=
                            product.regular_price || product.price_amount %></span>
                        <% } %>
                </div>

                <div class="btn-section flex items-center gap-x-4">
                  <button
                    class='wishlist-btn size-11 flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300'
                    onclick="addToWishlist(<%= product.id %>)" data-product-id="<%= product.id %>">
                    <i
                      class="bx text-xl <%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product.id)) ? 'bxs-heart text-error' : 'bx-heart text-light-secondary-text' %>"></i>
                  </button>
                  <a class='btn btn-primary rounded-full font-semibold text-sm leading-6 px-6.5 py-2 flex-1 add-to-cart-btn'
                    href='#' data-product-id="<%= product.id %>">
                    <i class="hgi hgi-stroke hgi-shopping-cart-02 text-xl text-white"></i>

                    <span>Add to Cart</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
          <!-- ========== Single Product Card End ========== -->
          <% }) %>
            <% } else { %>
              <!-- Placeholder if no featured products -->
              <div class="mx-3">
                <p class="text-center py-10 text-light-secondary-text">No featured products found. Feature some from the
                  admin panel!</p>
              </div>
              <% } %>





    </div>
  </div>
</section>
<!-- ========== Hot Picks Section End ========== -->

<!-- ========== Deal Section Start ========== -->
<!-- ========== Explore Puri Treasures Section Start ========== -->
<section class="pb-[70px]">
  <div class="container">
    <div class="mb-10 text-center">
      <h3 data-wow-delay=".2s" class="pb-6 wow animate__animated animate__fadeInUp">
        Explore Puri Treasures
      </h3>

      <div data-wow-delay=".3s"
        class="flex items-center justify-center gap-x-4 wow animate__animated animate__fadeInUp">
        <div class="flex gap-x-8 overflow-x-auto home-four-product-filter border-b border-gray-300">
          <% (homeConfig.exploreTabs || []).forEach((tab, index)=> { %>
            <button data-tab="tab-<%= tab.id %>" class="pt-[13px] pb-[22px] <%= index === 0 ? 'active' : '' %>">
              <%= tab.title || tab.name %>
            </button>
            <% }); %>
        </div>
      </div>
    </div>
    <div class="tab-content" id="deal-tab-content">
      <% (homeConfig.exploreTabs || []).forEach((tab, index)=> { %>
        <div class="tab-pane <%= index === 0 ? 'active' : '' %>" id="tab-<%= tab.id %>">
          <div class="grid 2xl:grid-cols-5 xl:grid-cols-4 lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-6">
            <% (tab.products || []).forEach(product=> { %>
              <!-- ========== Single Product Card Start ========== -->
              <div data-wow-delay=".4s" class="wow animate__animated animate__fadeInUp">
                <div class="border border-gray-300 rounded-2xl product-card-1 p-6 group flex flex-col h-full">
                  <div class="product-image-container relative">
                    <div class="product-image rounded-xl mb-4 overflow-hidden">
                      <a href='/product-details?id=<%= product.id %>'>
                        <% let productImg=Array.isArray(product.images) && product.images.length> 0 ? product.images[0]
                          : (typeof product.images === 'string' ? product.images : null);
                          let imageSrc = "https://placehold.co/600x600?text=" + (product.product_name || "Product");
                          if (productImg) {
                          if (productImg.startsWith('http')) {
                          imageSrc = productImg;
                          } else if (productImg.startsWith('product_images-')) {
                          imageSrc = '/uploads/' + productImg;
                          } else {
                          imageSrc = '/admin-assets/img/ecommerce-images/' + productImg;
                          }
                          }
                          %>
                          <img src="<%= imageSrc %>" alt="<%= product.product_name %>" loading="lazy"
                            class="group-hover:scale-110 transition-all transform group-hover:-rotate-3 ease-in-out duration-300 bg-[#F4F3F5] w-full aspect-square object-cover" />
                      </a>
                    </div>
                    <div
                      class="product-btn-actions absolute bottom-0 right-0 left-0 flex justify-center z-9 transition-all duration-300 ease-in-out opacity-0 group-hover:opacity-100 group-hover:bottom-3">
                      <ul class="flex items-center gap-x-px">
                        <li>
                          <a aria-label='Add to Wishlist'
                            class='wishlist-btn product-btn-action-item relative size-11 bg-white inline-flex items-center justify-center rounded-sm before:absolute before:left-[calc(50%-8px)] before:bottom-full before:z-9 before:border-8 before:border-transparent before:border-t-black before:opacity-0 before:invisible before:-mb-3.5 hover:before:opacity-100 hover:before:visible before:transition-all before:duration-300 after:absolute after:bottom-full after:left-1/2 after:-translate-x-1/2 after:rounded-sm after:bg-gray-800 after:whitespace-nowrap after:text-white after:text-xs after:leading-[18px] after:py-[3px] after:px-2 after:content-[attr(aria-label)] after:opacity-0 after:invisible after:transition-all after:duration-300 hover:after:opacity-100 hover:after:visible hover:after:-translate-y-2.5 hover:before:-translate-y-2.5'
                            href='javascript:void(0)' onclick="addToWishlist(<%= product.id %>)"
                            data-product-id="<%= product.id %>">
                            <i
                              class="bx text-2xl leading-6 <%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product.id)) ? 'bxs-heart text-error' : 'bx-heart text-light-secondary-text' %>"></i>
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>

                  <div class="product-content flex flex-col flex-1 pt-4">
                    <h6 class="text-[20px] leading-[30px] font-bold pb-3 line-clamp-2">
                      <a href='/product-details?id=<%= product.id %>'>
                        <%= product.product_name %>
                      </a>
                    </h6>
                    <div class="price-section flex items-center gap-x-3 mb-3">
                      <span
                        class="current-price text-[20px] font-urbanist leading-[30px] font-bold text-light-primary-text">₹
                        <%= product.price %>
                      </span>
                    </div>
                    <div class="btn-section flex items-center gap-x-4 mt-auto">
                      <button
                        class="wishlist-btn size-11 flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300"
                        onclick="addToWishlist(<%= product.id %>)" data-product-id="<%= product.id %>">
                        <i
                          class="bx text-xl <%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product.id)) ? 'bxs-heart text-error' : 'bx-heart text-light-secondary-text' %>"></i>
                      </button>
                      <a class='btn btn-primary rounded-full font-semibold text-sm leading-6 px-6.5 py-2 flex-1 add-to-cart-btn'
                        href='#' data-product-id="<%= product.id %>">
