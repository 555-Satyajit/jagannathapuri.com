<!-- ========== Hero Section Start ========== -->
<section class="pt-6">
  <div class="container">
    <div class="relative">
      <div class="home-four-hero-slider rounded-3xl relative bg-transparent sellzy-slider"
        data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "loop": true, "arrows": true, "infinite": true, "dots": true, "appendArrows": ".home-four-hero-slider-nav", "autoplay": true, "autoplaySpeed": 7000, "fade": true, "responsive": [{"breakpoint": 1025, "settings": {"arrows": false}}]}'>

        <% if (typeof homeConfig !=='undefined' && homeConfig.heroes && homeConfig.heroes.length> 0) { %>
          <% homeConfig.heroes.forEach((hero, index)=> { %>
            <div
              class="relative lg:p-0 p-8 pb-15 bg-center bg-no-repeat bg-cover rounded-3xl xl:pl-[177px] lg:pl-[100px] single-hero-slider-item flex! items-center md:h-[600px]! h-[500px]!"
              style="background-image: url('<%= hero.image ? (hero.image.startsWith('http') ? hero.image : (hero.image.startsWith('image-') ? '/uploads/' : '/assets/images/hero/') + hero.image) : 'https://placehold.co/1920x600?text=Hero+Image' %>');"
              data-wow-delay=".2s">
              <div class="absolute inset-0 bg-black/50 rounded-3xl z-0"></div>

              <!-- Content Section -->
              <div class="single-hero-slider-content relative z-10">
                <div class="flex items-center gap-x-2">
                  <h6 class="text-white">
                    <%= hero.header %>
                  </h6>
                </div>
                <h2 class="py-3 text-white">
                  <%= hero.title %>
                </h2>
                <div class="text-white mb-6 max-w-2xl">
                  <%= hero.description %>
                </div>
                <% if (hero.buttonText && hero.buttonLink) { %>
                  <a class="btn btn-primary text-white btn-large rounded-[60px] group py-2 pl-5 pr-3"
                    href="<%= hero.buttonLink %>">
                    <%= hero.buttonText %>
                      <span
                        class="size-8 bg-white inline-flex items-center justify-center rounded-full rotate-[-40deg] transform group-hover:rotate-0 transition-all duration-300">
                        <i class="hgi hgi-stroke hgi-arrow-right-02 text-xl text-primary-darker"></i>
                      </span>
                  </a>
                  <% } %>
              </div>
            </div>
            <% }); %>
              <% } else { %>
                <!-- Default Fallback Hero if no data in DB -->
                <div
                  class="relative lg:p-0 p-8 pb-15 bg-center bg-no-repeat bg-cover rounded-3xl xl:pl-[177px] lg:pl-[100px] single-hero-slider-item flex! items-center md:h-[600px]! h-[500px]!"
                  style="background-image: url('https://placehold.co/1920x600?text=Jay+Subhdra+Holy+Dham');"
                  data-wow-delay=".2s">
                  <div class="absolute inset-0 bg-black/50 rounded-3xl z-0"></div>
                  <div class="single-hero-slider-content relative z-10">
                    <div class="flex items-center gap-x-2">
                      <h6 class="text-white">Blessings from the Holy Dham</h6>
                    </div>
                    <h2 class="py-3 text-white">Experience Divine <br class="hidden lg:block" /> Grace</h2>
                    <p class="text-white mb-6">Authentic offerings and spiritual heritage from the sacred city of Puri.
                    </p>
                    <a class='btn btn-primary text-white btn-large rounded-[60px] group py-2 pl-5 pr-3' href='/shop'>
                      Shop Now
                      <span
                        class="size-8 bg-white inline-flex items-center justify-center rounded-full rotate-[-40deg] transform group-hover:rotate-0 transition-all duration-300">
                        <i class="hgi hgi-stroke hgi-arrow-right-02 text-xl text-primary-darker"></i>
                      </span>
                    </a>
                  </div>
                </div>
                <% } %>
      </div>
      <div
        class="home-four-hero-slider-nav absolute top-1/2 -translate-y-1/2 right-0 w-full flex items-center justify-between px-6">
      </div>
    </div>
  </div>
</section>
<!-- ========== Hero Section End ========== -->


<!-- ========== Category Section Start ========== -->
<div class="py-[70px]">
  <div class="container">
    <div class="grid grid-cols-12 text-center gap-y-10 items-center">
      <% if (typeof homeConfig !=='undefined' && homeConfig.services && homeConfig.services.length> 0) { %>
        <% homeConfig.services.forEach((service, index)=> { %>
          <div class="col-span-6 md:col-span-4 xl:col-span-2">
            <div data-wow-delay="<%= 0.2 + (index * 0.1) %>s"
              class="flex flex-col items-center text-center wow animate__animated animate__fadeInUp">
              <div class="w-[100px] h-[100px] flex items-center justify-center text-[#919EAB]">
                <i class="hgi hgi-stroke <%= service.icon %> text-6xl"></i>
              </div>
              <a href="<%= service.link %>"
                class="hover:text-primary pt-4 pb-2.5 font-semibold text-light-primary-text">
                <%= service.title %>
              </a>
              <p class="text-sm leading-[22px]">
                <%= service.subtitle %>
              </p>
            </div>
          </div>
          <% }); %>
            <% } else { %>
              <div class="col-span-12 text-center py-10">
                <p class="text-light-secondary-text">No services available.</p>
              </div>
              <% } %>

                <!-- Hotels & Stay -->
