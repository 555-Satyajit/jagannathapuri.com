<section class="pb-[70px]">
  <div class="container">
    <div class="md:flex md:justify-between md:items-center mb-10">
      <div class="text-center md:text-left wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
        <h3>Featured Puri Specialties</h3>
      </div>
      <div class="flex items-center gap-x-5">
        <div
          class="limited-time-countdown flex items-center justify-center gap-x-1 bg-error-lighter py-[9px] px-6 rounded-[50px] mx-auto mt-5 md:mt-0 wow animate__animated animate__fadeInUp sellzy-countdown"
          data-wow-delay=".2s">
          <h5 class="text-error">Ends in:</h5>
          <h5 class="days text-error">00</h5>
          <h5 class="text-error">&colon;</h5>
          <h5 class="hours text-error">00</h5>
          <h5 class="text-error">&colon;</h5>
          <h5 class="minutes text-error">00</h5>
          <h5 class="text-error">&colon;</h5>
          <h5 class="seconds text-error">00</h5>
        </div>
        <div data-wow-delay=".2s"
          class="home-four-picks-slider-nav md:flex items-center justify-between gap-x-6 hidden wow animate__animated animate__fadeInUp">
        </div>
      </div>
    </div>
    <div class="home-four-picks-slider -mx-3 sellzy-slider"
      data-slick='{"slidesToShow": 5, "slidesToScroll": 1, "loop": true, "arrows": true, "infinite": true, "appendArrows": ".home-four-picks-slider-nav", "autoplay": true, "autoplaySpeed": 7000, "responsive": [{"breakpoint": 1441, "settings": {"slidesToShow": 5}}, {"breakpoint": 1025, "settings": {"slidesToShow": 3}}, {"breakpoint": 769, "settings": {"slidesToShow": 2}}, {"breakpoint": 480, "settings": {"slidesToShow": 1}}]}'>
      <% if (homeConfig.featuredProducts && homeConfig.featuredProducts.length> 0) { %>
        <% homeConfig.featuredProducts.forEach((product, index)=> { %>
          <!-- ========== Single Product Card Start ========== -->
          <div data-wow-delay=".<%= 3 + index %>s" class="mx-3 wow animate__animated animate__fadeInUp">
            <div class="border border-gray-300 rounded-2xl product-card-1 p-6 group">
              <div class="product-image-container relative">
                <div class="product-image rounded-xl mb-4 overflow-hidden">
                  <a href='/product-details/<%= product.slug %>'>
                    <img
                      src="<%= (product.images && product.images.length > 0) ? (product.images[0].startsWith('http') ? product.images[0] : (product.images[0].startsWith('product_images-') ? '/uploads/' : '/admin-assets/img/ecommerce-images/') + product.images[0]) : 'https://placehold.co/600x600?text=' + product.product_name %>"
                      alt="<%= product.product_name %>" loading="lazy"
                      class="group-hover:scale-110 transition-all transform group-hover:-rotate-3 ease-in-out duration-300 bg-[#F4F3F5]" />
                  </a>
                </div>

                <div
                  class="product-btn-actions absolute bottom-0 right-0 left-0 flex justify-center z-9 transition-all duration-300 ease-in-out opacity-0 group-hover:opacity-100 group-hover:bottom-3">
                  <ul class="flex items-center gap-x-px">
                    <li>
                      <a aria-label='Add to Wishlist'
                        class='wishlist-btn product-btn-action-item relative size-11 bg-white inline-flex items-center justify-center rounded-sm before:absolute before:left-[calc(50%-8px)] before:bottom-full before:z-9 before:border-8 before:border-transparent before:border-t-black before:opacity-0 before:invisible before:-mb-3.5 hover:before:opacity-100 hover:before:visible before:transition-all before:duration-300 after:absolute after:bottom-full after:left-1/2 after:-translate-x-1/2 after:rounded-sm after:bg-gray-800 after:whitespace-nowrap after:text-white after:text-xs after:leading-[18px] after:py-[3px] after:px-2 after:content-[attr(aria-label)] after:opacity-0 after:invisible after:transition-all after:duration-300 hover:after:opacity-100 hover:after:visible hover:after:-translate-y-2.5 hover:before:-translate-y-2.5'
                        href='javascript:void(0)' onclick="addToWishlist(<%= product.id %>)"
                        data-product-id="<%= product.id %>">
                        <i
                          class="bx text-2xl leading-6 <%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product.id)) ? 'bxs-heart text-error' : 'bx-heart text-light-secondary-text' %>"></i>
                      </a>
                    </li>
                  </ul>
                </div>
              </div>

              <div class="product-content">
                <% if (product.on_sale) { %>
                  <span
                    class="product-discount-badge inline-block relative bg-error text-warning-lighter font-medium text-sm leading-[22px] px-1 after:absolute after:top-0 after:left-full after:z-10 after:w-1 after:h-full after:bg-[url('../images/discount-shape.png')] after:bg-no-repeat after:bg-contain uppercase">SALES</span>
                  <% } %>

                    <p class="py-3 text-sm leading-[22px]">
                      <%= product.category ? product.category.name : 'Uncategorized' %>
                    </p>
                    <h6 class="text-[18px] leading-7 font-bold pb-3">
                      <a href='/product-details/<%= product.slug %>'>
                        <%= product.product_name %>
                      </a>
                    </h6>
                    <div class="rating-section flex items-center mb-3">
                      <div class="flex text-yellow-400">
                        <% for(let i=1; i <=5; i++) { %>
                          <i class="bx bxs-star text-sm"></i>
                          <% } %>
                      </div>
                      <span class="text-sm leading-[22px] font-normal inline-block ml-1">(5.0)</span>
                    </div>
                    <div class="price-section flex items-center gap-x-3 mb-3">
                      <% if (product.on_sale && product.sale_price && product.regular_price) { %>
                        <span class="current-price text-[16px] leading-6 font-semibold text-light-primary-text">₹<%=
                            product.sale_price %></span>
                        <span class="old-price text-sm leading-[22px] text-light-disabled-text line-through">₹<%=
                            product.regular_price %></span>
                        <% let discount=Math.round(((product.regular_price - product.sale_price) /
                          product.regular_price) * 100); %>
                          <span class="discount-percentage text-sm leading-[22px] font-semibold text-error">
                            <%= discount %>% OFF
                          </span>
                          <% } else { %>
                            <span class="current-price text-[16px] leading-6 font-semibold text-light-primary-text">₹<%=
                                product.regular_price || product.price_amount %></span>
                            <% } %>
                    </div>

                    <div class="btn-section flex items-center gap-x-4">
                      <button
                        class='wishlist-btn size-11 flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300'
                        onclick="addToWishlist(<%= product.id %>)" data-product-id="<%= product.id %>">
                        <i
                          class="bx text-xl <%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product.id)) ? 'bxs-heart text-error' : 'bx-heart text-light-secondary-text' %>"></i>
                      </button>
                      <a class='btn btn-primary rounded-full font-semibold text-sm leading-6 px-6.5 py-2 flex-1 add-to-cart-btn'
                        href='#' data-product-id="<%= product.id %>">
                        <i class="hgi hgi-stroke hgi-shopping-cart-02 text-xl text-white"></i>

                        <span>Add to Cart</span>
                      </a>
                    </div>
              </div>
            </div>
          </div>
          <!-- ========== Single Product Card End ========== -->
          <% }) %>
            <% } else { %>
              <!-- Placeholder if no featured products -->
              <div class="mx-3">
                <p class="text-center py-10 text-light-secondary-text">No featured products found. Feature some from the
                  admin panel!</p>
              </div>
              <% } %>





    </div>
  </div>
</section>
<!-- ========== Hot Picks Section End ========== -->

