                    </div>
                    <a href="/service"
                      class="hover:text-primary pt-4 pb-2.5 font-semibold text-light-primary-text">Hotels
                      &
                      Stay</a>
                    <p class="text-sm leading-[22px]">Comfortable Stays</p>
