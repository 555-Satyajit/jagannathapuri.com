                    <div class="w-[100px] h-[100px] flex items-center justify-center text-[#919EAB]">
                      <i class="hgi hgi-stroke hgi-flag-01 text-6xl"></i>
                    </div>
                    <a href="/service" class="hover:text-primary pt-4 pb-2.5 font-semibold text-light-primary-text">Flag
                      Hosting</a>
                    <p class="text-sm leading-[22px]">Nilachakra Rituals</p>
