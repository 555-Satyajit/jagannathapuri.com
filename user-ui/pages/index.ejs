      <div data-wow-delay=".3s"
        class="flex items-center justify-center gap-x-4 wow animate__animated animate__fadeInUp">
        <div class="flex gap-x-8 overflow-x-auto home-four-product-filter border-b border-gray-300">
          <% (homeConfig.exploreTabs || []).forEach((tab, index)=> { %>
            <button data-tab="tab-<%= tab.id %>" class="pt-[13px] pb-[22px] <%= index === 0 ? 'active' : '' %>">
              <%= tab.title || tab.name %>
            </button>
            <% }); %>
        </div>
      </div>
    </div>
