        <% const bgColors=['#A0E2E0', '#FFEB69' , '#FFC091' , '#9EE872' ]; %>
          <% homeConfig.features.forEach((feature, index)=> { %>
            <div class="md:col-span-6 col-span-12 xl:col-span-3 wow animate__animated animate__fadeInUp"
              data-wow-delay=".<%= 2 + index %>s">
              <div class="p-6 border-gray-300 border rounded-2xl text-center"
                style="background-color: <%= bgColors[index % bgColors.length] %>;">
                <span class="inline-flex items-center justify-center size-14 bg-white rounded-full">
                  <i class="<%= feature.icon || 'hgi hgi-stroke hgi-star' %> text-3xl text-light-primary-text"></i>
                </span>
                <div class="pt-3 pb-0.5 font-bold text-lg">
                  <%- feature.title %>
