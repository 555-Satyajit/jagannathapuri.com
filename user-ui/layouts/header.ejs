<!-- ========== HEADER Section Start ========== -->
<header>
  <!-- header-top start -->
  <div class="bg-primary header-top">
    <div class="container">
      <div class="flex items-center xl:justify-between justify-center">
        <div class="xl:flex items-center gap-x-6 hidden">
          <p class="flex items-center gap-x-2 text-white text-sm leading-[22px]">
            <span><i class="hgi hgi-stroke hgi-customer-support text-xl text-white"></i>
            </span>
            Need Support ?
            <span>Call Us</span>
            <a href="#" class="bg-warning py-px px-2 text-xs leading-4.5 rounded-[60px] text-gray-800">
              <%= siteConfig.header.support_phone %>
            </a>
          </p>
          <div>
            <ul class="flex items-center gap-x-[19px]">
              <li
                class="relative group after:absolute after:h-7.5 after:w-px after:bg-primary-light after:right-0 after:top-1/2 after:-translate-y-1/2">
                <!-- Custom Translation Dropdown -->
                <a href="javascript:void(0)"
                  class="text-sm leading-[22px] text-white inline-flex items-center gap-x-2 pr-[19px] py-3.5"
                  id="current-lang-display">
                  <span class="inline-flex items-center justify-center size-7 bg-primary-darker rounded-full">
                    <i class="hgi hgi-stroke hgi-language-circle text-xl text-white"></i>
                  </span>
                  English
                  <span class="inline-flex items-center justify-center">
                    <i class="hgi hgi-stroke hgi-arrow-down-01 text-xl text-white"></i>
                  </span>
                </a>

                <ul
                  class="absolute left-0 top-full py-2 z-50 w-[200px] max-w-[200px] bg-white rounded-lg shadow-dark-z-24 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="en">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      English
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="or">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Odia
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="hi">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Hindi
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="bn">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Bengali
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="mr">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Marathi
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="ta">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Tamil
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="te">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Telugu
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="kn">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Kannada
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="javascript:void(0)"
                      class="flex items-center gap-x-2 relative text-light-primary-text hover:text-primary lang-select"
                      data-lang="ml">
                      <span class="w-8 h-8 bg-[#F0F0F0] inline-flex items-center justify-center rounded-full">
                        <i class="hgi hgi-stroke hgi-language-circle text-base text-gray-600"></i>
                      </span>
                      Malayalam
                    </a>
                  </li>
                </ul>

                <!-- Hidden Google Translate Element (Off-screen for better init) -->
                <div id="google_translate_element" style="position: absolute; top: -9999px; left: -9999px;"></div>
                <script type="text/javascript">
                  function googleTranslateElementInit() {
                    new google.translate.TranslateElement({
                      pageLanguage: 'en',
                      includedLanguages: 'en,or,hi,bn,mr,ta,te,kn,ml',
                      layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                      autoDisplay: false
                    }, 'google_translate_element');
                  }

                  // Bulletproof Cookie-based translation
                  document.addEventListener('click', function (e) {
                    const langBtn = e.target.closest('.lang-select');
                    if (langBtn) {
                      e.preventDefault();
                      const lang = langBtn.getAttribute('data-lang');
                      const cookieValue = '/en/' + lang;

                      // Set cookie for the main domain and all subpaths
                      document.cookie = "googtrans=" + cookieValue + "; path=/";
                      document.cookie = "googtrans=" + cookieValue + "; path=/; domain=" + location.hostname;

                      // Refresh the page to apply translation reliably
                      location.reload();
                    }
                  });

                  // Update UI Label based on cookie on page load
                  window.addEventListener('DOMContentLoaded', () => {
                    const getCookie = (name) => {
                      const value = `; ${document.cookie}`;
                      const parts = value.split(`; ${name}=`);
                      if (parts.length === 2) return parts.pop().split(';').shift();
                    };

                    const googtrans = getCookie('googtrans');
                    if (googtrans) {
                      const lang = googtrans.split('/').pop();
                      const labelMap = { 'en': 'English', 'or': 'Odia', 'hi': 'Hindi', 'bn': 'Bengali', 'mr': 'Marathi', 'ta': 'Tamil', 'te': 'Telugu', 'kn': 'Kannada', 'ml': 'Malayalam' };
                      if (labelMap[lang]) {
                        const display = document.getElementById('current-lang-display');
                        if (display) {
                          for (const node of display.childNodes) {
                            if (node.nodeType === Node.TEXT_NODE && node.textContent.trim().length > 1) {
                              node.textContent = ' ' + labelMap[lang];
                              break;
                            }
                          }
                        }
                      }
                    }
                  });
                </script>
                <script type="text/javascript"
                  src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
                <style>
                  /* Clean up UI: Hide Google banners, toolbars and tooltips */
                  .goog-te-banner-frame.skiptranslate,
                  .goog-te-gadget,
                  .goog-te-banner,
                  #goog-gt-tt,
                  .goog-tooltip,
                  .goog-tooltip:hover {
                    display: none !important;
                  }

                  body {
                    top: 0px !important;
                  }

                  .goog-text-highlight {
                    background-color: transparent !important;
                    border: none !important;
                    box-shadow: none !important;
                  }
                </style>
              </li>
              <li class="relative group">
                <a href="#" class="text-sm leading-[22px] text-white flex items-center gap-x-2 py-3.5"><span
                    class="inline-flex items-center justify-center size-7 bg-primary-darker rounded-full"><i
                      class="hgi hgi-stroke hgi-dollar-circle text-xl text-white"></i>
                  </span>
                  USD
                  <span class="inline-flex items-center justify-center"><i
                      class="hgi hgi-stroke hgi-arrow-down-01 text-xl text-white"></i>
                  </span>
                </a>
                <ul
                  class="absolute left-0 top-full py-2 z-50 w-[250px] max-w-[250px] bg-white rounded-lg shadow-dark-z-24 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                  <li class="py-2 px-4 group/item">
                    <a href="#"
                      class="flex items-center gap-x-2 relative text-light-primary-text group-hover/item:text-primary">
                      AUD
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="#"
                      class="flex items-center gap-x-2 relative text-light-primary-text group-hover/item:text-primary">
                      EUR
                    </a>
                  </li>
                  <li class="py-2 px-4 group/item">
                    <a href="#"
                      class="flex items-center gap-x-2 relative text-light-primary-text group-hover/item:text-primary">
                      USD
                    </a>
                  </li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
        <% if (siteConfig.header.promo_status !==false) { %>
          <div class="text-center py-3.5">
            <p class="flex items-center gap-x-[7px] text-white text-sm leading-[22px] font-dm-sans">
              <span class="inline-flex items-center"><i
                  class="hgi hgi-stroke hgi-discount-01 text-white text-xl"></i></span>
              <%= siteConfig.header.promo_text || 'Fashion Category' %>
                <span class="bg-warning py-px px-2 text-xs leading-4.5 rounded-[60px] text-gray-800">
                  <%= siteConfig.header.promo_tag || '25% OFF' %>
                </span>
                <%= siteConfig.header.promo_suffix || 'Today' %>
            </p>
          </div>
          <% } %>

            <div class="hidden xl:flex">
              <ul class="flex items-center text-white">
                <% (siteConfig.header.top_bar_links || []).forEach((link, index)=> { %>
                  <li>
                    <a class='text-sm leading-[22px] text-white py-3.5 <%= index < siteConfig.header.top_bar_links.length - 1 ? "pr-[19px] mr-[19px] relative after:absolute after:h-7.5 after:w-px after:bg-primary-light after:right-0 after:top-1/2 after:-translate-y-1/2" : "" %>'
                      href='<%= link.url %>'>
                      <%= link.label %>
                    </a>
                  </li>
                  <% }) %>
              </ul>
            </div>
      </div>
    </div>
  </div>
  <!-- header-top End -->

  <!-- header-middle Start -->
  <div class="py-4 border border-gray-300 xl:border-0 hidden xl:block header-middle">
    <div class="container">
      <!-- For Desktop Screen Start -->
      <div class="xl:flex items-center hidden">
        <div>
