              <i class="hgi hgi-stroke hgi-grid-view text-base text-white"></i>
            </span>
            Explore All Categories
            <span class="inline-flex items-center" id="dropdownIcon"><i
                class="hgi hgi-stroke hgi-arrow-down-01 text-xl text-white"></i>
            </span>
          </button>
          <div>
            <ul id="dropdownMenu"
              class="bg-white hide shadow-dark-z-24 rounded-b-2xl px-4 py-4 z-40 transform origin-top transition-all duration-300 ease-in-out absolute left-0 top-full w-full divide-y divide-[rgba(145,158,171,0.24)]">
              <% if (locals.headerCategories && headerCategories.length> 0) { %>
                <% headerCategories.forEach(category=> { %>
                  <li class="py-[9px] group relative">
                    <a href="/shop?category=<%= category.slug %>"
                      class="flex items-center gap-x-2 relative text-light-primary-text group-hover:text-primary">
                      <span
                        class="w-8 h-8 bg-primary-lighter inline-flex items-center justify-center rounded-full overflow-hidden">
                        <% if (category.image) { %>
                          <img src="/uploads/<%= category.image %>" alt="<%= category.name %>"
                            class="w-full h-full object-cover">
                          <% } else { %>
                            <i class="hgi hgi-stroke hgi-folder-01 text-base text-primary"></i>
                            <% } %>
                      </span>
                      <%= category.name %>
                        <% if (category.subCategories && category.subCategories.length> 0) { %>
                          <span class="absolute right-0 top-1/2 -translate-y-1/2">
                            <i class="hgi hgi-stroke hgi-arrow-right-01 text-lg text-light-primary-text"></i>
                          </span>
                          <% } %>
                    </a>

                    <% if (category.subCategories && category.subCategories.length> 0) { %>
                      <ul
                        class="absolute left-full top-0 z-60 w-[250px] max-w-[250px] bg-white rounded-2xl divide-y divide-gray-300 shadow-dark-z-24 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-x-4 group-hover:translate-x-0">
                        <% category.subCategories.forEach(subParams=> { %>
                          <li class="py-[9px] px-4 group/item">
                            <a href="/shop?category=<%= subParams.slug %>"
                              class="flex items-center gap-x-2 relative text-light-primary-text group-hover/item:text-primary">
                              <%= subParams.name %>
                            </a>
                          </li>
                          <% }) %>
                      </ul>
                      <% } %>
                  </li>
                  <% }) %>
                    <% } else { %>
                      <li class="py-2 text-center text-sm text-gray-500">No categories found</li>
                      <% } %>
            </ul>
          </div>
        </div>
        <nav class="main-menu">
          <ul>
            <% (siteConfig.header.navbar_links || []).forEach(link=> { %>
              <li class="<%= link.sub_links && link.sub_links.length > 0 ? 'group relative' : '' %>">
                <a href="<%= link.url %>" class="flex items-center gap-x-1">
                  <%= link.label %>
                    <% if (link.sub_links && link.sub_links.length> 0) { %>
                      <i
                        class="hgi hgi-stroke hgi-arrow-down-01 text-sm transition-transform duration-300 group-hover:rotate-180"></i>
                      <% } %>
                </a>
                <% if (link.sub_links && link.sub_links.length> 0) { %>
                  <ul
                    class="absolute left-0 top-full pt-4 z-50 w-[200px] bg-white rounded-lg shadow-dark-z-24 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 overflow-hidden">
                    <% link.sub_links.forEach(sub=> { %>
                      <li class="border-b last:border-b-0 border-gray-100">
                        <a href="<%= sub.url %>"
                          class="block px-4 py-2.5 text-sm text-light-primary-text hover:bg-primary-lighter hover:text-primary transition-colors">
                          <%= sub.label %>
                        </a>
                      </li>
                      <% }) %>
                  </ul>
                  <% } %>
              </li>
              <% }) %>
          </ul>
        </nav>
        <div>
          <p class="xl:flex lg:items-center gap-x-4 hidden">
            <span
              class="size-12 inline-flex items-center justify-center rounded-full transition-colors duration-300 bg-[rgba(145,158,171,0.08)]">
              <i class="hgi hgi-stroke hgi-customer-support text-2xl text-light-primary-text"></i>
            </span>
            <span class="flex flex-col text-sm leading-[22px]">
              24/7 Support
              <span class="text-base leading-6 text-light-primary-text">
                <%= siteConfig.header.navbar_support_phone || '888-777-999' %>
              </span>
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
  <!-- header-bottom End -->
</header>
<!-- ========== HEADER Section End ========== -->