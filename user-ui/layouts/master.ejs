<!DOCTYPE html>
<html lang="en">

<head>
  <!-- ========== Meta Tags ========== -->
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% const seoSettings=(locals.siteConfig && locals.siteConfig.seo) ? locals.siteConfig.seo : {}; const
    pageSeo=locals.seo || {}; const metaTitle=pageSeo.meta_title || locals.title || seoSettings.meta_title
    || 'Jagannathapuri - Multipurpose eCommerce' ; const metaDesc=pageSeo.meta_description ||
    seoSettings.meta_description || 'Your one-stop shop for authentic Puri Dham specialties.' ; const
    metaKeywords=pageSeo.meta_keywords || seoSettings.meta_keywords || 'Puri, Jagannath, Mahaprasad, Handloom, Odisha' ;
    const favicon=seoSettings.favicon || '/assets/images/favicon.png' ; const ogTitle=pageSeo.meta_title ||
    seoSettings.og_title || metaTitle; const ogDesc=pageSeo.meta_description || seoSettings.og_description || metaDesc;
    const ogImage=pageSeo.og_image || seoSettings.og_image || (locals.siteConfig && locals.siteConfig.header ?
    locals.siteConfig.header.logo : '/assets/images/logo.png' ); const twitterCard=seoSettings.twitter_card
    || 'summary_large_image' ; %>
    <title>
      <%= metaTitle %>
    </title>
    <meta name="description" content="<%= metaDesc %>">
    <meta name="keywords" content="<%= metaKeywords %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= ogTitle %>">
    <meta property="og:description" content="<%= ogDesc %>">
    <meta property="og:image"
      content="<%= ogImage.startsWith('http') ? ogImage : (locals.protocol + '://' + locals.host + ogImage) %>">

    <!-- Twitter -->
    <meta property="twitter:card" content="<%= twitterCard %>">
    <meta property="twitter:title" content="<%= ogTitle %>">
    <meta property="twitter:description" content="<%= ogDesc %>">
    <meta property="twitter:image"
      content="<%= ogImage.startsWith('http') ? ogImage : (locals.protocol + '://' + locals.host + ogImage) %>">

    <!-- ========== Favicon ========== -->
    <link rel="shortcut icon" href="<%= favicon %>" type="image/x-icon" />

    <!-- ========== Google Fonts ========== -->
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
      rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@100..900&display=swap"
      rel="stylesheet" />

    <!-- ========== Huge Icons CSS ========== -->
    <link rel="stylesheet" href="/assets/css/vendor/hugeicons/hgi-stroke-rounded.css" />

    <!-- ========== Boxicons CSS ========== -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <!-- ========== Slick CSS ========== -->
    <link rel="stylesheet" href="/assets/css/vendor/slick.min.css" />

    <!-- ========== Nice Select CSS ========== -->
    <link rel="stylesheet" href="/assets/css/vendor/nice-select.css" />

    <!-- ========== Animate CSS ========== -->
    <link rel="stylesheet" href="/assets/css/vendor/animate.min.css" />

    <!-- ========== Custom CSS ========== -->
    <link rel="stylesheet" href="/assets/css/style.css" />

    <!-- ========== SweetAlert2 CSS ========== -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>

<body>
  <!-- Preloader Start -->
  <div id="preloader" class="preloader">
    <div class="pxl-loader-spinner">
      <div class="pxl-loader-bounce1"></div>
      <div class="pxl-loader-bounce2"></div>
      <div class="pxl-loader-bounce3"></div>
    </div>
  </div>
  <!-- Preloader End -->

  <!-- Overlay Start -->
  <div data-overlay-for class="modal-overlay hidden w-full h-screen fixed top-0 left-0 bg-[#161C247A] z-90"></div>
  <!-- Overlay End -->

  <!-- Scroll To Top Button Start -->
  <button
    class="scroll-to-top hide btn btn-primary size-10 rounded-[50px] z-50 inline-flex items-center justify-center fixed md:right-8 md:bottom-8 right-[15px] bottom-[85px] transition-all duration-400 ease-in-out">
    <i class="hgi hgi-stroke hgi-arrow-up-01 leading-6 text-2xl"></i>
  </button>
  <!-- Scroll To Top Button End -->

  <%- include('sidebar') %>

    <%- include('header') %>
      <%- body %>
        <%- include('footer') %>

          <% if (locals.activePopup) { %>
            <!-- Promotion Popup Start -->
            <style>
              .promo-modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.85);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 999999;
                opacity: 0;
                visibility: hidden;
                transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
                backdrop-filter: blur(5px);
              }

              .promo-modal-overlay.show {
                opacity: 1;
                visibility: visible;
              }

              .promo-modal-content {
                position: relative;
                max-width: 90%;
                width: 450px;
                transform: scale(0.8);
                transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
              }

              .promo-modal-overlay.show .promo-modal-content {
                transform: scale(1);
              }

              .promo-close-btn {
                position: absolute;
                top: -15px;
                right: -15px;
                width: 40px;
                height: 40px;
                background: #ff5722;
                color: white;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 3px solid #fff;
                cursor: pointer;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
                z-index: 10;
                transition: transform 0.2s;
              }

              .promo-close-btn:hover {
                transform: scale(1.1);
              }

              .promo-img-container {
                background: #fff;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
                border: 5px solid #fff;
              }

              .promo-img-container img {
                width: 100%;
                height: auto;
                display: block;
              }
            </style>

            <div id="promo-popup" class="promo-modal-overlay">
              <div class="promo-modal-content">
                <button id="close-promo" class="promo-close-btn" aria-label="Close">
                  <i class="bx bx-x" style="font-size: 28px;"></i>
                </button>
                <div class="promo-img-container">
                  <img src="/uploads/<%= activePopup.image %>" alt="Special Blessing">
                </div>
              </div>
            </div>

            <script>
              document.addEventListener('DOMContentLoaded', function () {
                const popup = document.getElementById('promo-popup');
                const closeBtn = document.getElementById('close-promo');
                const popupId = '<%= activePopup.id %>';

                // Check if already shown in this session
                if (!sessionStorage.getItem('promo_shown_' + popupId)) {
                  setTimeout(() => {
                    if (popup) popup.classList.add('show');
                  }, 3000); // Show after 3 seconds
                }

                function closePopup() {
                  if (popup) popup.classList.remove('show');
                  sessionStorage.setItem('promo_shown_' + popupId, 'true');
                }

                if (closeBtn) closeBtn.addEventListener('click', closePopup);
                if (popup) popup.addEventListener('click', function (e) {
                  if (e.target === popup) closePopup();
                });
              });
            </script>
            <% } %>

              <!-- ========== Plugins JS ========== -->
              <script src="/assets/js/vendor/jquery-3.7.1.min.js"></script>
              <script src="/assets/js/vendor/slick.min.js" defer></script>
              <script src="/assets/js/vendor/jquery.countdown.min.js" defer></script>
              <script src="/assets/js/vendor/jquery.nice-select.min.js" defer></script>
              <script src="/assets/js/vendor/jquery.counterup-2.min.js" defer></script>
              <script src="/assets/js/vendor/jquery.magnific-popup.min.js" defer></script>
              <script src="/assets/js/vendor/wow.min.js" defer></script>
              <script>
                // Initialize WOW.js after defer loading
                window.addEventListener('load', function () {
                  if (typeof WOW !== 'undefined') {
                    new WOW().init();
                  }
                });
              </script>

              <!-- ========== Supabase JS ========== -->
              <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
              <script>
                window.supabase = supabase.createClient(
                  "<%= process.env.SUPABASE_URL %>",
                  "<%= process.env.SUPABASE_ANON_KEY %>"
                );
              </script>

              <!-- ========== SweetAlert2 JS ========== -->
              <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

              <!-- ========== Custom JS ========== -->
              <script src="/assets/js/main.js" defer></script>
              <script>
                async function addToWishlist(productId) {
                  const heartIcons = document.querySelectorAll(`.wishlist-btn[data-product-id="${productId}"] i`);
                  const isRemoving = heartIcons.length > 0 && (heartIcons[0].classList.contains('text-error') || heartIcons[0].classList.contains('bxs-heart'));
                  const url = isRemoving ? '/api/wishlist/remove' : '/api/wishlist/add';

                  try {
                    const response = await fetch(url, {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json'
                      },
                      body: JSON.stringify({ productId })
                    });

                    if (response.status === 401) {
                      window.location.href = '/login';
                      return;
                    }

                    const data = await response.json();
                    if (data.success) {
                      // Update all heart icons for this product across the page
                      document.querySelectorAll(`.wishlist-btn[data-product-id="${productId}"] i`).forEach(icon => {
                        // Surgical update to preserve size and other classes
                        icon.classList.remove('bx-heart', 'bxs-heart', 'hgi', 'hgi-stroke', 'hgi-favourite', 'text-error', 'text-light-secondary-text');
                        icon.classList.add('bx');

                        if (isRemoving) {
                          icon.classList.add('bx-heart', 'text-light-secondary-text');
                        } else {
                          icon.classList.add('bxs-heart', 'text-error', 'heart-pop');
                          // Remove animation class after it finishes
                          setTimeout(() => {
                            icon.classList.remove('heart-pop');
                          }, 300);
                        }
                      });
                    }
                  } catch (error) {
                    console.error('Error toggling wishlist:', error);
                  }
                }
              </script>
</body>

</html>